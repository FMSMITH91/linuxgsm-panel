        return 1

    return _as_game_user(pw, abspath, lambda path: _emit_dir_tar(path, sys.stdout.buffer))


def do_tailscale_install(args, content):
    """Install Tailscale on this host, from Tailscale's own installer.

    The panel ran `sudo bash -c "curl -fsSL https://tailscale.com/install.sh | sh"`. A sudoers rule
    permitting bash IS NOPASSWD:ALL, so that one line was on its own enough to keep the grant wide.

    There is no pipe here, and no shell string. curl writes the script to a root-owned file under
    /run (tmpfs, cleared on reboot, 0600) and sh runs THAT file. The download is still remote code
    executed as root — that is what installing Tailscale is, and pretending otherwise would be
    theatre — but the URL is fixed here, the caller supplies nothing, and no shell is reachable to
    build anything else with."""
    url = "https://tailscale.com/install.sh"
    path = "/run/panel-tailscale-install.sh"
    try:
        os.unlink(path)
    except FileNotFoundError:
        # First install on this host, or /run was cleared by a reboot. Nothing to remove.
        pass
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            r = subprocess.run([resolve("curl"), "-fsSL", url],  # nosec B603 - fixed argv
                               stdout=fh, stderr=subprocess.PIPE, check=False, timeout=120)
        if r.returncode != 0:
            sys.stderr.write("download failed\n")
            return 1
        r = subprocess.run([resolve("sh_installer"), path],  # nosec B603 - fixed root-owned path
                           check=False, timeout=600,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        sys.stdout.write((r.stdout or b"").decode("utf-8", "replace")[-1500:])
        return r.returncode
    finally:
        try:
            os.unlink(path)
        except OSError:
            # /run is tmpfs and this is 0600 root-owned; a leftover is harmless if unlink fails.
            pass


def do_panel_db_repair(args, content):
    """Repair the panel database offline, detached, and report that it started.

    Zero arguments. The database path comes from panel.conf, which install.sh wrote as root — not
    from the caller, because "run the repair on THIS file" with a caller-chosen path is a way to
    make root clobber any file on the box."""
    db_path = panel_conf().get("db_path", "")
    if not db_path or not os.path.isabs(db_path) or not os.path.exists(db_path):
        sys.stderr.write("panel.conf has no usable db_path\n")
        return 1
    # os.path.exists() above follows symlinks, and db_path names a file inside the panel's own
    # data/ directory — which the panel user owns. A symlink there aimed the root-side repair at
    # any file on the box; db_maintenance refuses it too, and this is the copy on the far side of
    # the privilege boundary, so it does not rely on that one.
    if os.path.islink(db_path):
        sys.stderr.write("refusing: the database path is a symlink\n")
        return 1
    if not os.path.isfile(DBM_PATH):
        sys.stderr.write("db_maintenance is not installed root-owned; re-run install.sh as root\n")
        return 1
    pid = os.fork()
    if pid == 0:
        _db_repair_detached(db_path)   # never returns
    os.waitpid(pid, 0)
    sys.stdout.write("REPAIR_STARTED")
    return 0


def do_os_update_run(args, content):
    """Start the OS update detached and report that it launched.

    Was one `setsid bash -c '<script>' </dev/null >/dev/null 2>&1 &` wrapping a seven-statement
    shell program: truncate, header, export, apt-get update, apt-get full-upgrade with four -o
    flags, autoremove, and a sentinel carrying the exit code. It took no caller input at all — the
    only variables in it were two constants — which is what makes it a zero-argument verb.

    One return, and it is the parent's: the child branch calls _os_update_detached(), which never
    comes back."""
    pid = os.fork()
    if pid == 0:
        _os_update_detached()         # never returns
    os.waitpid(pid, 0)                # reap the middle process immediately
    sys.stdout.write(OS_UPDATE_STARTED)
    return 0

def do_tailscale_up_login(args, content):
    """Start `tailscale up` detached and print its login URL once it appears.

    Was a shell one-liner: `rm -f /tmp/tsup.log ; nohup tailscale up … > /tmp/tsup.log 2>&1 & for i
    in $(seq 1 20); do u=$(grep -oE '…' /tmp/tsup.log | head -1); [ -n "$u" ] && …; sleep 1; done`.
    A backgrounded process, a redirect, a loop and a grep, all needing a shell.

    The log path is fixed here, so the poll cannot be pointed at a file a caller names, and it
    lives in /run — tmpfs, cleared on reboot, root-owned — rather than /tmp, where any local user
    could have pre-created or replaced it."""
    ssh, routes = args[0], args[1]
    try:
        os.unlink(TS_UP_LOG)
    except FileNotFoundError:
        pass                      # first run on this host, or /run was cleared by a reboot
    argv = ts_up_argv(ssh, routes)
    argv[0] = resolve("tailscale")
    fd = os.open(TS_UP_LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        subprocess.Popen(argv, shell=False,  # nosec B603 - argv from validated pieces
                         stdin=subprocess.DEVNULL, stdout=fd, stderr=subprocess.STDOUT,
                         start_new_session=True)
    finally:
        os.close(fd)
    for _ in range(TS_UP_POLL_SECONDS):
        time.sleep(1)
        try:
            with open(TS_UP_LOG, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        m = TS_LOGIN_RE.search(text)
        if m:
            sys.stdout.write(m.group(0))
            return 0
        if "success" in text.lower():
            sys.stdout.write("ALREADY_CONNECTED")
            return 0
    return 0                      # still waiting; the caller polls status separately


def do_f2b_log_lines(args, content):
    """Print fail2ban Ban/Found lines at or after a cutoff date, across the rotated logs.

    Replaces the read half of a `zcat -f /var/log/fail2ban.log* | awk -v c=<date> '$1 >= c' | grep
    -oE '...'` pipeline that ran as root with the cutoff interpolated into it. The tallying half is
    the caller's job now; this only reads and filters.

    Gzip is handled here rather than by zcat, so the only thing this verb can open is the fail2ban
    log family — the glob is fixed, and nothing about the path comes from the caller."""
    cutoff = args[0]
    out = []
    for path in sorted(glob.glob(F2B_LOG_GLOB)):
        try:
            opener = gzip.open if path.endswith(".gz") else open
            with opener(path, "rt", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    # The awk compared field one — the date — as a string, which works because the
                    # format is ISO-ish and fixed-width. Same comparison, same reason.
                    first = line.split(" ", 1)[0]
                    if first >= cutoff and F2B_EVENT_RE.search(line):
                        out.append(line.rstrip("\n"))
        except FileNotFoundError:
            continue          # a rotated file that vanished mid-read; the others still count
        except OSError as e:
            # Anything ELSE — a permission error, a truncated or corrupt .gz (gzip.BadGzipFile is
            # an OSError) — means this verb did not read what it was asked to read, and a PARTIAL
            # tally is not a smaller true answer: it is a wrong one. The callers
            # (system_ops.fail2ban_top_ips, hosts.remote_fail2ban_top_ips) both answer None on a
            # non-zero rc precisely so an unreadable log cannot be mistaken for a quiet one, and
            # returning 0 here defeated that guard from the inside. This used to be a bare
            # `except OSError: continue`, which is the same defect as an empty read believed as
            # fact — the handler turned "I could not look" into "there was nothing there".
            sys.stderr.write("could not read %s: %s\n" % (path, e))
            return 1
    sys.stdout.write("\n".join(out))
    return 0


def do_content_scan(args, content):
    """Print `HIT|user|game` for every /home user whose serverfiles already hold a wanted game.

    Was a shell loop: `for u in $(ls -1 /home); do d="/home/$u/serverfiles"; [ -d "$d" ] || continue;
    for g in <games>; do [ -d "$d/$g" ] && echo "HIT|$u|$g"; done; done`. Read-only, but it ran as
    root and built its inner list by interpolating the game keys.

    A user name that would not survive v_username is skipped rather than reported: the caller acts
    on what comes back, and a directory in /home whose name is not a name we would ever pass to a
    verb is not a candidate. So is a name no account has, and one whose probe could not be asked
    (see _probe_as): the panel then installs content afresh, which is the answer it had before the
    scan found anything. Each user's games are looked at AS THAT USER, following its own links."""
    try:
        entries = sorted(os.listdir(HOME_ROOT))
    except OSError:
        return 0                      # no /home to scan; no hits, not an error
    hits = []
    for entry in entries:
        try:
            user = v_username(entry)
            paths = [(game, content_path(user, CONTENT_SUBDIR, game)) for game in args]
        except ValueError:
            continue
        found = _probe_as(user, lambda paths=paths: "\n".join(
            game for game, path in paths if os.path.isdir(path)))
        for game in (found or "").splitlines():
            hits.append("HIT|%s|%s" % (user, game))
    sys.stdout.write("\n".join(hits))
    return 0


def _probe_as(user, probe):
    """Run probe() — which returns a str — AS `user`, with that account's own groups, in a forked
    child, and return what it returned. None when no account has that name, when it is root, or
    when the drop did not take: the question could not be asked, which is not the same answer as
    "absent".

    The three content probes used to answer as root with isdir / isfile / access, which FOLLOW
    links, and everything below the home is the content account's to replace: `ln -s /root
    ~/serverfiles` made content-game-present an existence oracle over /root. They were then made to
    refuse a link at every step below the home, which closed that and broke the layout it is
    normal to have — serverfiles moved to a bigger disk and linked back, which the game itself
    reads through. The panel host then said "absent" where a remote (`test -d` through the link)
    said "present", and the panel downloaded the content again, ran auto-install over it, dropped
    it from the update cron, and reported it removed when nothing was.

    Asked as the account, a link is followed with exactly that account's access, so the answer is
    only ever something the account could learn for itself — the oracle is gone, and the link it
    made on purpose still works. Groups are its own (initgroups), as its shell and the game have."""
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return None
    if pw.pw_uid == 0:
        return None
    rfd, wfd = os.pipe()
    pid = os.fork()
    if pid == 0:
        code = 1
        try:
            os.close(rfd)
            if _drop_to(pw, own_groups=True):
                data = probe().encode("utf-8")
                while data:
                    data = data[os.write(wfd, data):]
                code = 0
        finally:
            # code is 0 only past a complete write; anything raised leaves it 1. os._exit, so the
            # child never unwinds into the helper's own code with the account's identity.
            os._exit(code)
    os.close(wfd)
    chunks = []
    try:
        while True:
            chunk = os.read(rfd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(rfd)
    _pid, status = os.waitpid(pid, 0)
    if not (os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0):
        return None
    return b"".join(chunks).decode("utf-8", "replace")


def _probe_rc(user, path, test):
    """A probe verb's exit status: 0 when test(path) holds as `user`, 1 when it does not — and
    when there is no such account, which then has nothing — and 2 when the question could not be
    asked. content_present and _installed_content_lgsm_names read 2 as "unknown", not "absent"."""
    try:
        pwd.getpwnam(user)
    except KeyError:
        return 1
    answer = _probe_as(user, lambda: "1" if test(path) else "0")
    if answer is None:
        return 2
    return 0 if answer == "1" else 1


def _is_exec_file(path):
    """`test -x` as the rule was written for it: a regular file with any execute bit, links
    followed (with whatever access the caller has)."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and bool(st.st_mode & 0o111)


def do_content_dir_create(args, content):
    """Create <content user>/serverfiles, owned by that user and PRIVATE to it.

    The shell form created this group-readable (`install -m 750`) whether or not any GMod user had
    been granted access — the group bits were there from the moment the directory existed. They are
    added by content-grant-read now, when access is actually granted, so an ungranted content box
    shares nothing.

    Created with mkdir and then adjusted THROUGH A DESCRIPTOR, because makedirs(exist_ok=True)
    accepts a SYMLINK TO A DIRECTORY — its check is isdir(), which follows — and the chown and
    chmod that came after followed it too. The parent here is /home/<user>, which the user owns,
    so `ln -s /root ~/serverfiles` made root hand /root to that account: write
    /root/.ssh/authorized_keys and the boundary is gone. O_NOFOLLOW refuses the link outright
    rather than resolving it, and a descriptor cannot be swapped for something else afterwards."""
    user = args[0]
    path = home_of(user) + "/" + CONTENT_SUBDIR
    info = pwd.getpwnam(user)
    try:
        os.mkdir(path, stat.S_IRWXU)
    except FileExistsError:
        pass                      # already there; the fchown/fchmod below still normalise it
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fchown(fd, info.pw_uid, info.pw_gid)
        os.fchmod(fd, stat.S_IRWXU)
    finally:
        os.close(fd)
    return 0


def do_content_game_present(args, content):
    """Exit 0 when <content user>/serverfiles/<game> is a directory — `test -d`, without a shell,
    asked as the content account so a link it made is followed with its access only (_probe_as).
    Exit 2 when the account could not be asked."""
    return _probe_rc(args[0], content_path(args[0], CONTENT_SUBDIR, args[1]), os.path.isdir)


def do_content_script_present(args, content):
    """Exit 0 when <content user>/<script> is an executable regular file — `test -x`, which any
    execute bit satisfies — asked as the content account (_probe_as). Exit 2 when it could not be."""
    return _probe_rc(args[0], content_path(args[0], args[1]), _is_exec_file)


def _remove_at(parent_fd, name):
    """Remove `name` — a file, a link, or a whole tree — relative to the directory `parent_fd`,
    never following a symlink at ANY depth. A link is removed as a link.

    Every directory is entered by descriptor with O_NOFOLLOW and checked to be the one just
    lstat'ed, so a name swapped for a link between the two is left alone rather than followed."""
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    try:
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    except OSError:
        return                    # became a link (ELOOP) or vanished: not ours to chase
    try:
        if not os.path.samestat(st, os.fstat(fd)):
            return
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for child in names:
            _remove_at(fd, child)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def _remove_under_home(user, parts):
    """Remove home_of(user)/<parts...> as root, walking EVERY component by descriptor.

    content_path() builds a correct STRING, and that is all it can do: the account owns its home,
    so it can make `serverfiles` or `lgsm` a symlink to anywhere, and shutil.rmtree's own symlink
    guard covers only the LAST component — an intermediate link is followed like any directory.
    `rm -rf ~/serverfiles` + `ln -s /home/<another box>/serverfiles ~/serverfiles` then had root
    delete another tenant's content. Here the home is opened O_NOFOLLOW (its parent, HOME_ROOT, is
    root's), each intermediate directory is opened O_NOFOLLOW relative to the last, and the final
    entry is removed relative to that pinned directory. A link anywhere on the way ends the walk."""
    content_path(user, *parts)            # the same validation, for its refusals
    fd = os.open(home_of(user), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts[:-1]:
            nfd = os.open(v_ident(part), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nfd
        _remove_at(fd, v_ident(parts[-1]))
    finally:
        os.close(fd)


def do_content_game_remove(args, content):
    """Remove one game's content and, if it has one, its LinuxGSM script and config.

    Three removals as root. Every path comes from validated pieces, so the only inputs are a
    validated user name and a validated identifier — a caller cannot name what gets deleted. And
    every one is walked by descriptor (_remove_under_home), because the account whose home this is
    can turn any directory on the way into a symlink."""
    user, game, script = args[0], args[1], args[2]
    targets = [(CONTENT_SUBDIR, game)]
    if script != "-":
        targets.append((script,))
        targets.append(("lgsm", "config-lgsm", script))
    for parts in targets:
        try:
            _remove_under_home(user, parts)
        except OSError:
            # Best effort, as the shell form was: a game whose files are already gone, a link on the
            # way, or a path the filesystem will not let go of must not abort the other removals.
            pass
    return 0


def content_cron_line_re(user):
    """What a /etc/cron.d/lgsm-gmod-content-<user> line may say.

    The same argument as WRITE_CONTENT above, for the second writer of a cron.d file. That table
    guards `write-file`, and this verb is not one of its destinations — the path is per-user, so it
    cannot be a fixed name — which left this the one root-owned write with no content rule at all.
    Its stdin went to /etc/cron.d verbatim, and a cron.d line carries a USER FIELD: one
    `* * * * * root <cmd>` and the caller has root, within the minute, across reboots.

    The panel's body (ssh_manager/gmod.py:_content_update_cron_body) is a fixed shape, so it gets a
    grammar that admits that shape and nothing else. The user field is pinned to the VALIDATED
    ARGUMENT — not to a name in the payload — so the worst a hostile body can ask for is that the
    content account run its own ~/<script>, which is what the account is for."""
    u = re.escape(v_username(user))
    return re.compile(
        r"(?:PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        r"|[0-9]{1,2} [12] \* \* 0 %(u)s /home/%(u)s/[a-z0-9][a-z0-9_-]{0,31}"
        r" update(?:-lgsm)? > /dev/null 2>&1)" % {"u": u})


def do_content_cron_write(args, content):
    """Write the weekly content-update cron for one content user."""
    user = v_username(args[0])
    if not _lines_match(content, content_cron_line_re(user)):
        print("panel-helper: content-cron-write body rejected", file=sys.stderr)
        return 2
    path = "%s-%s" % (CONTENT_CRON_PREFIX, user)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.write(content)
    # Root is the only thing that reads /etc/cron.d. The shell form used 644 because that is what
    # the distro ships, but nothing here needs to be world-readable.
    os.chmod(tmp, stat.S_IRUSR | stat.S_IWUSR)
    os.replace(tmp, path)
    return 0


def do_content_cron_remove(args, content):
    """Drop that cron file — the user has no content games left."""
    try:
        os.unlink("%s-%s" % (CONTENT_CRON_PREFIX, v_username(args[0])))
    except FileNotFoundError:
        pass                      # already absent; the shell form used `rm -f` for the same reason
    return 0


def _emit_mount_cfg(path):
    """_as_game_user's emit for mount.cfg: print the file, or print nothing if there is no file.

    The two cases the caller has to be able to tell apart. A mount.cfg that was never created is a
    real READING — a GMod server that has never mounted anything does not have one — so it emits
    nothing and the verb succeeds. Anything else (a permission error, a read that dies part-way
    through, something that is not a regular file) propagates out of the forked child, so
    _as_game_user returns 1 and gmod_current_mounts reports "unknown" instead of "no mounts".

    os.lstat rather than os.path.isfile, because isfile() answers False for a file it could not
    stat as well as for one that is not there — the very conflation this exists to remove."""
    try:
        os.lstat(path)
    except FileNotFoundError:
        return                    # never created: nothing is mounted, and that IS a measurement
    _emit_file(path, sys.stdout.buffer)


def do_gmod_mount_read(args, content):
    """Print a GMod server's mount.cfg, or nothing. Was `cat <path> 2>/dev/null || true`.

    Read AS THE GAME USER, through the same fork-and-drop the download verbs use. Opening it as
    root was the hole those verbs were written to avoid: every component of the path sits inside
    that account's own home, so `ln -s /etc/shadow ~/serverfiles/garrysmod/cfg/mount.cfg` made
    this verb print /etc/shadow into the panel UI. _as_game_user re-resolves after the drop, so a
    link that leaves the home is refused by the kernel rather than trusted by a check."""
    pw, abspath = _game_home_path(args[0], GMOD_CFG_SUBPATH + "/mount.cfg")
    if pw is None:
        return 0                  # no such user: empty, which the caller reads as "no mounts"
    # Return what the read actually DID, the way do_game_file_read and do_game_dir_tar already do.
    # This used to `return 0` unconditionally. _as_game_user returns 1 for a credential drop that
    # did not take, a resolved path that leaves the home, a child killed by a signal, and any
    # exception out of _emit_file — including one raised part-way through its chunk loop, which
    # leaves TRUNCATED output already flushed on stdout. Every one of those reached
    # gmod_current_mounts as rc 0, which reads it as "this server mounts nothing"; server_files
    # then rewrote mount.cfg to exactly the visible selection and dropped every mount the panel had
    # failed to read, reporting success. gmod_current_mounts is already written for this — it
    # returns None on a non-zero rc — so the only thing missing was the helper telling the truth.
    # An ABSENT mount.cfg is still rc 0: see _emit_mount_cfg, that one really is "no mounts".
    return _as_game_user(pw, abspath, _emit_mount_cfg)


def _chmod_nofollow(path, add, x_if_user=False, dir_fd=None):
    """Add mode bits to `path` WITHOUT following it if it is a symlink.

    os.chmod follows, and Linux has no lchmod, so `chmod -R g+rX` over a tree the content account
    owns was a chmod of whatever anything in it pointed AT. Worse than a stray permission: the walk
    read the mode with lstat and wrote it back with chmod, and a symlink's own mode is 0777 — so
    every link in the tree made its TARGET world-writable. Two of those (/etc/shadow, /etc/cron.d)
    are root.

    O_NOFOLLOW makes the kernel refuse the open instead. O_NONBLOCK so a FIFO cannot park root
    forever, and non-regular, non-directory entries are left alone — a device or socket has no
    content to share and no business being chmod'd by this."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
            return
        mode = stat.S_IMODE(st.st_mode) | add
        # g+rX: read for everything, execute only where a user already has it. That is what
        # `chmod -R g+rX` means, and why it is not a blanket g+rx.
        if x_if_user and mode & stat.S_IXUSR:
            mode |= stat.S_IXGRP
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


# Mirrors panel/security/privileged.py _NEVER_A_CONTENT_GROUP; root never imports panel code.
NEVER_A_CONTENT_GROUP = frozenset({"root", "wheel", "sudo", "admin", "adm", "shadow", "docker",
                                   "lxd", "disk", "staff",
                                   "incus-admin", "libvirt"})


def do_content_grant_read(args, content):
    """Let a GMod user read a content user's game trees.

    Was `usermod -aG <grp> <gmod>; chmod g+x /home/<content>; chmod -R g+rX …` in one root shell.
    Each step is best-effort here exactly as it was there — a host where one of them fails should
    still get the others."""
    content_user, group, gmod_user, games = args[0], args[1], args[2], args[3:]
    content_pw = pwd.getpwnam(content_user)
    # The group is derived from an account the CALLER names, so the equality check below is
    # self-consistent rather than restrictive: naming root made `actual` "root" and it passed,
    # turning this into `usermod -aG root <user>` — gid 0 on every root:root 0640 file on the box.
    # v_managed_user refuses uid 0 for the two USER slots; this refuses the GROUP, which is
    # validated by shape alone because a host may have a group named after a system account.
    if content_pw.pw_gid == 0:
        print("panel-helper: refusing a gid-0 group", file=sys.stderr)
        return 2
    actual = grp.getgrgid(content_pw.pw_gid).gr_name
    if actual in NEVER_A_CONTENT_GROUP:
        # The same deny set privileged.py keeps (_NEVER_A_CONTENT_GROUP). A content account whose
        # PRIMARY group is one of these would make the grant `usermod -aG sudo|docker|shadow ...`.
        print("panel-helper: refusing to grant membership of that group", file=sys.stderr)
        return 2
    if group != actual:
        # The caller named a group that is not this content user's. Adding the GMod user to an
        # arbitrary group is exactly the kind of thing this boundary exists to refuse.
        print("panel-helper: content-grant-read group does not match the content user",
              file=sys.stderr)
        return 2
    subprocess.run([resolve("usermod"), "-aG", group, gmod_user],  # nosec B603 - validated argv
                   shell=False, capture_output=True, timeout=60)
    # Traversal, outermost first: the home, then serverfiles, then each granted game tree. The
    # shell form skipped serverfiles because content-dir-create had already made it group-readable;
    # it does not any more, so the grant is what opens the path.
    #
    # Every step below works from DESCRIPTORS pinned here. The home's parent is root's, so the home
    # opened O_NOFOLLOW is the real one; serverfiles is opened O_NOFOLLOW relative to it. The walk
    # used to start from the PATH .../serverfiles/<game>: fwalk's own check covers the last
    # component only, so the content account could make ~/serverfiles a symlink to another tenant's
    # directory and have root `chmod g+rX` that tenant's game tree for the content group — the same
    # shape content-game-remove had with rmtree.
    try:
        home_fd = os.open(home_of(content_user), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return 0                  # no home to grant anything in; best-effort, as before
    try:
        try:
            _chmod_nofollow(home_of(content_user), stat.S_IXGRP)
        except OSError:
            pass                  # traversal bit is best-effort, as it was in the shell form
        try:
            sf_fd = os.open(CONTENT_SUBDIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=home_fd)
        except OSError:
            return 0              # no serverfiles, or a link where it should be: nothing to open
        try:
            try:
                _chmod_nofollow(CONTENT_SUBDIR, stat.S_IXGRP, dir_fd=home_fd)
            except OSError:
                # No content subdir to open up (nothing mounted yet) — the grant still stands.
                pass
            for game in games:
                name = v_ident(game)
                # fwalk, not walk, and follow_symlinks=False: it hands each level a DESCRIPTOR and
                # checks that the directory it descended into is the one it stat'd, so a component
                # swapped mid-walk stops the descent instead of redirecting it.
                for _root, dirs, files, rootfd in os.fwalk(
                        name, dir_fd=sf_fd, follow_symlinks=False, onerror=lambda _e: None):
                    for entry in dirs + files:
                        try:
                            _chmod_nofollow(entry, stat.S_IRGRP, x_if_user=True, dir_fd=rootfd)
                        except OSError:
                            continue
                try:
                    _chmod_nofollow(name, stat.S_IRGRP | stat.S_IXGRP, dir_fd=sf_fd)
                except OSError:
                    # This game's tree is missing or not ours to chmod. The shell form was
                    # per-command best-effort for the same reason, and the other granted games
                    # must still be done.
                    pass
        finally:
            os.close(sf_fd)
    finally:
        os.close(home_fd)
    return 0


def do_write_file(args, content):
    """Write `content` to a named root-owned destination.

    Done here in Python rather than by shelling out to tee or `base64 -d > path`, which is what the
    panel used to do: the content was base64'd onto a ROOT COMMAND LINE, and the redirect needed a
    shell. Here the content arrives on this process's stdin and never becomes an argument at all.

    Written to a temporary file in the same directory and renamed, so a reader never sees a
    half-written config — fail2ban and sshd both read these while the panel is editing them."""
    target = args[0]
    path, mode = WRITE_TARGETS[target]
    # Deny by default: a destination with no entry in WRITE_CONTENT is refused outright, so adding
    # one to WRITE_TARGETS forces a decision about its content instead of inheriting "anything".
    if target not in WRITE_CONTENT:
        print("panel-helper: no content rule for %s" % target, file=sys.stderr)
        return 2
    rule = WRITE_CONTENT[target]
    if target == "node-tools-cron":
        content = NODE_TOOLS_CRON_BODY      # helper-owned; stdin is not trusted for a cron file
    elif rule is not None and not _content_ok(content, rule):
        print("panel-helper: content rejected for %s" % target, file=sys.stderr)
        return 2
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".panel-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)          # atomic within the same filesystem
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            # The temp file may already be gone (a partial os.replace, or the directory removed
            # under us). Either way the original error below is the one worth reporting, so a
            # failure to clean up must not replace it.
            pass
        raise
    return 0


