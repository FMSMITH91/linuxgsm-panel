def do_create_swapfile(args, content):
    """Create, enable and persist a 2G swap file, if there isn't one already.

    Was `fallocate && chmod && mkswap && swapon && grep -q /etc/fstab || echo >> /etc/fstab`. Note
    the shell version's precedence bug: `a && b && c || d` means the fstab line was appended
    whenever ANY earlier step failed, not only when grep found nothing. Here the steps are
    sequential and the fstab append happens only when the swap is actually on and the line is
    absent."""
    if os.path.exists(SWAPFILE):
        return 0
    for argv in ([resolve("fallocate"), "-l", "2G", SWAPFILE],):
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=120)  # nosec B603
        if r.returncode != 0:
            return r.returncode
    os.chmod(SWAPFILE, stat.S_IRUSR | stat.S_IWUSR)
    for argv in ([resolve("mkswap"), SWAPFILE], [resolve("swapon"), SWAPFILE]):
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=120)  # nosec B603
        if r.returncode != 0:
            return r.returncode
    try:
        with open(FSTAB, encoding="utf-8", errors="replace") as fh:
            already = any(SWAPFILE in ln for ln in fh)
    except OSError:
        already = True                     # no fstab to persist into; the swap is still on
    if not already:
        with open(FSTAB, "a", encoding="utf-8") as fh:
            fh.write(SWAP_FSTAB_LINE + "\n")
    return 0


def _os_update_detached():
    """The OS update itself, in the grandchild. NEVER RETURNS — every path ends in os._exit, which
    is why it is a separate function: its caller can then have exactly one return, and a reader is
    not left working out which branch falls off the end."""
    os.setsid()                       # detach from the session so the caller's exit cannot kill us
    if os.fork() != 0:
        os._exit(0)                   # middle process: hand the work to the grandchild and go
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        if devnull > 2:
            os.close(devnull)         # dup2 kept the copies; this one would leak
        env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
        apt = resolve("apt-get")
        with open(OS_UPDATE_LOG, "w", encoding="utf-8") as log:
            log.write("=== OS update started %s ===\n"
                      % time.strftime("%a %d %b %H:%M:%S %Z %Y"))
            log.flush()
            subprocess.run([apt, "update"], shell=False, env=env,  # nosec B603 - fixed argv
                           stdout=log, stderr=subprocess.STDOUT, timeout=1800)
            # The same flags apt-full-upgrade uses, for the same reasons: include Ubuntu's phased
            # rollouts so an explicit "install updates" actually reaches zero, and keep any config
            # file the operator has edited.
            rc = subprocess.run([apt, "-y", "-o", "APT::Get::Always-Include-Phased-Updates=true"]
                                + APT_CONFOLD + ["full-upgrade"], shell=False, env=env,  # nosec B603
                                stdout=log, stderr=subprocess.STDOUT, timeout=7200).returncode
            subprocess.run([apt, "-y", "autoremove"], shell=False, env=env,  # nosec B603
                           stdout=log, stderr=subprocess.STDOUT, timeout=1800)
            log.write("%s%d\n" % (OS_UPDATE_DONE, rc))
    except Exception:
        # Fall through to the failure sentinel below. Caught rather than allowed to propagate
        # because this is a forked child: an unhandled traceback here would unwind into whatever
        # the parent was doing.
        pass
    else:
        os._exit(0)
    # Only here when the run above died before writing its own sentinel. The sentinel is how the
    # UI knows the job ended at all — without one the popup waits forever — so -1 says "it ended,
    # badly" rather than leaving the reader to guess.
    try:
        with open(OS_UPDATE_LOG, "a", encoding="utf-8") as fh:
            fh.write("%s-1\n" % OS_UPDATE_DONE)
    except OSError:
        # The log is unwritable (a full or read-only /run). Nothing further to try, and the caller
        # has long since returned — the exit status below is all that is left to say.
        pass
    os._exit(1)


def _db_repair_account(db_path):
    """The account the offline repair runs as: whoever owns the directory the database lives in.
    None when that cannot be established, and the caller then does not repair at all.

    Every file repair() makes is CREATED — the rebuilt database is a new file renamed over
    panel.db, and so is a restored backup — so it must be created as the panel's account, or the
    panel, started again straight afterwards, cannot open its own database. db_maintenance already
    confines itself to that owner when it starts as root; the helper drops before exec anyway, so
    root runs none of the script's code in a directory the panel user controls, and the boundary
    does not rest on the script. The one thing that drop skips — db_maintenance's reclaim of files
    an older, root-run repair left root-owned — the helper does itself (_db_repair_reclaim).

    lstat, not stat: that directory entry is one the panel user can replace, and a symlink it put
    there must not borrow the owner of whatever it points at — a root-owned target would hand the
    repair back to root. A link ROOT made (an operator who moved data/ to another disk) is
    followed, because then the directory it names is the panel's."""
    d = os.path.dirname(db_path)
    try:
        st = os.lstat(d)
        if stat.S_ISLNK(st.st_mode) and st.st_uid == 0:
            st = os.stat(d)
        return pwd.getpwuid(st.st_uid)
    except (OSError, KeyError):
        return None


def _db_repair_as(account):
    """subprocess.run keyword arguments that run the repair as `account` (see _db_repair_account).

    Nothing for root: a panel whose data directory root owns runs as root, and its files are
    root's. Otherwise the child drops to the account before exec, through _drop_to — which refuses
    to report success in any state that is still root — and a drop that does not take raises in
    the child, so subprocess.run raises here and the repair does not run as root instead."""
    if account.pw_uid == 0:
        return {}

    def _become_owner():
        if not _drop_to(account):
            raise OSError("could not become %s" % account.pw_name)

    return {"preexec_fn": _become_owner, "env": dict(os.environ, HOME=account.pw_dir)}


def _db_reclaim_files(dir_fd, name, uid, gid):
    """Hand the database's own files in `dir_fd` back to uid:gid. The same rule as
    db_maintenance._reclaim_db_files, on the root side of the drop (see _db_repair_reclaim).

    Each file is opened relative to the pinned directory with O_NOFOLLOW (a symlink is refused at
    open) and O_NONBLOCK (a fifo cannot hang root), and fchown'd only if it is a regular file with
    ONE link: a second link would mean the inode is also some other file, which must not change
    hands."""
    for member in (name, name + "-wal", name + "-shm", name + ".backup"):
        try:
            mfd = os.open(member, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,
                          dir_fd=dir_fd)
        except OSError:
            continue          # absent, a symlink, or unopenable: nothing to hand back
        try:
            mst = os.fstat(mfd)
            if stat.S_ISREG(mst.st_mode) and mst.st_nlink == 1 and mst.st_uid != uid:
                os.fchown(mfd, uid, gid)
        except OSError:
            pass              # best effort: the repair reports a database it still cannot open
        finally:
            os.close(mfd)


def _db_repair_reclaim(db_path, account):
    """ROOT, before the repair drops to `account`: give back the database files an earlier
    root-run repair left root-owned.

    db_maintenance does this itself when it starts as root, and then becomes the directory's owner.
    Dropping here, before exec, means it never starts as root, so its reclaim never runs — and a
    panel.db, -wal, -shm or .backup that is root:root 0600 is then one the repair cannot open: it
    fails, or restores a backup beside a stale -wal the panel cannot read, and the panel comes back
    up on a database it cannot open. So the helper does that reclaim here, and only that.

    The directory is opened once and checked by DESCRIPTOR to still belong to `account`: the
    directory entry is one the panel user can swap after _db_repair_account looked, and a link to
    somebody else's directory must not get that directory's files handed to the panel user."""
    if account.pw_uid == 0:
        return                # a root-owned data directory: root keeps its files, nothing to give
    try:
        dfd = os.open(os.path.dirname(db_path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        if os.fstat(dfd).st_uid == account.pw_uid:
            _db_reclaim_files(dfd, os.path.basename(db_path), account.pw_uid, account.pw_gid)
    except OSError:
        # Best effort: the repair still runs as the owner, and a file it cannot reclaim is reported
        # by db_maintenance's own write check rather than raised from here.
        pass
    finally:
        os.close(dfd)


def _db_repair_detached(db_path):
    """The offline repair itself, in the grandchild. NEVER RETURNS — every path ends in os._exit.

    stop -> repair -> start, as three argv calls with no shell between them. The panel used to
    compose this as a `bash -c` string and hand it to `sudo systemd-run`; the string was built from
    the panel's OWN directory, so root ran the panel user's interpreter on the panel user's script.
    Here the interpreter is the system one and the script is the root-owned copy beside this file,
    and it runs as the database's owner, not as root (_db_repair_account says why).
    """
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        if devnull > 2:
            os.close(devnull)
    except OSError:
        # Detaching stdio is best-effort. If /dev/null cannot be opened the repair should still run;
        # the worst case is that output goes nowhere useful, which is where it was headed anyway.
        pass
    try:
        systemctl = resolve("systemctl")
        python = next((p for p in SYSTEM_PYTHON if os.path.isfile(p) and os.access(p, os.X_OK)),
                      None)
        if python is None:
            os._exit(1)
        # No account, no repair — and no stop either, so the panel is left as it was. Running it as
        # root instead is exactly what leaves the database unopenable.
        account = _db_repair_account(db_path)
        if account is None:
            os._exit(1)
        # The panel is holding the database open; it has to go down before the file can be rebuilt.
        subprocess.run([systemctl, "stop", PANEL_UNIT],  # nosec B603 - fixed argv
                       check=False, timeout=120)
        # The drop below means db_maintenance never starts as root, so its own reclaim of files a
        # root-run repair left root-owned never runs; do it here, as root, before dropping.
        _db_repair_reclaim(db_path, account)
        subprocess.run([python, DBM_PATH, "repair", db_path],  # nosec B603 - root-owned script
                       check=False, timeout=900, **_db_repair_as(account))
    except Exception:
        # Swallowed so the finally below ALWAYS runs. This is a detached grandchild with no stderr
        # anyone reads, and the only thing that matters after a failed repair is that the panel is
        # started again — which the finally does. A raise here would skip it and leave it down.
        pass
    finally:
        # Start it again WHATEVER happened above. A panel left down by a failed repair is worse
        # than a panel up with a database it will complain about.
        try:
            subprocess.run([resolve("systemctl"), "start", PANEL_UNIT],  # nosec B603 - fixed argv
                           check=False, timeout=120)
        except Exception:
            # Last resort in a finally, in a detached grandchild: there is nobody to report to and
            # nothing further to try. Falling through to os._exit is the only remaining behaviour.
            pass
    os._exit(0)


def _copy_one_regular(src, dst, src_dir_fd=None, dst_dir_fd=None):
    """Copy ONE regular file, refusing to follow a symlink at either end. True if it was copied,
    False if `src` is not there.

    `src`/`dst` are plain NAMES when the directory descriptors are given, which is how
    restore_copy_members calls it — see there for why the directory has to be a descriptor and
    not a path.

    O_NOFOLLOW ON BOTH SIDES, and that is the whole point of this function.

    The staging directory belongs to the PANEL USER — it is the panel that creates it and unpacks
    the archive into it — and this code runs as ROOT. The loop this replaces was
    `if os.path.isfile(src): shutil.copyfile(src, dst)`, and both of those follow symlinks. So a
    panel that had been compromised could stage a SYMLINK under one of the four member names and
    have root do its reading and writing for it:

      * a link at stage/cred_key -> /etc/shadow, and root copies shadow's contents into the data
        directory as a real file the panel user owns and can read. Arbitrary read as root.
      * a link at data_dir/cred_key -> /etc/cron.d/anything, and root writes the staged content
        THROUGH it. Arbitrary write as root, which is a root shell a minute later.

    That is precisely the boundary this helper exists to create, so the fixed staging path is not
    enough on its own: the directory being fixed says nothing about what the names inside it
    resolve to. O_NOFOLLOW refuses a symlink AT OPEN TIME, atomically, so there is no window
    between checking and opening for the link to be swapped in.

    S_ISREG as well, because O_NOFOLLOW alone still opens a fifo or a device node — a fifo would
    hang the restore holding the panel down, and /dev/zero would fill the disk.

    HARD LINKS are handled here too, not left to the kernel. This used to say they were "covered
    by the kernel instead — fs.protected_hardlinks is 1 by default", but a sysctl is host state,
    and not state this code controls. So a staged source with a second link is refused (the inode
    is also some other file), and the destination is never opened over what is there: the copy is
    written to a fresh O_EXCL temp beside it and RENAMED onto the member name. A rename replaces
    the name, so whatever inode that name had — a link to anything — is left as it was.

    OWNERSHIP AND MODE are this function's to set, never the staged file's. It copied the staged
    file's mode with fchmod(S_IMODE(st_mode)) — set-uid, set-gid and sticky bits included — onto a
    file root had just created, and never chowned it. A member missing before the restore came
    back as a ROOT-owned file with whatever mode bits the panel user staged: a set-uid root file of
    its choosing. And config.json restored onto a fresh install came back root:root 0600, which the
    non-root service cannot even read, so its next save quietly replaced the restore with defaults.
    Every restored member is now 0600 and owned by the data directory's owner.
    """
    try:
        sfd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=src_dir_fd)
    except OSError:
        # ENOENT (nothing staged for this member) and ELOOP (it is a symlink) are both "do not
        # copy this one", and neither is worth failing the whole restore over.
        return False
    try:
        st = os.fstat(sfd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            return False
        if dst_dir_fd is not None:
            owner = os.fstat(dst_dir_fd)
        else:
            owner = os.stat(os.path.dirname(os.path.abspath(dst)))
        tmp = ".%s.restoring-%s" % (os.path.basename(dst), os.urandom(6).hex())
        try:
            dfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600,
                          dir_fd=dst_dir_fd)
        except OSError:
            return False            # the temp name could not be created fresh
        placed = False
        try:
            with open(sfd, "rb", closefd=False) as fsrc, open(dfd, "wb", closefd=False) as fdst:
                shutil.copyfileobj(fsrc, fdst)
            os.fchmod(dfd, 0o600)
            try:
                os.fchown(dfd, owner.st_uid, owner.st_gid)
            except OSError:
                # Only root can give a file away. Unprivileged it is already the caller's own.
                if os.geteuid() == 0:
                    raise
            os.fsync(dfd)
            os.rename(tmp, dst, src_dir_fd=dst_dir_fd, dst_dir_fd=dst_dir_fd)
            placed = True
        finally:
            os.close(dfd)
            if not placed:
                try:
                    os.unlink(tmp, dir_fd=dst_dir_fd)
                except OSError:
                    # A leftover dot-temp in the panel's own data dir; nothing reads it.
                    pass
    finally:
        os.close(sfd)
    return True


def restore_copy_members(stage, data_dir):
    """Copy the staged backup members over the live ones. Returns the names actually copied.

    Extracted from _restore_detached so a test can drive it: that function forks, detaches and
    ends in os._exit, so anything left inside it can only be tested by reimplementing it — and a
    test that reimplements the code it is guarding is how the original symlink follow would have
    stayed invisible.
    """
    copied = []
    # BOTH directories are opened ONCE, O_NOFOLLOW, and every member is opened relative to those
    # descriptors. The check this replaces — islink(stage) and then os.path.join(stage, member) —
    # was a check on a PATH followed by a use of that path: O_NOFOLLOW covers only the last
    # component, so swapping `stage` itself for a symlink between the two had root reading
    # <somewhere else>/panel.db and writing it over the live one. Narrow (it needs a file named
    # exactly like a member, in a directory of the attacker's choosing, in that window) and free
    # to close: a descriptor cannot be re-pointed once it is open.
    try:
        sdir = os.open(stage, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return copied           # the staging dir itself must be a real directory, not a link
    try:
        try:
            ddir = os.open(data_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            return copied
        try:
            for member in RESTORE_MEMBERS:
                dst = "panel.db" if member == "panel.db" else member
                if _copy_one_regular(member, dst, src_dir_fd=sdir, dst_dir_fd=ddir):
                    copied.append(member)
        finally:
            os.close(ddir)
    finally:
        os.close(sdir)
    return copied


def _restore_detached(data_dir):
    """The restore swap itself, in the grandchild. NEVER RETURNS — every path ends in os._exit.

    stop -> copy the staged files over the live ones -> drop the WAL/SHM sidecars -> start -> wipe
    the staging directory. The panel used to write this as a bash script into its own data dir and
    hand the path to `sudo systemd-run`; root then executed a file the panel user had just written.
    Here the sequence is fixed in root-owned code and the only thing that varies is which of the
    four known members happen to be present."""
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        if devnull > 2:
            os.close(devnull)
    except OSError:
        # Best-effort detach; the restore matters more than where its (unread) output goes.
        pass
    stage = os.path.join(data_dir, RESTORE_STAGE)
    try:
        systemctl = resolve("systemctl")
        subprocess.run([systemctl, "stop", PANEL_UNIT],  # nosec B603 - fixed argv
                       check=False, timeout=120)
        restore_copy_members(stage, data_dir)
        # The restored database is authoritative; a stale WAL/SHM pair beside it is not.
        for side in ("-wal", "-shm"):
            try:
                os.unlink(os.path.join(data_dir, "panel.db" + side))
            except FileNotFoundError:
                # Nothing to drop — the panel was shut down cleanly. Not a problem.
                pass
    except Exception:
        # Swallowed so the finally below ALWAYS runs: after a half-finished restore the one thing
        # that matters is that the panel comes back up. A raise here would skip that.
        pass
    finally:
        try:
            subprocess.run([resolve("systemctl"), "start", PANEL_UNIT],  # nosec B603 - fixed argv
                           check=False, timeout=120)
        except Exception:
            # Detached grandchild in a finally: nobody to tell, nothing left to try.
            pass
        # The staging dir holds a plaintext database AND both encryption keys — the pair that
        # decrypts every stored SSH credential. Remove it whatever happened above.
        shutil.rmtree(stage, ignore_errors=True)
    os._exit(0)


def do_panel_restore(args, content):
    """Swap a staged backup into place, detached, and report that it started.

    Zero arguments. Both the staging directory and the destinations come from panel.conf's
    data_dir, so a caller chooses neither the source nor the target of a root-run copy."""
    data_dir = panel_conf().get("data_dir", "")
    if not data_dir or not os.path.isabs(data_dir) or not os.path.isdir(data_dir):
        sys.stderr.write("panel.conf has no usable data_dir\n")
        return 1
    stage = os.path.join(data_dir, RESTORE_STAGE)
    if not os.path.isdir(stage):
        sys.stderr.write("nothing staged to restore\n")
        return 1
    pid = os.fork()
    if pid == 0:
        _restore_detached(data_dir)   # never returns
    os.waitpid(pid, 0)
    sys.stdout.write("RESTORE_STARTED")
    return 0


SELF_UPDATE_LOG = "self-update.log"


def _open_log_in_dir(dir_path, name):
    """Open a FRESH log file `name` inside `dir_path` for writing, as root, and return it as a text
    file object. Raises OSError.

    For a directory the panel user owns — its data/ directory. `open(os.path.join(data_dir,
    "self-update.log"), "w")` there followed a symlink and truncated whatever it named, so the panel
    user could point that name at any file on the box and have root empty it (or create it) with
    one panel-self-update call. And O_NOFOLLOW alone would still truncate a hard link.

    So: the directory is opened once, O_NOFOLLOW, and everything happens relative to that
    descriptor. The old name is unlinked (removing a link removes the link, never its target) and
    the log is CREATED with O_EXCL, which fails on any name that reappears in between rather than
    opening it. The new file is then given to the directory's owner through the descriptor, so the
    panel can still read — and rotate — its own log."""
    dfd = os.open(dir_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        owner = os.fstat(dfd)
        try:
            os.unlink(name, dir_fd=dfd)
        except FileNotFoundError:
            # No previous log to replace: the O_EXCL create below is all that is needed.
            pass
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=dfd)
        try:
            os.fchown(fd, owner.st_uid, owner.st_gid)
        except OSError:
            # Only root can give a file away; unprivileged (a test, or a --user install that
            # reaches this some other way) it is already the caller's own file.
            if os.geteuid() == 0:
                os.close(fd)
                raise
    finally:
        os.close(dfd)
    return os.fdopen(fd, "w", encoding="utf-8")


def _self_update_detached(panel_dir, data_dir, ref, branch):
    """The self-update, in the grandchild. NEVER RETURNS — every path ends in os._exit.

    Runs the ROOT-OWNED installer, not the one in the panel's checkout. The panel used to write a
    wrapper script into its own data dir that exported three variables and then ran
    `bash <panel_dir>/install.sh`, and hand that wrapper to `sudo systemd-run` — so root executed
    two files the panel user could rewrite.

    Note what this does NOT try to be: self-update inherently means "fetch new code and run it".
    No amount of argv discipline makes that untrusted-safe. What it buys is that the ROOT-run part
    is fixed and small; the code the installer pulls goes on to run as the PANEL user, and its
    trustworthiness rests on the signed, CI-verified commit — which is checked before we get here.
    """
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        if devnull > 2:
            os.close(devnull)
    except OSError:
        # Best-effort detach; the installer writes its own log either way.
        pass
    env = dict(os.environ)
    env["PANEL_UPDATE_REF"] = "" if ref == "-" else ref
    env["PANEL_BRANCH"] = "" if branch == "-" else branch
    # A panel update must never apply host OS packages or reboot the box — that would take every
    # game server down mid-update. OS updates stay a separate, explicit action.
    env["PANEL_NO_UPGRADE"] = "1"
    try:
        with _open_log_in_dir(data_dir, SELF_UPDATE_LOG) as log:
            log.write("=== panel self-update ===\n")
            log.flush()
            subprocess.run([resolve("bash_installer"), INSTALLER_PATH],  # nosec B603 - fixed path
                           cwd=panel_dir, env=env, stdout=log, stderr=subprocess.STDOUT,
                           check=False, timeout=1800)
    except Exception:
        # Nobody reads this process's stderr; the installer's own log is the record. Falling
        # through to os._exit is all that is left.
        pass
    os._exit(0)


def do_panel_self_update(args, content):
    """Start the panel self-update detached, and report that it launched."""
    ref, branch = args[0], args[1]
    conf = panel_conf()
    panel_dir, data_dir = conf.get("panel_dir", ""), conf.get("data_dir", "")
    if not panel_dir or not os.path.isdir(panel_dir) or not data_dir or not os.path.isdir(data_dir):
        sys.stderr.write("panel.conf has no usable panel_dir/data_dir\n")
        return 1
    if not os.path.isfile(INSTALLER_PATH):
        sys.stderr.write("installer is not installed root-owned; re-run install.sh as root\n")
        return 1
    pid = os.fork()
    if pid == 0:
        _self_update_detached(panel_dir, data_dir, ref, branch)
    os.waitpid(pid, 0)
    sys.stdout.write("UPDATE_STARTED")
    return 0


def do_lgsm_discover(args, content):
    """List the LinuxGSM instances already installed on this host, one FOUND| line each.

    Reimplemented here rather than shelled out. The panel's version is a twenty-line shell program
    (nested loops, greps, a crontab read per user) and it needed root for exactly ONE thing:
    `crontab -u <someone-else> -l`. Everything else it does — reading config files under /home and
    counting backups — is ordinary file reading.

    Same output contract as the shell form, so the panel's parser is unchanged:
        FOUND|user|instance|port|backups|mods|cronlines|autostart
    """
    # crontab is OPTIONAL here. The shell form sent its errors to /dev/null, so a host without a
    # cron implementation still listed its instances with zero cron counts; resolving it eagerly
    # would turn "no crontab installed" into "no game servers found", which is a worse answer than
    # the one it replaced.
    try:
        crontab = resolve("crontab")
    except FileNotFoundError:
        crontab = None
    try:
        users = sorted(os.listdir(HOME_ROOT))
    except OSError:
        return 0                       # no /home is not an error, just nothing to find
    for user in users:
        if not re.fullmatch(USERNAME_RE, user):
            continue                   # not an account name: it could not be a FOUND field either
        cfg_dir = os.path.join(HOME_ROOT, user, "lgsm", "config-lgsm")
        if not os.path.isdir(cfg_dir):
            continue
        cron = ""
        try:
            if crontab is not None:
                r = subprocess.run([crontab, "-u", user, "-l"],  # nosec B603 - argv, user from /home
                                   check=False, timeout=15,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                cron = (r.stdout or b"").decode("utf-8", "replace")
        except Exception:
            # A user with no crontab exits non-zero; anything else here is equally non-fatal —
            # the instance still counts, it just reports zero cron lines.
            cron = ""
        cron_lines = [ln for ln in cron.splitlines()
                      if ln.strip() and not ln.strip().startswith("#")]
        autostart = sum(1 for ln in cron_lines if "@reboot" in ln or "monitor" in ln)
        # The FILE reads happen as that user, not as root. Everything below lives inside their own
        # home, so every path component is theirs to replace: a symlink at ~/lgsm/config-lgsm/x/
        # x.cfg turned this into a port-number oracle over any root-readable file, one at
        # ~/lgsm/backup into a directory-entry count, and one at ~/lgsm/mods/installed-mods.txt
        # into a line count. Small answers, but the same class as the mount.cfg read, and the fix
        # is the one the download verbs already use. crontab -u stays in the parent: it is the one
        # thing here that genuinely needs root.
        _discover_user(user, cfg_dir, cron_lines, autostart)
    return 0


def _discover_user(user, cfg_dir, cron_lines, autostart):
    """Emit the FOUND| lines for one /home user, reading their files AS THEM.

    Forks and drops when running as root, which is when it matters. Unprivileged (a test, or a
    per-user install) there is no boundary to cross, so it reads in-process and the answer is
    identical."""
    def _emit():
        try:
            instances = sorted(os.listdir(cfg_dir))
        except OSError:
            return
        for inst in instances:
            # The name is a file name the GAME account chose, and it lands in a line protocol the
            # panel splits on newlines and '|'. `x\nFOUND|<any account>|pzserver|...` forged a
            # second record naming another account, which the import route then trusted as "the
            # scan found it". Only a name in the panel's own identifier grammar is reported.
            if not re.fullmatch(DISCOVER_INSTANCE_RE, inst):
                continue
            if not os.access(os.path.join(HOME_ROOT, user, inst), os.X_OK):
                continue               # the launcher script is what makes it a real instance
            port = 0
            for cand in ("%s.cfg" % inst, "common.cfg", "_default.cfg"):
                try:
                    with open(os.path.join(cfg_dir, inst, cand), encoding="utf-8",
                              errors="replace") as fh:
                        m = re.search(r"^\s*port=\D*(\d+)", fh.read(), re.M)
                    if m:
                        port = int(m.group(1))
                        break
                except OSError:
                    continue
            try:
                backups = sum(1 for f in os.listdir(os.path.join(HOME_ROOT, user, "lgsm", "backup"))
                              if re.search(r"\.(tar|tgz|zip)", f))
            except OSError:
                backups = 0
            try:
                with open(os.path.join(HOME_ROOT, user, "lgsm", "mods", "installed-mods.txt"),
                          encoding="utf-8", errors="replace") as fh:
                    mods = sum(1 for ln in fh if ln.strip())
            except OSError:
                mods = 0
            sys.stdout.write("FOUND|%s|%s|%d|%d|%d|%d|%d\n"
                             % (user, inst, port, backups, mods, len(cron_lines), autostart))

    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        pw = None
    if os.getuid() != 0 or pw is None or pw.pw_uid == 0:
        _emit()                       # nothing to drop to, or nothing to drop FROM
        return
    sys.stdout.flush()                # the child gets a copy of this buffer; do not double-print
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
            if os.getuid() != pw.pw_uid or os.geteuid() == 0:
                os._exit(1)           # refuse to read anything if the drop did not take
            _emit()
            sys.stdout.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    os.waitpid(pid, 0)


def do_game_backup_read(args, content):
    """Stream a game server's backup archive to stdout, reading it AS THE GAME USER.

    The panel ran `sudo -u <user> cat /home/<user>/lgsm/backup/<name>`. Note what that form gets
    right and this must not lose: the read happens as the GAME user, so a symlink planted at that
    path can only reach files that user could already read. Reading it as root instead would turn a
    download button into "hand me any file on the box" — a privilege INCREASE, from a change meant
    to reduce privilege.

    So the child drops credentials completely — supplementary groups, gid, then uid, in that order,
    because setuid first would make the rest impossible — and only then opens the file."""
    user, name = args[0], args[1]
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        sys.stderr.write("no such user\n")
        return 1
    if pw.pw_uid == 0:
        sys.stderr.write("refusing a uid-0 account\n")   # see v_managed_user
        return 1
    path = os.path.join(pw.pw_dir, "lgsm", "backup", name)
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
            if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
                os._exit(1)          # refuse to read anything if the drop did not take
            # ...and "the drop took" is not "we are no longer root". setuid(0) SUCCEEDS when
            # already root, so the line above compares 0 against 0 and passes — a target of uid 0
            # sailed straight through the one guard these read verbs rest on. v_managed_user
            # refuses that NAME now; this refuses the STATE, so any future path that reaches here
            # with uid 0 still cannot read as root.
            if os.getuid() == 0 or os.geteuid() == 0:
                os._exit(1)
            with open(path, "rb") as fh:
                buf = sys.stdout.buffer
                while True:
                    chunk = fh.read(262144)
                    if not chunk:
                        break
                    buf.write(chunk)
                buf.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    _pid, status = os.waitpid(pid, 0)
    return 0 if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 else 1


def _game_home_path(user, relpath):
    """(passwd entry, absolute path) for `relpath` under a game user's home — or (None, None).

    The home directory comes from the PASSWD ENTRY, never from the caller, and the joined path is
    normalised and re-checked lexically here. Symlinks are deliberately NOT settled at this point:
    that answer is only honest after the credential drop, so _as_game_user redoes it there."""
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return None, None
    if pw.pw_uid == 0:
        # Belt and braces with v_managed_user: uid 0's home is /root, and the credential drop that
        # is supposed to contain this read is a no-op for it.
        return None, None
    home = os.path.realpath(pw.pw_dir)
    abspath = os.path.normpath(os.path.join(home, relpath))
    if abspath != home and not abspath.startswith(home + "/"):
        return None, None
    return pw, abspath


def _drop_to(pw, own_groups=False):
    """Become `pw` irreversibly. True if the drop took, False if anything about it did not.

    Order matters: supplementary groups, then gid, then uid, because setuid first makes the other
    two impossible.

    The checks afterwards are not belt-and-braces. setuid(0) SUCCEEDS when already root, so
    `getuid() != pw.pw_uid` compares 0 against 0 and passes -- a target of uid 0 sailed straight
    through the one guard the read verbs rest on. v_managed_user refuses that NAME; this refuses
    the STATE, so any future path reaching here with uid 0 still cannot act as root.

    `own_groups` picks which supplementary groups the process ends up with, and the two callers
    genuinely want different answers. A read verb wants NONE: it is opening a path chosen by the
    caller, and every group the account happens to be in is reach it does not need. Running a game
    wants the account's OWN groups, which is what `sudo -u` gave it before this verb existed --
    the panel puts game users in a shared group for content directories, and the game process
    inherits these, so dropping them would take mounted content away at runtime.
    """
    if own_groups:
        os.initgroups(pw.pw_name, pw.pw_gid)
    else:
        os.setgroups([])
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)
    if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
        return False
    return not (os.getuid() == 0 or os.geteuid() == 0)


def _as_game_user(pw, abspath, emit):
    """Fork, drop to `pw`, re-resolve `abspath` inside that user's home, then emit(resolved).

    The credential drop is the whole security story of the download verbs, and it is the same one
    do_game_backup_read tells: the read must happen AS THE GAME USER. Reading as root would mean a
    symlink anywhere under that home — planted by a mod, by the game, or by anyone with a shell as
    that user — could hand the panel any file on the box, turning a privilege-reducing change into
    a privilege-increasing one.

    Order matters twice. Supplementary groups, then gid, then uid, because setuid first makes the
    rest impossible. And realpath AFTER the drop, because a check done before it is a check against
    a path nobody is going to open."""
    home = os.path.realpath(pw.pw_dir)
    pid = os.fork()
    if pid == 0:
        try:
            if not _drop_to(pw):
                os._exit(1)          # refuse to read anything if the drop did not take
            resolved = os.path.realpath(abspath)
            if resolved != home and not resolved.startswith(home + "/"):
                os._exit(1)          # a symlink pointing out of the home directory
            emit(resolved)
            sys.stdout.buffer.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    _pid, status = os.waitpid(pid, 0)
    return 0 if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 else 1


def _emit_file(path, buf):
    """Copy a regular file to `buf` in chunks. Raises on anything that is not a regular file."""
    if not os.path.isfile(path):
        raise ValueError("not a regular file")   # a directory, a device, a socket, a FIFO
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(262144)
            if not chunk:
                break
            buf.write(chunk)


def _emit_dir_tar(path, buf):
    """Write a streaming .tar.gz of the directory `path` to `buf`. Raises if it is not a directory.

    Entries are added ONE AT A TIME so that a single unreadable entry — permissions, a temp file
    that vanished mid-walk, a unix socket the game left behind — skips instead of truncating the
    archive half-way through somebody's download. Symlinks are stored as symlinks (tarfile's
    default), so the archive never carries out the contents of something the walk did not follow.
    """
    if not os.path.isdir(path):
        raise ValueError("not a directory")
    base = os.path.basename(path.rstrip("/")) or "download"
    # "w|gz" is the STREAMING writer: it never seeks, which is what makes a pipe a valid
    # destination. "w:gz" seeks, and would fail on one.
    with tarfile.open(fileobj=buf, mode="w|gz") as tf:
        try:
            tf.add(path, arcname=base, recursive=False)
        except OSError:
            # The directory's OWN entry — its mode and mtime. Losing it costs the archive nothing
            # a caller notices: tar recreates a missing parent when the members below are
            # extracted. Refusing to build the archive because its top entry could not be stat'd
            # would turn a readable folder into a failed download, so carry on to the walk.
            pass
        for root, dirs, files in os.walk(path, onerror=lambda _e: None):
            for name in dirs + files:
                full = os.path.join(root, name)
                try:
                    tf.add(full, arcname=os.path.join(base, os.path.relpath(full, path)),
                           recursive=False)
                except OSError:
                    continue


def _lgsm_log_path(home, action):
    """Where a long action's output is tee'd, DERIVED rather than passed in.

    panel/routes/_shared.py:_action_log_path builds the same path from the same two values, so the
    panel can tail the file while the action runs. Deriving it on both sides instead of sending it
    means this verb takes no path argument at all -- there is nothing to point somewhere else."""
    return os.path.join(home, ".panel-%s.log" % action)


def _lgsm_child(pw, home, selfname, action, stdin_text, tee):
    """The dropped half of do_lgsm_command: runs the LinuxGSM script, returns its exit status.

    Everything here happens AS THE GAME USER, and not only because LinuxGSM refuses to run as root
    (`[ FAIL ] Do NOT run as root!` -- which it prints while exiting 0, so a command wrongly run as
    root reads as a success). The script, its config and every file it touches sit under a home
    directory the game, its mods and anyone with a shell as that account can write, so running it
    as root would make a symlink there a route to the rest of the box.
    """
    try:
        if not _drop_to(pw, own_groups=True):
            return 1
        script = os.path.realpath(os.path.join(home, selfname))
        if script != home and not script.startswith(home + "/"):
            return 1                      # a symlink pointing out of the home directory
        if not (os.path.isfile(script) and os.access(script, os.X_OK)):
            sys.stderr.write("no executable %s in %s\n" % (selfname, home))
            return 1
        # Built here, not inherited: the panel's own environment carries its secrets, and LinuxGSM
        # reads a good deal of what it finds.
        env = {
            "HOME": home, "USER": pw.pw_name, "LOGNAME": pw.pw_name, "PWD": home,
            "SHELL": "/bin/bash",
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            # Without this LinuxGSM emits `tput: unknown terminal "unknown"` on almost every line.
            "TERM": "xterm",
            "LANG": os.environ.get("LANG", "C.UTF-8"),
        }
        out_fd = os.dup(1)
        log_fd = None
        if tee:
            try:
                # O_NOFOLLOW because the destination sits in a directory the game user writes: the
                # final component is the one part of this path that could have become a symlink.
                log_fd = os.open(_lgsm_log_path(home, action),
                                 os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            except OSError:
                tee = False               # no log to tail, but the action still runs
        try:
            proc = subprocess.Popen(          # nosec B603 - argv from an allowlisted action
                [script, action], cwd=home, env=env, stdin=subprocess.PIPE,
                stdout=(log_fd if tee else out_fd), stderr=subprocess.STDOUT)
            proc.communicate(stdin_text.encode())
            rc = proc.returncode
        finally:
            if log_fd is not None:
                os.close(log_fd)
        if tee:
            # Hand the whole output back too, exactly as the shell form's trailing `cat` did: the
            # audit entry and the bot's completion summary read it from here, while the live
            # console tails the file as it fills.
            with open(_lgsm_log_path(home, action), "rb") as fh:
                with os.fdopen(os.dup(out_fd), "wb") as sink:
                    shutil.copyfileobj(fh, sink, 262144)
        return rc if 0 <= rc <= 255 else 1
    except Exception:
        return 1


def do_gameuser_group(args, content):
    """Put a game account in GAME_GROUP, creating the group if it is not there yet.

    This is the other half of the fix `lgsm-command` started. Converting run_as_game_user to a
    verb put SERVER CONTROL back on a narrow-grant host, but it was one of about 45 sites that
    build `sudo -u <game user> bash -c '<shell>'`: the file browser, the GMod content mounts, the
    cron writers and the install flows are the same shape and fail the same way. Rather than
    leave those broken, install.sh grants the panel the right to become an account IN THIS GROUP
    -- never root, which stays reachable only through this helper.

    So membership of this group is a privilege boundary, and the group name is a literal here
    rather than an argument: a caller that could name the group could name one that root is in.
    The ACCOUNT is still checked -- v_managed_user refuses uid 0 -- so this cannot be used to put
    a root-equivalent account inside the panel's reach either.

    `groupadd -f` succeeds when the group already exists, and `usermod -aG` is append-only, so
    running this for an account that is already a member is a no-op."""
    user = args[0]
    verdict, why = _escalation_verdict(user)
    if verdict == "yes":
        sys.stderr.write("refusing to enrol %s in %s: it can already reach root (%s)\n"
                         % (user, GAME_GROUP, why))
        return 1
    if verdict != "no":
        sys.stderr.write("refusing to enrol %s in %s: could not confirm it cannot reach root (%s)\n"
                         % (user, GAME_GROUP, why))
        return 1
    rc = subprocess.run([resolve("groupadd"), "-f", GAME_GROUP],      # nosec B603 - fixed argv
                        shell=False, capture_output=True, timeout=30).returncode
    if rc != 0:
        sys.stderr.write("could not create group %s\n" % GAME_GROUP)
        return rc
    r = subprocess.run([resolve("usermod"), "-aG", GAME_GROUP, user],  # nosec B603 - fixed argv
                       shell=False, capture_output=True, timeout=30)
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode("utf-8", "replace")[:400])
    return r.returncode


# Steam's crash handler insists on a crash-dump directory under /tmp that the RUNNING user owns,
# and it only ever tries ten names: /tmp/dumps, then /tmp/dumps01 .. /tmp/dumps09. That is one slot
# per Linux account, taken for good. The panel creates one account per game server, so the ELEVENTH
# Steam game on a host finds the table full and every SteamCMD run there dies:
#
#     src/crashhandler/breakpad_linux.cpp (740) : Fatal Assertion Failed:
#     FATAL: Steam cannot run. Please delete some /tmp/dumps* directories or change their
#     ownership to the local user.
#
# Not just installs — `update` and `validate` on servers that were working yesterday go with it.
# LinuxGSM reports it as "No appmanifest_<appid>.acf found", which is why this took so long to see.
#
# And the panel was the one filling the table: `user-delete` removes the account and leaves the
# directory, so the slot outlives the server. Ten uninstalls wedge a host with nothing running on
# it. Reproduced on the test box, where four of the ten slots belonged to accounts that no longer
# existed; freeing one let a fresh account's SteamCMD log in immediately.
#
# The paths are a FIXED list built here. Nothing a caller sends can name a path, and a slot is
# removed only when its owner is gone or is the account being named — never another live user's.
# Bandit flags a hard-coded /tmp path; these are not OUR temp paths to choose. They are the ten
# names Steam's crash handler hard-codes, so they are a fact to be read, not a location we could
# make unpredictable. Nothing is ever created here: the verb only REMOVES, after an lstat that
# refuses anything but a real directory (so a planted symlink is left alone) and an ownership test
# that keeps every live account's. shutil.rmtree walks by file descriptor on Linux, so there is no
# traversal to race.
STEAM_DUMP_SLOTS = ("/tmp/dumps",) + tuple("/tmp/dumps%02d" % i   # nosec B108 - Steam's own paths
                                           for i in range(1, 10))


def do_steam_dumps_sweep(args, content):
    """Free Steam crash-dump slots: the orphaned ones, plus the named account's own.

    Call it BEFORE deleting the account, while the name still resolves; a slot missed that way is
    picked up as an orphan by the next sweep, so this is self-healing either order.

    Fail-closed on a lookup that does not simply say "no such uid": a passwd database that cannot
    be read must not make every slot look orphaned."""
    user = args[0]
    try:
        own_uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        own_uid = None            # already deleted — the orphan rule below still frees its slot
    freed, held = [], []
    for path in STEAM_DUMP_SLOTS:
        try:
            st = os.lstat(path)
        except OSError:
            continue
        # lstat, and a directory test that a symlink fails: a symlink wearing one of these names is
        # left exactly where it is rather than followed out of /tmp.
        if not stat.S_ISDIR(st.st_mode):
            continue
        if st.st_uid == own_uid:
            drop = True
        else:
            try:
                pwd.getpwuid(st.st_uid)
                drop = False
            except KeyError:
                drop = True       # no account owns it any more
            except Exception:
                drop = False      # could not tell: keep it
        if not drop:
            held.append(path)
            continue
        try:
            shutil.rmtree(path)
            freed.append(path)
        except OSError as exc:
            sys.stderr.write("could not free %s: %s\n" % (path, exc))
    sys.stdout.write("freed=%d held=%d slots=%d\n"
                     % (len(freed), len(held), len(STEAM_DUMP_SLOTS)))
    for path in freed:
        sys.stdout.write("freed %s\n" % path)
    return 0


def do_steamcmd_install(args, content):
    """Install steamcmd, having pre-accepted its Steam licence.

    steamcmd is in multiverse and its licence is a debconf prompt. Unanswered, apt blocks forever
    waiting for input nobody can give -- which on the panel's own host meant the install step of
    a new Steam game hung until its timeout.

    The two preseed lines are FIXED STRINGS written here, not arguments: the only thing a caller
    could vary about them is which question gets which answer, and there is no legitimate reason
    to vary that. debconf-set-selections reads them on stdin, so nothing is interpolated into a
    command either.

    Tries the 32-bit package alongside the 64-bit one first and falls back to 64-bit alone,
    because steamcmd:i386 is unavailable on some releases while steamcmd itself installs fine. A
    box that gets only the 64-bit package still runs SteamCMD.
    """
    preseed = ("steam steam/question select I AGREE\n"
               "steam steam/license note \n")
    r = subprocess.run([resolve("debconf-set-selections")],   # nosec B603 - fixed argv
                       shell=False, input=preseed, text=True, capture_output=True, timeout=60)
    if r.returncode != 0:
        sys.stderr.write("could not preseed the steam licence: %s\n"
                         % r.stderr[:200])
        # Carry on anyway: on a host where the licence was already accepted the install still
        # works, and refusing here would turn a cosmetic failure into no steamcmd at all.
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    apt = resolve(APT)
    for pkgs in (["steamcmd", "steamcmd:i386"], ["steamcmd"]):
        r = subprocess.run([apt, "install", "-y"] + pkgs,     # nosec B603 - fixed argv
                           shell=False, env=env, capture_output=True, text=True, timeout=1800)
        sys.stdout.write(r.stdout[-2000:])
        if r.returncode == 0:
            return 0
    sys.stderr.write(r.stderr[-500:])
    return r.returncode


def do_restart_flags(args, content):
    """Print the game users whose ~/.restart-pending flag exists, one per line.

    The panel ran `ls -1d /home/*/.restart-pending`. Globbing /home is fine -- it is 0755 -- but
    the final component is not a wildcard, so the shell STATS each candidate, and that needs
    search permission on the game user's 0750 home. As the panel user every stat is EACCES, the
    glob matches nothing, `|| true` swallows the rc, and the caller receives an empty set: a
    confident "no restarts pending" produced by a read that never happened.

    Walking as root is the one part that needed root. Nothing here is built from an argument --
    the verb takes none.
    """
    try:
        homes = sorted(os.listdir("/home"))
    except OSError as exc:
        sys.stderr.write("cannot list /home: %s\n" % exc)
        return 1
    for name in homes:
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", name):
            continue
        try:
            if os.path.exists(os.path.join("/home", name, ".restart-pending")):
                print(name)
        except OSError:
            # One unreadable home must not lose the others. The caller distinguishes "none
            # pending" from "could not look" by this verb's EXIT CODE, not by empty output.
            continue
    return 0


def do_lgsm_command(args, content):
    """Run ONE LinuxGSM action as a game user, from that user's home directory.

    WHY THIS VERB EXISTS
        run_as_game_user was the last local escalation that did not route through one. It built
        `sudo -u <user> bash -c '<inner>'` and ran it with sudo=False, so the narrow sudoers grant
        install.sh writes -- which permits this helper and nothing else -- never covered it.

        That grant is not an edge case, it is the hardened install: run as root, install.sh creates
        a dedicated non-root `lgsmpanel` and reports `sudo grant: narrow`. On such a host, measured
        on a test box: `sudo -n -u gmodserver id` answered "sudo: a password is required",
        run_as_game_user returned rc=1 with no output, a restart through the API left the pid
        unchanged at 96218 and logged `restart_server success=False`, and /api/server/<id> reported
        "unknown" -- while /api/servers, which port-scans instead, still reported "online", so the
        dashboard looked entirely healthy. Status, start/stop/restart, console, mods and LinuxGSM
        backups were all dead.

    WHAT BOUNDS IT
        The account must be a managed, non-uid-0 user; the script name is an identifier and is
        re-resolved inside that user's home after the drop; the action is one word from
        LGSM_ACTIONS; the answers are bare tokens joined with newlines here. Nothing in this verb
        is assembled into a shell string -- the command is argv and the answers go down a pipe.
    """
    user, selfname, action, answers, tee = args[0], args[1], args[2], args[3], args[4]
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        sys.stderr.write("no such user\n")
        return 1
    home = os.path.realpath(pw.pw_dir)
    stdin_text = "" if answers == "-" else "".join(a + "\n" for a in answers.split(","))

    pid = os.fork()
    if pid == 0:
        os._exit(_lgsm_child(pw, home, selfname, action, stdin_text, tee == "yes"))
    _pid, status = os.waitpid(pid, 0)
    return os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1


def do_game_file_read(args, content):
    """Stream one file from under a game user's home to stdout, reading it AS THAT USER.

    The download side of the panel's file browser. Unlike the editor's read — text only, size
    capped, whole body in memory — a download has to work for a 4 GB map pack, so the bytes go
    straight to stdout in chunks and the panel streams them on to the browser."""
    user, relpath = args[0], args[1]
    pw, abspath = _game_home_path(user, relpath)
    if pw is None:
        sys.stderr.write("no such user, or path outside the home directory\n")
        return 1

    return _as_game_user(pw, abspath, lambda path: _emit_file(path, sys.stdout.buffer))


def do_game_dir_tar(args, content):
    """Stream a .tar.gz of one directory under a game user's home, built AS THAT USER.

    Python's tarfile rather than the tar binary, for two reasons. The helper resolves only the
