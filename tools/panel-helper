    # held back until the backup/validate/restore verbs existed to go with it.
    "sshd-port-dropin": (SSHD_DROPIN, 0o644),
    "sshd-socket-dropin": (SSHD_SOCKET_DROPIN, 0o644),
}


# ── What may be written INTO those destinations ───────────────────────────────────────────────
# The table above secures the PATH: a caller names a destination, it never supplies one. That half
# held. The content did not — it is this process's stdin, and it was written verbatim, on the
# reasoning that "it is never an argument, so no amount of it can change what runs". True of THIS
# process, and false of the destination: four of these files are read by something that executes
# what they contain, so writing them was a general "run this as root" primitive for anyone who
# could invoke the helper at all — which, under the narrow sudoers grant, is the panel user.
#
#   /etc/cron.d/lgsm-node-tools   cron lines carry a user field. `* * * * * root <cmd>` = root.
#   /etc/apt/apt.conf.d/20…       APT::Update::Pre-Invoke {"<cmd>";} runs under /bin/sh as root.
#   /etc/sysctl.d/99-tailscale    kernel.core_pattern=|<prog> makes the kernel run a program.
#   /etc/ssh/sshd_config.d/…      AuthorizedKeysCommand + …User root, and this file is the way
#                                 around sshd-set-directive, which validates key AND value.
#
# Each payload the panel actually sends is a fixed shape, so each gets a grammar that admits it and
# nothing else. Validation is REQUIRED, not optional: a destination with no entry is refused, so
# adding one to WRITE_TARGETS forces a decision about its content rather than inheriting "anything".
#
# Pinned to the KEYS the panel writes, not just a key-shaped key with a numeric value. Neither file
# needs a command to be dangerous: `fs.protected_hardlinks = 0` (or protected_symlinks,
# yama.ptrace_scope, kptr_restrict ...) turned host-wide kernel protections off for every local
# user, persistently — 99-tailscale sorts after the distro defaults and sysctl-reload applies it at
# once — and `APT::Get::AllowUnauthenticated "1";` let apt install unsigned packages as root. Both
# were accepted by the old `any lowercase key = digits` and `any APT:: key "digits"` shapes.
_RE_APT_CONF = re.compile(r'APT::Periodic::(?:Update-Package-Lists|Unattended-Upgrade'
                          r'|AutocleanInterval|Download-Upgradeable-Packages) "[0-9]+";')
_RE_SYSCTL = re.compile(r"(?:net\.ipv4\.ip_forward|net\.ipv6\.conf\.all\.forwarding) *= *1")
_RE_SSHD_PORT = re.compile(r"(Port [0-9]{1,5}|ListenAddress \[?[0-9A-Fa-f:.]+\]?:[0-9]{1,5})")
# A systemd unit file is NOT a config file of directives that only configure -- ExecStartPre= runs
# a command as root the moment the unit starts. So this grammar admits the section header, the
# empty ListenStream= that RESETS systemd's inherited list, and address:port entries. Nothing else:
# no Exec*, no User=, no EnvironmentFile=, no Also=.
_RE_SSHD_SOCKET = re.compile(r"(\[Socket\]|ListenStream=|ListenStream=\[?[0-9A-Fa-f:.]+\]?:[0-9]{1,5})")
# fail2ban: an ALLOWLIST of the sections and keys the panel writes, each with a value grammar, and
# checked over the WHOLE FILE rather than line by line.
#
# This was a denylist — two "runnable" keys (action*/banaction*, filter, chain) held to a bare name,
# every other line accepted — validated one stripped line at a time. fail2ban runs things as root on
# ban and on reload, and far more than those keys decide what:
#
#   * configparser treats an INDENTED line as a continuation of the previous value, and `action`
#     is legitimately multi-line. The strip() erased the indent, so `    sendmail[actionban=<cmd>]`
#     under `action = iptables` was checked as a line with no `=` and waved through, then parsed by
#     fail2ban as a second action carrying an inline actionban override: root, on the next reload.
#   * jail values are substituted UNESCAPED into action commands run through a shell — <port> in
#     iptables-multiport's actionstart, <logpath> in *-whois-lines — and jail.conf's own default
#     action builds `banaction[port="%(port)s", ...]` by interpolation, so `port = ssh", actionban="`
#     reopened the override without naming any action key at all.
#   * `ignorecommand` is a command fail2ban runs itself, and [INCLUDES] before/after pulls in a file
#     this validator never sees. Neither was on the list.
#
# The panel writes a handful of fixed shapes (system_ops._panel_f2b_jail_body / _filter_body,
# hosts.py's jail.local and _f2b_dropin_ignoreip_body), so every section, key and value it sends is
# enumerable. Anything else is refused: an indented line, a key before any section, a `:` delimiter,
# `%` interpolation, and any character outside printable ASCII (str.splitlines breaks on \x0c and
# friends, which a file read does not, so a validator splitting differently from fail2ban could be
# shown a different file).
_F2B_JAIL_SECTIONS = re.compile(r"DEFAULT|sshd|linuxgsm-panel")
_F2B_IP = r"[0-9A-Fa-f:.]+(?:/[0-9]{1,3})?"
_F2B_JAIL_KEYS = {
    "enabled": re.compile(r"true|false"),
    "bantime": re.compile(r"[0-9]+[smhdw]?"),
    "findtime": re.compile(r"[0-9]+[smhdw]?"),
    "maxretry": re.compile(r"[0-9]+"),
    "port": re.compile(r"[A-Za-z0-9]+(?:[,:][A-Za-z0-9]+)*"),
    "filter": re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*"),     # a name in filter.d: no path, no [
    "backend": re.compile(r"auto|polling|pyinotify|systemd|gamin"),
    "logpath": re.compile(r"/[A-Za-z0-9._@+/-]+"),
    # IPs and CIDRs only — no hostname, and no IPv6 zone id (`%eth0`), which ipaddress keeps
    # verbatim, spaces and newlines included.
    "ignoreip": re.compile(_F2B_IP + r"(?: +" + _F2B_IP + r")*"),
    # ONE fixed value, never a grammar: a banaction names a file in action.d that fail2ban runs as
    # root, so the only acceptable names are stock actions the panel itself chooses. It sends
    # exactly this one, for a panel reached through a proxy (system_ops._F2B_PANEL_ALLPORTS_ACTION).
    "banaction": re.compile(r"iptables-allports"),
}
_F2B_FILTER_SECTIONS = re.compile(r"Definition")
_F2B_FILTER_KEYS = {
    # A regex is matched against log lines, never run; only `%` (interpolation) is kept out.
    "failregex": re.compile(r"[^%]*"),
    "ignoreregex": re.compile(r"[^%]*"),
}
_RE_F2B_TEXT = re.compile(r"[\x20-\x7e\n]*")


def _fail2ban_config_ok(content, sections, keys):
    """True when `content` is made only of `[section]` headers from `sections` and `key = value`
    lines whose key is in `keys` and whose value that key's grammar matches in full."""
    content = content or ""
    if not _RE_F2B_TEXT.fullmatch(content):
        return False
    section = None
    for raw in content.split("\n"):
        if not raw.strip():
            continue
        if raw[0] == " ":
            return False                  # a continuation of the previous value
        line = raw.rstrip()
        if line.startswith(("#", ";")):
            continue
        if line.startswith("["):
            if not (line.endswith("]") and sections.fullmatch(line[1:-1])):
                return False
            section = line[1:-1]
            continue
        if section is None or "=" not in line:
            return False
        key, value = line.split("=", 1)
        rule = keys.get(key.strip())
        if rule is None or not rule.fullmatch(value.strip()):
            return False
    return True


class _WholeFile:
    """A content rule that must see the whole file at once, because what a line means depends on
    the lines around it (a continuation, the section it sits in). _content_ok calls it with the
    content; every other rule in WRITE_CONTENT is applied line by line by _lines_match."""

    def __init__(self, fn):
        self.fn = fn

    def __call__(self, content):
        return bool(self.fn(content))


_F2B_JAIL_RULE = _WholeFile(
    lambda c: _fail2ban_config_ok(c, _F2B_JAIL_SECTIONS, _F2B_JAIL_KEYS))
_F2B_FILTER_RULE = _WholeFile(
    lambda c: _fail2ban_config_ok(c, _F2B_FILTER_SECTIONS, _F2B_FILTER_KEYS))
# The sshd port drop-in says ONE thing: which ports the sshd jail bans on. It is read after every
# other jail file, so a key it admitted beyond `port` (enabled, maxretry...) would override the
# operator's jail.local — the narrowest grammar, not the jail rule's.
_F2B_SSHD_PORT_RULE = _WholeFile(
    lambda c: _fail2ban_config_ok(c, re.compile(r"sshd"), {"port": _F2B_JAIL_KEYS["port"]}))


def _lines_match(content, pattern):
    """Every non-blank, non-comment line is accepted by `pattern`.

    `pattern` is a compiled regex (matched in FULL) or a callable taking the line."""
    check = pattern if callable(pattern) and not hasattr(pattern, "fullmatch") \
        else pattern.fullmatch
    for line in (content or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if not check(line):
            return False
    return True


def _content_ok(content, rule):
    """Apply a WRITE_CONTENT rule: a _WholeFile sees the whole content, anything else each line."""
    if isinstance(rule, _WholeFile):
        return rule(content)
    return _lines_match(content, rule)


WRITE_CONTENT = {
    # A fixed body: the helper owns it, so the destination cannot be steered at all. The panel
    # still sends the same bytes; they are ignored rather than trusted, which also means a future
    # change to the schedule is a one-sided edit here instead of a lockstep one.
    "node-tools-cron": None,
    "apt-auto-upgrades": _RE_APT_CONF,
    "sysctl-tailscale": _RE_SYSCTL,
    "sshd-port-dropin": _RE_SSHD_PORT,
    "sshd-socket-dropin": _RE_SSHD_SOCKET,
    "fail2ban-jail-local": _F2B_JAIL_RULE,
    "fail2ban-panel-whitelist": _F2B_JAIL_RULE,
    "fail2ban-panel-filter": _F2B_FILTER_RULE,
    "fail2ban-panel-jail": _F2B_JAIL_RULE,
    "fail2ban-panel-sshd": _F2B_SSHD_PORT_RULE,
