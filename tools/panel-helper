    "sysctl-tailscale": ("/etc/sysctl.d/99-tailscale.conf", 0o644),
    # Added deliberately, with the sshd verbs below. Every other write here is a config the panel
    # owns outright; this one changes how the operator reaches the machine, which is why it was
    # held back until the backup/validate/restore verbs existed to go with it.
    "sshd-port-dropin": (SSHD_DROPIN, 0o644),
}





def resolve(prog):
    """The absolute path for a tool name, or FileNotFoundError. Only names in TOOLS resolve."""
    for cand in TOOLS.get(prog, ()):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    raise FileNotFoundError(prog)

# ── Argument validators ───────────────────────────────────────────────────────────────────────
# Each returns the value to place in argv, or raises ValueError. They are deliberately strict:
# a rejected argument is a bug report, not a fallback to something looser.


def v_portspec(s):
    """A UFW port specification: 27015, 27015/tcp, 27000:27100, 27000:27100/udp."""
    m = re.fullmatch(r"(\d{1,5})(?::(\d{1,5}))?(?:/(tcp|udp))?", s)
    if not m:
        raise ValueError("not a port specification")
    for p in (m.group(1), m.group(2)):
        if p is not None and not (1 <= int(p) <= 65535):
            raise ValueError("port out of range")
    if m.group(2) is not None and int(m.group(2)) < int(m.group(1)):
        raise ValueError("reversed port range")
    return s


def v_iface(s):
    """A network interface name. Linux caps these at 15 characters (IFNAMSIZ)."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", s):
        raise ValueError("not an interface name")
    return s


def v_cidr(s):
    """An IPv4/IPv6 address or network. Parsed, not pattern-matched, so 'any' and
    '1.2.3.4 || rm -rf /' are both rejected for the same reason: they are not addresses."""
    try:
        ipaddress.ip_network(s, strict=False)
    except ValueError:
        raise ValueError("not an IP address or network")
    return s


def v_comment(s):
    """A UFW rule comment. The panel already strips these to this charset before storing them;
    re-checking here is the point — the helper trusts nothing it is told."""
    if not re.fullmatch(r"[A-Za-z0-9 _.-]{0,60}", s):
        raise ValueError("comment has characters outside [A-Za-z0-9 _.-] or is over 60 chars")
    return s


def v_jail(s):
    """A fail2ban jail name."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", s):
        raise ValueError("not a jail name")
    return s


def v_username(s):
    """A Linux user name the panel is allowed to manage."""
    if not re.fullmatch(USERNAME_RE, s):
        raise ValueError("not a user name")
    return s


def home_of(user):
    """The home directory for a validated user name.

    Built here, never accepted from a caller — the one verb that removes it runs `rm -rf` as root,
    and the difference between /home/codserver and /home is a typo. v_username already rules out
    "", "." and ".."; this re-checks the assembled path anyway, because the cost of being wrong
    once is the whole /home directory."""
    path = HOME_ROOT + "/" + v_username(user)
    if not path.startswith(HOME_ROOT + "/") or len(path) <= len(HOME_ROOT) + 1 or ".." in path:
        raise ValueError("refusing to build that home path")
    return path


def v_linecount(s):
    """A number of log lines. Bounded so a caller cannot ask for the whole journal."""
    if not re.fullmatch(r"[1-9][0-9]{0,4}", s) or int(s) > 20000:
        raise ValueError("not a line count in 1..20000")
    return s


def v_portlist(s):
    """A comma-separated port list for a fail2ban jail: "2222,22"."""
    parts = s.split(",")
    if not (1 <= len(parts) <= 10):
        raise ValueError("expected 1..10 ports")
    for p in parts:
        if not re.fullmatch(r"[1-9][0-9]{0,4}", p) or not (1 <= int(p) <= 65535):
            raise ValueError("not a port list")
    return s


def v_package(s):
    """A Debian package name, optionally with an architecture qualifier (gcc:i386)."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]{0,60}(?::[a-z0-9]{1,10})?", s):
        raise ValueError("not a package name")
    return s


class Rest:
    """A validator that consumes every REMAINING argument — apt-install takes a package list, and
    the count is not known here. Each element is still checked individually."""

    def __init__(self, check, minimum=1, maximum=64):
        self.check, self.minimum, self.maximum = check, minimum, maximum


def v_rulenum(s):
    if not re.fullmatch(r"[1-9]\d{0,3}", s):
        raise ValueError("not a rule number")
    return s


def v_choice(*allowed):
    def check(s):
        if s not in allowed:
            raise ValueError("expected one of: " + ", ".join(allowed))
        return s
    return check


