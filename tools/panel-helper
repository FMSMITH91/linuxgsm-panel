# The ENTIRE environment a child of this helper starts with. Every child used to get
# `dict(os.environ)` -- whatever sudo let through -- and the ones with no env= at all inherited it
# anyway. The installer run for a self-update, apt, curl, tailscale and db_maintenance all ran as
# root with variables the panel had a hand in: env_reset is the sudoers policy's to set, not this
# file's, and a policy without it (or with an env_keep a distro or an operator widened) handed
# over BASH_ENV and SHELLOPTS for the root-run installer, CURL_HOME and proxies for curl,
# APT_CONFIG for apt, and the version-control variables for everything under them.
# TOOLS above already refuses to let PATH pick a binary; this is the same rule for everything else
# in the environment. The SUDO_* identity is kept because sudo sets it and verbs read it (who
# invoked us); nothing a caller chooses survives. A verb that genuinely needs more says so where it
# builds its child (DEBIAN_FRONTEND for apt, HOME for an account a child drops to).
CHILD_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
_KEPT_IDENTITY = ("SUDO_UID", "SUDO_GID", "SUDO_USER")


def _clean_env(**extra):
    """A fresh, minimal environment for a child process: fixed PATH and locale, root's HOME, the
    SUDO_* identity sudo set, and `extra`. Never a copy of os.environ."""
    env = {"PATH": CHILD_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/root"}
    for key in _KEPT_IDENTITY:
        if key in os.environ:
            env[key] = os.environ[key]
    env.update(extra)
    return env


def _scrub_environ():
    """Replace this process's own environment with _clean_env(), before any verb runs.

    Every subprocess.run here without an explicit env= inherits os.environ, and so does anything
    this interpreter consults itself (TMPDIR for tempfile, for one). Called from the __main__ block
    only, so a test that imports this file keeps its own environment."""
    clean = _clean_env()
    os.environ.clear()
    os.environ.update(clean)


