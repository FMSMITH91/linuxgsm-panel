    "fail2ban-client": ("/usr/bin/fail2ban-client", "/bin/fail2ban-client"),
    "systemctl": ("/usr/bin/systemctl", "/bin/systemctl"),
    "apt-get": ("/usr/bin/apt-get",),
    "dpkg": ("/usr/bin/dpkg",),
    "add-apt-repository": ("/usr/bin/add-apt-repository",),
    "pgrep": ("/usr/bin/pgrep", "/bin/pgrep"),
    "fuser": ("/usr/bin/fuser", "/bin/fuser"),
    "reboot": ("/usr/sbin/reboot", "/sbin/reboot"),
    "crontab": ("/usr/bin/crontab", "/bin/crontab"),
    "useradd": ("/usr/sbin/useradd", "/sbin/useradd"),
    "userdel": ("/usr/sbin/userdel", "/sbin/userdel"),
    "passwd": ("/usr/bin/passwd", "/bin/passwd"),
    "pkill": ("/usr/bin/pkill", "/bin/pkill"),
    "rm": ("/usr/bin/rm", "/bin/rm"),
    "sshd": ("/usr/sbin/sshd", "/sbin/sshd"),
    "ss": ("/usr/bin/ss", "/usr/sbin/ss", "/sbin/ss", "/bin/ss"),
    "sysctl": ("/usr/sbin/sysctl", "/sbin/sysctl"),
    "journalctl": ("/usr/bin/journalctl", "/bin/journalctl"),
    "tail": ("/usr/bin/tail", "/bin/tail"),
