# ignore it, and `sys.stdin.read()` for those is a blocking read to EOF of a descriptor nobody
# intends to write to -- so the verb hung for its caller's whole timeout whenever the panel's own
# stdin was an open pipe or tty rather than /dev/null. Under systemd it is /dev/null and this
# never showed; started any other way (a terminal, install.sh, a test harness) `content-dir-create`
# and 25 others simply stopped. Found by running the real GMod content flow on the test host.
#
# tests/unit/part05.py derives this set from the source and fails if it drifts, so adding a verb
# that reads stdin without listing it here cannot silently start returning "".
STDIN_VERBS = frozenset({"write-file", "content-cron-write"})

# Argv verbs whose SECRET comes on stdin: {verb: (its validator, the text the tool reads)}.
#
# `pro-attach <token>` ran `pro attach <token>`, and `tailscale-up-key <key> ...` ran `tailscale up
# --auth-key <key>`: the secret sat in this process's argv and the tool's, and /proc/<pid>/cmdline
# is world-readable unless /proc is mounted hidepid — so any local account, a game-server user
# included, could read a subscription token or a reusable tailnet key while the command ran. It is
# read from stdin here, validated like the argument it was (and, like it, never echoed), and handed
# to the tool on the tool's stdin. privileged.SECRET_STDIN is the panel's copy; a unit test keeps
# the two producing the same bytes.
SECRET_STDIN = {
    "pro-attach": (v_pro_token, lambda secret: 'token: "%s"\n' % secret),
    "tailscale-up-key": (v_authkey, lambda secret: secret + "\n"),
}


# ── a READ the caller has given up on ends, with everything it started ──────────────────────────
#
# The panel waits a bounded time for a verb, then gives up on it. It used to give up with SIGKILL
# to the process group it started: that reached `sudo` (its real uid is the panel's), which died
# without relaying anything, and NOT this helper or its children, which are root. They ran on with
# nobody to read their answer, parented to init: on the test VPS a `journal` read the debug report
# had given up on kept a core busy as root for about 5.5 minutes, and two reports stacked two.
#
# Three things end such a read now, whichever comes first:
#   - SIGTERM or SIGHUP. The panel sends SIGTERM first. Classic sudo (exec_nopty.c,
#     signal_cb_nopty) and sudo-rs (exec/no_pty.rs, on_signal) both relay it to this process,
#     and only to this process: kill(command_pid), never the group. So THIS process has to end
#     its children; dying of the signal's default action left them behind.
#   - The loss of its parent. sudo cannot relay a SIGKILL (from a panel older than the SIGTERM, or
#     after the panel's grace runs out): this process is then reparented, which the watch below
#     sees within _WATCH_TICK.
#   - READ_DEADLINE. A backstop for anything that neither signals nor dies: no read the panel makes
#     waits longer than 45 s (lgsm-discover), so a read still running at 60 s has no reader left.
#     A LinuxGSM read (LGSM_READ_ACTIONS) gets LGSM_READ_DEADLINE: the panel waits up to 60 s.
#
# ONLY reads. A verb that CHANGES the host keeps running when its caller leaves, as it always has --
# through the SIGTERM, and through the loss of sudo that follows it when the panel's grace runs out:
# apt or dpkg stopped halfway leaves packages half-configured, and a multi-step verb stopped
# between steps (the sshd drop-in written but not validated, an account created but not enrolled)
# is worse than one that finishes late. For those a SIGTERM is noted and the verb runs to its end,
# its own follow-up steps included -- dying of the signal would have skipped them. Which is which
# is decided by is_read(verb, args): lgsm-command is a read for its read-only LinuxGSM actions.
READ_VERBS = frozenset({
    "apt-any-running", "apt-upgrade-running", "content-game-present", "content-scan",
    "content-script-present", "crontab-list", "disk-free", "dpkg-lock-held", "f2b-log-lines",
    "f2b-status", "f2b-status-jail", "game-backup-read", "game-dir-tar", "game-file-read",
    "gmod-mount-read", "journal", "journal-cron", "lgsm-discover", "listening-sockets",
    "listening-sockets-owner", "log-tail", "os-update-log", "pro-status", "restart-flags",
    "sshd-effective-config", "sshd-socket-active", "sshd-validate", "ufw-status",
})
# ...of which these stream a download for as long as it takes, so they have no deadline: they end
# when the caller stops reading (their next write fails) or by the two signals above.
STREAMED_READS = frozenset({"game-backup-read", "game-dir-tar", "game-file-read"})
READ_DEADLINE = 60
# The LinuxGSM actions that only report (the panel's auth.READONLY_ACTIONS less `monitor`, which
# restarts a crashed server, and `test-alert`, which sends one). `lgsm-command` with one of these
# is a read: the panel waits up to 60 s for it (server_detail._run_sync_action), so its deadline
# is longer than that.
LGSM_READ_ACTIONS = frozenset({"details", "check-update", "postdetails"})
LGSM_READ_DEADLINE = 120
# How long a stopped read's processes get after SIGTERM before SIGKILL, and how often the watch for
# a lost parent and the deadline runs.
STOP_GRACE = 1.0
_WATCH_TICK = 0.5


class Stopped(BaseException):
    """A read verb was ended (see READ_VERBS): its rc, and why, in fixed words.

    A BaseException, like SystemExit: an action's own `except Exception` must not swallow it and
    carry on reading with its children already gone.
    """

    def __init__(self, rc, why):
        """Hold the exit status the helper answers with, and the fixed reason it prints."""
        super().__init__(why)
        self.rc, self.why = rc, why


_STOP = {"pid": None, "ppid": None, "verb": None, "read": False, "deadline": None,
         "stopping": False}


def is_read(verb, args):
    """Whether this run of `verb` only reads, and so is ended when its caller gives up on it."""
    if verb == "lgsm-command":
        return len(args) >= 3 and args[2] in LGSM_READ_ACTIONS
    return verb in READ_VERBS


def read_deadline(verb, args):
    """The deadline of a read (is_read), in seconds; None for a streamed download or a writer."""
    if not is_read(verb, args) or verb in STREAMED_READS:
        return None
    return LGSM_READ_DEADLINE if verb == "lgsm-command" else READ_DEADLINE


def _live_stat(pid):
    """(parent pid, start time) of `pid` from /proc/<pid>/stat; None when it is gone or a zombie.

    A zombie has exited: it is waiting for its parent to collect it, it cannot be stopped, and
    leaving it out keeps a SIGKILL from being aimed at it. The start time (clock ticks after boot)
    tells a process from a later one given the same pid.
    """
    try:
        with open("/proc/%d/stat" % pid, "rb") as fh:
            stat_line = fh.read()
        fields = stat_line[stat_line.rindex(b")") + 2:].split()
        return None if fields[0] == b"Z" else (int(fields[1]), int(fields[19]))
    except (OSError, ValueError, IndexError):
        return None


def _ppid_of(pid):
    """`pid`'s parent, or None for a process that is gone or a zombie (see _live_stat)."""
    st = _live_stat(pid)
    return st[0] if st else None


def _start_of(pid):
    """`pid`'s start time, or None for a process that is gone or a zombie (see _live_stat)."""
    st = _live_stat(pid)
    return st[1] if st else None


def descendants(root):
    """Every live process descended from `root`: its children, theirs, and so on.

    By parent links, read fresh each time, so a pid recycled by an unrelated process is never
    taken for one of ours. A descendant whose parent has already exited has been reparented away
    and is not found: stop_descendants keeps the pids it sent SIGTERM to for that.
    """
    kids = {}
    for name in os.listdir("/proc"):
        if name.isdigit():
            ppid = _ppid_of(int(name))
            if ppid is not None:
                kids.setdefault(ppid, []).append(int(name))
    found, todo = [], [root]
    while todo:
        for child in kids.get(todo.pop(), ()):
            found.append(child)
            todo.append(child)
    return found


def _signal_all(pids, sig):
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass                 # it exited in between: nothing left to stop


def stop_descendants(grace=STOP_GRACE):
    """SIGTERM everything this process started; SIGKILL what is still there after `grace`.

    "Still there" is a fresh walk of the tree AND every process the SIGTERM went to that is still
    running -- the same process, by its start time, never a later one given its pid. The walk
    alone misses a process that ignored the SIGTERM while its parent died of it: it has been
    reparented away from this process by then, and it would run on as root.
    """
    me = os.getpid()
    termed = {pid: _start_of(pid) for pid in descendants(me)}
    _signal_all(termed, signal.SIGTERM)

    def left():
        same = {pid for pid, start in termed.items() if start is not None and _start_of(pid) == start}
        return same | set(descendants(me))
    deadline = time.monotonic() + grace
    while left() and time.monotonic() < deadline:
        time.sleep(0.05)
    _signal_all(left(), signal.SIGKILL)


def _stop(rc, why):
    """End this read verb: its processes first, then the verb itself, by raising Stopped."""
    if _STOP["stopping"]:
        return
    _STOP["stopping"] = True
    signal.setitimer(signal.ITIMER_REAL, 0)
    stop_descendants()
    raise Stopped(rc, why)


def _on_stop_signal(signum, _frame):
    if os.getpid() != _STOP["pid"]:
        # A child this process forked (the game-user reads) inherits this handler; it gets the
        # signal's default action, as it did before.
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
        return
    if _STOP["read"]:
        _stop(143, "was stopped (signal %d): its caller gave up on it" % signum)
    # Any other verb runs to its end (see READ_VERBS): the signal is not its default action.


def _on_watch_tick(_signum, _frame):
    if os.getpid() != _STOP["pid"]:
        return
    if os.getppid() != _STOP["ppid"]:
        _stop(143, "lost its caller (its parent process exited)")
    if _STOP["deadline"] is not None and time.monotonic() > _STOP["deadline"][0]:
        _stop(124, "ran past its %d s limit" % _STOP["deadline"][1])


def arm_stop(verb, args=()):
    """Install the stop rules above for one run of `verb` with `args`.

    Called by run() alone, never by main(), so a test that imports this file and calls main()
    keeps its own signal handlers. A verb that changes the host gets the SIGTERM handler only
    (noted, not obeyed) and no watch: it must outlive the sudo above it (see READ_VERBS).
    """
    limit = read_deadline(verb, args)
    _STOP.update(pid=os.getpid(), ppid=os.getppid(), verb=verb, read=is_read(verb, args),
                 stopping=False,
                 deadline=(time.monotonic() + limit, limit) if limit is not None else None)
    signal.signal(signal.SIGTERM, _on_stop_signal)
    signal.signal(signal.SIGHUP, _on_stop_signal)
    if _STOP["read"]:
        signal.signal(signal.SIGALRM, _on_watch_tick)
        signal.setitimer(signal.ITIMER_REAL, _WATCH_TICK, _WATCH_TICK)


def run(argv):
    """main(argv) under the stop rules above. The rc and message of a stopped read are fixed."""
    verb = argv[1] if len(argv) >= 2 and argv[1] in VERBS else None
    arm_stop(verb, argv[2:])
    try:
        return main(argv)
    except Stopped as e:
        print("panel-helper: %s %s; it and every process it started were ended"
              % (verb, e.why), file=sys.stderr)
        return e.rc
    finally:
        # Done, or ended: a signal from here on gets its default action, as before this existed.
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        signal.signal(signal.SIGHUP, signal.SIG_DFL)


def validate(verb, args):
    """The checked arguments for `verb`, or ValueError. Shared by main() and by the panel's unit
    test, which compares this table's argv against privileged.py's for every verb — the two copies
    exist so that root never imports panel code, and only a test keeps them honest."""
    validators = VERBS[verb][0]
    args = list(args)
    rest = validators[-1] if validators and isinstance(validators[-1], Rest) else None
    fixed = validators[:-1] if rest else validators
    if rest is None:
        if len(args) != len(fixed):
            raise ValueError("%s takes %d argument(s), got %d" % (verb, len(fixed), len(args)))
        checks = list(fixed)
    else:
        low, high = len(fixed) + rest.minimum, len(fixed) + rest.maximum
        if not low <= len(args) <= high:
            raise ValueError("%s takes %d..%d argument(s), got %d" % (verb, low, high, len(args)))
        checks = list(fixed) + [rest.check] * (len(args) - len(fixed))
    out = []
    for i, (value, check) in enumerate(zip(args, checks)):
        try:
            out.append(check(value))
        except ValueError as e:
            raise ValueError("%s argument %d rejected (%s)" % (verb, i + 1, e))
    # Cross-argument checks, once every argument is individually valid. sshd-set-directive is the
    # only verb where one argument constrains another: a directive may only be set to a value from
    # its OWN allowed set, so the pair is checked, not just each half.
    if verb == "sshd-set-directive":
        if out[1] not in SSHD_DIRECTIVES[out[0]]:
            raise ValueError("sshd-set-directive: %s may not be set to that value" % out[0])
    return out


def main(argv):
    if len(argv) >= 2 and argv[1] == "--list-verbs":
        for verb in sorted(VERBS):
            print("%s\t%d" % (verb, len(VERBS[verb][0])))
        return 0
    if len(argv) >= 3 and argv[1] == "--job":
        return run_job(argv[2], argv[3:])
    if len(argv) < 2:
        print("panel-helper: a verb is required", file=sys.stderr)
        return 2
    verb, args = argv[1], argv[2:]
    spec = VERBS.get(verb)
    if spec is None:
        print("panel-helper: unknown verb %r" % verb, file=sys.stderr)
        return 2
    _, build, stdin_text = spec
    try:
        checked = validate(verb, args)
    except ValueError as e:
        # The rejected value is NOT echoed back: this runs as root and its stderr is surfaced in
        # the panel UI, so repeating attacker-controlled text here would be a reflection.
        print("panel-helper: %s" % e, file=sys.stderr)
        return 2
    if verb in SECRET_STDIN:
        check_secret, tool_doc = SECRET_STDIN[verb]
        try:
            stdin_text = tool_doc(check_secret(sys.stdin.read(4096).strip()))
        except ValueError:
            # Not echoed, not even in a rejection: it is a secret.
            print("panel-helper: %s: the secret on stdin was rejected" % verb, file=sys.stderr)
            return 2
    action = ACTIONS.get(verb)
    if action is not None:
        # The payload is this process's stdin. It is never an argument, so no amount of it can
        # change what runs.
        try:
            return action(checked, sys.stdin.read() if verb in STDIN_VERBS else "")
        except KeyError as e:
            # pwd.getpwnam on a name that is not an account here. Only the class is printed: a
            # KeyError carries the rejected name, and this stderr is surfaced in the panel UI.
            print("panel-helper: %s failed (%s)" % (verb, e.__class__.__name__), file=sys.stderr)
            return 1
        except OSError as e:
            print("panel-helper: %s failed (%s)" % (verb, e.__class__.__name__), file=sys.stderr)
            return 1

    argv = build(checked)
    env = _clean_env()
    if verb in NONINTERACTIVE:
        env["DEBIAN_FRONTEND"] = "noninteractive"
    try:
        argv[0] = resolve(argv[0])
        # A read is bounded here as well as by run()'s watch, a few seconds later so the watch
        # (which ends the tool's children too) goes first. This one holds when main() is called
        # without run(), as the tests do, and ends the tool's own process.
        p = subprocess.run(argv, shell=False,  # nosec B603 - argv is built from literals
                           input=stdin_text, env=env, capture_output=True, text=True,
                           timeout=READ_DEADLINE + 5 if verb in READ_VERBS else 1800)
    except FileNotFoundError:
        print("panel-helper: the tool for %s is not installed" % verb, file=sys.stderr)
        return 127
    except subprocess.TimeoutExpired:
        print("panel-helper: %s timed out" % verb, file=sys.stderr)
        return 124
    sys.stdout.write(p.stdout or "")
    sys.stderr.write(p.stderr or "")
    if verb == "user-create" and p.returncode == 0:
        _enrol_created_account(checked[0])
    return p.returncode


def _enrol_created_account(user):
    """Put an account user-create has JUST made in GAME_GROUP, when _enrolment_refusal allows it.

    This is how the panel's own accounts reach the grant now that gameuser-group asks for a
    LinuxGSM install: useradd has just succeeded, so the name did not exist a moment ago and this
    helper made it -- a game account by construction, with an empty skeleton home the install flow
    fills next. Every other test still applies (a name that collides with a privileged group, such
    as `docker` on a host where that group does not exist yet, is created but NOT enrolled).
    Never changes user-create's own exit status: the account exists either way, and the panel's
    gameuser-group call right after reports a refusal in its own words."""
    reason = _enrolment_refusal(user, need_install=False)
    if reason:
        sys.stderr.write("created %s but did not enrol it in %s: %s\n" % (user, GAME_GROUP, reason))
        return 1
    return _enrol(user)


if __name__ == "__main__":
    _scrub_environ()
    sys.exit(run(sys.argv))
