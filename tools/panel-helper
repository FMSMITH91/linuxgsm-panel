# Sources read by FIELD MATCH rather than by unit, for the debug report: the panel unit's own
# output without the three lines every sudo call writes there (panel-own), and those sudo lines
# alone (panel-sudo). Fixed terms, like the units above: nothing in them comes from the caller.
# The terms are systemd's add_matches_for_unit for linuxgsm-panel.service, with the service's own
# term narrowed to its stdout/journal output and its syslog lines at critical or worse.
#
# EVERY BRANCH HAS A TERM THAT IS SPARSE ON ITS OWN, or the read is not bounded by its window.
# journalctl ORs the branches, and sd-journal finds each next line by asking every branch afresh
# where ITS next match is (next_for_match, MATCH_OR_TERM). A branch that matches rarely is walked
# from the current line to its next match -- or to the end of the file -- once per line printed,
# and an AND walks one step per entry of its sparsest term. So a branch whose terms are all dense
# is re-walked across the whole window over and over: measured on a day with 2,400 panel lines,
# the read took 2.6 s, against 0.01 s for the same lines with these terms. The sparse terms:
#   - the panel's own output: SYSLOG_IDENTIFIER, which systemd sets on a service's stdout to the
#     basename of ExecStart's program (exec-invoke.c connect_logger_as), "python" for the unit
#     install.sh writes (and every update rewrites). The unit term alone is dense -- most of its
#     entries are the three lines each sudo call writes -- and so is _TRANSPORT=stdout (every
#     service's). PANEL_IDENT must follow install.sh's ExecStart; a unit check holds it to it.
#   - the unit's syslog lines: PRIORITY 0-2. A refused sudo is alert (1) and pam_unix's failed
#     authentication crit (2), its "conversation failed" err (3) beside them. Warnings (4) are
#     every host's ufw BLOCK lines, and errors (3) every public host's sshd scanner noise: with
#     either, this branch alone made the read ~50-250x slower on that day.
#   - the rest: MESSAGE_ID, UNIT=, OBJECT_SYSTEMD_UNIT= name this unit and are rare.
_PANEL_SVC = "linuxgsm-panel.service"
PANEL_IDENT = "python"
JOURNAL_MATCHES = {
    "panel-own": ("_SYSTEMD_UNIT=" + _PANEL_SVC, "_TRANSPORT=stdout", "_TRANSPORT=journal",
                  "SYSLOG_IDENTIFIER=" + PANEL_IDENT, "+",
                  "_SYSTEMD_UNIT=" + _PANEL_SVC, "_TRANSPORT=syslog", "PRIORITY=0", "PRIORITY=1",
                  "PRIORITY=2", "+",
                  "MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1", "_UID=0", "COREDUMP_UNIT=" + _PANEL_SVC,
                  "+", "_PID=1", "UNIT=" + _PANEL_SVC, "+", "_UID=0", "OBJECT_SYSTEMD_UNIT=" + _PANEL_SVC),
    "panel-sudo": ("_SYSTEMD_UNIT=" + _PANEL_SVC, "SYSLOG_IDENTIFIER=sudo"),
}
# How far back a FIELD-MATCH source reads, walking forward from there. It is what bounds the read.
# `-n N` walks BACKWARDS from the end until N entries match, so when the whole retained journal
# holds fewer than N, journalctl visits all of it -- and with these matches a step costs about one
# of the panel unit's entries, sudo noise included (sd-journal next_for_match: an AND of two dense
# terms whose intersection is sparse). On the test VPS (1.9 GB, 105 files, 1683 matching lines)
# `-n 5000` was still running as root at 315 s. --since with -n does not help on systemd 254+ (it
# seeks to the end and still walks back N first); --since WITHOUT -n seeks to the time and walks
# forward, so the cost is the window's, whatever the journal's size. `--lines=+N` keeps the output
# bounded too: the OLDEST N of the window (systemd 255+; 249-253 read `+N` as N and, with --since,
# also stop after the first N forward). A read that returns all N has more than the window holds
# room for, and the panel reads the newest lines instead (debug_report/_src_journal).
JOURNAL_SINCE = {"panel-own": "-24h", "panel-sudo": "-1h"}
JOURNAL_SOURCES = tuple(sorted(set(JOURNAL_UNITS) | set(JOURNAL_MATCHES)))


def journal_argv(source, lines):
    """The journalctl argv for one journal SOURCE name and a line count (already validated)."""
    if source in JOURNAL_MATCHES:
        return (["journalctl", "--no-pager", "-q", "--since=" + JOURNAL_SINCE[source],
                 "--lines=+" + lines] + list(JOURNAL_MATCHES[source]))
    return (["journalctl"] + [x for u in JOURNAL_UNITS[source] for x in ("-u", u)]
            + ["--no-pager", "-n", lines])


