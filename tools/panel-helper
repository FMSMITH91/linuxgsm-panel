def do_sshd_backup(args, content):
    """Snapshot the panel's sshd drop-in, if it exists. A missing file is success, not an error —
    the restore below treats "no snapshot" as "there was no drop-in before us"."""
    if os.path.isfile(SSHD_DROPIN):
        # copy2, not copyfile: it carries the mode across, so the restore below can be an exact
        # inverse. The snapshot is no more exposed than the file it copies, by construction.
        shutil.copy2(SSHD_DROPIN, SSHD_DROPIN_BAK)
    return 0


def do_sshd_restore(args, content):
    """Put the snapshot back, or remove the drop-in if there was no snapshot.

    This is the rollback for a port change that did not work, so it has to be the exact inverse of
    do_sshd_backup: a host that had no drop-in before ends with no drop-in, not with an empty one."""
    if os.path.isfile(SSHD_DROPIN_BAK):
        # os.replace moves the inode, so the snapshot's mode comes with it. There was a chmod 0o644
        # here, which was wrong twice over: it widened the file to world-readable, and it IMPOSED a
        # mode rather than restoring the one the host had. A rollback that changes permissions is
        # not a rollback.
        os.replace(SSHD_DROPIN_BAK, SSHD_DROPIN)
    else:
        try:
            os.unlink(SSHD_DROPIN)
        except FileNotFoundError:
            # Nothing to undo. The caller reverts unconditionally on any failure, including ones
            # that happen before the drop-in is written, so this is a normal path.
            pass
    return 0


def do_sshd_discard_backup(args, content):
    """Drop the snapshot after a successful change."""
    try:
        os.unlink(SSHD_DROPIN_BAK)
    except FileNotFoundError:
        pass          # there was no drop-in to snapshot; nothing to clean up
    return 0


def do_sshd_socket_backup(args, content):
    """Snapshot the panel's ssh.socket drop-in, if it exists. Exact mirror of do_sshd_backup."""
    if os.path.isfile(SSHD_SOCKET_DROPIN):
        shutil.copy2(SSHD_SOCKET_DROPIN, SSHD_SOCKET_DROPIN_BAK)
    return 0


def do_sshd_socket_restore(args, content):
    """Put the socket snapshot back, or remove the drop-in if there was no snapshot.

    The rollback for a port change on a socket-activated host, and the exact inverse of
    do_sshd_socket_backup: a host that had no drop-in before ends with none. systemd still needs a
    daemon-reload after this; the caller does that, because a reload is not the helper's to decide."""
    if os.path.isfile(SSHD_SOCKET_DROPIN_BAK):
        os.replace(SSHD_SOCKET_DROPIN_BAK, SSHD_SOCKET_DROPIN)
    else:
        try:
            os.unlink(SSHD_SOCKET_DROPIN)
        except FileNotFoundError:
            pass          # reverted before the drop-in was written; a normal path
    return 0


def do_sshd_socket_discard(args, content):
    """Drop the socket snapshot after a successful change."""
    try:
        os.unlink(SSHD_SOCKET_DROPIN_BAK)
    except FileNotFoundError:
        pass          # there was no drop-in to snapshot; nothing to clean up
    return 0


def do_f2b_sshd_ports(args, content):
    r"""Point fail2ban's [sshd] jail at a new port list.

    Was an in-place `sed -i '/^\[sshd\]/,/^\[/{s/^port *=.*/port = …/}'` running as root. The
    same edit in Python: walk jail.local, and inside the [sshd] section only, replace the port line.
    No jail.local, or no [sshd] section, means nothing to do — fail2ban keeps its default."""
    ports = args[0]
    path = F2B_JAIL_LOCAL
    if not os.path.isfile(path):
        return 0
    with open(path) as fh:
        lines = fh.readlines()
    out, in_sshd, changed = [], False, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            in_sshd = stripped == "[sshd]"
        elif in_sshd and re.match(r"\s*port\s*=", line):
            line = "port = %s\n" % ports
            changed = True
        out.append(line)
    if changed:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".panel-", suffix=".tmp")
        with os.fdopen(fd, "w") as fh:
            fh.writelines(out)
        # Keep jail.local's existing mode instead of imposing 0o644 — this edits a file the
        # distro (or the operator) created, and rewriting its permissions is not part of the edit.
        os.chmod(tmp, stat.S_IMODE(os.stat(path).st_mode))
        os.replace(tmp, path)
    return 0


# The exit status of a ufw-delete-num-if whose rule is no longer the one it was told to expect.
# Not one ufw uses (it exits 0 or 1), so the panel can tell "moved, nothing deleted" from "failed".
UFW_RULE_MOVED = 3


def _ufw_numbered_rule(listing, n):
    """Rule `n`'s text in a `ufw status numbered` listing, whitespace collapsed; None if absent.

    The panel parses the same listing with the same pattern (firewall._UFW_NUMBERED_RE) and
    collapses the text the same way before it sends it here as the rule it expects.
    """
    for line in listing.splitlines():
        m = re.match(r"^\s*\[\s*(\d+)\]\s*((?:\S.*)?)$", line)
        if m and int(m.group(1)) == n:
            return " ".join(m.group(2).split())
    return None


def do_ufw_delete_num_if(args, content):
    """`ufw delete <n>` only if rule <n> still reads <text> -- the check and the delete in one run.

    ufw numbers are POSITIONS: every insert above a rule renumbers it. The panel re-reads the
    firewall, checks rule n is the rule the operator picked (and not the one keeping SSH open),
    and deletes n, all under its per-host ufw_lock -- which serialises the panel's OWN changes, but
    not a `ufw` somebody types on the host between the panel's read and its delete. That shifted
    the numbers under the check and `ufw delete n` removed whatever sat at n by then. Here the read
    and the delete are the same root process, microseconds apart instead of an SSH round trip, and
    a rule that moved is left alone: exit UFW_RULE_MOVED, nothing deleted.
    """
    n, expected = args
    try:
        ufw = resolve(UFW)
    except FileNotFoundError:
        print("panel-helper: the tool for ufw-delete-num-if is not installed", file=sys.stderr)
        return 127
    st = subprocess.run([ufw, "status", "numbered"],      # nosec B603 - fixed argv
                        shell=False, env=_clean_env(), capture_output=True, text=True, timeout=60)
    if st.returncode != 0:
        sys.stdout.write(st.stdout[-2000:])
        sys.stderr.write(st.stderr[-500:])
        return st.returncode
    if _ufw_numbered_rule(st.stdout, int(n)) != expected:
        sys.stderr.write("ufw-delete-num-if: rule %s is no longer the rule that was checked; "
                         "nothing was deleted\n" % n)
        return UFW_RULE_MOVED
    # `ufw delete <n>` asks "Proceed (y|n)?"; answered on stdin, as ufw-delete-num's is.
    d = subprocess.run([ufw, "delete", n],                # nosec B603 - n passed v_rulenum
                       shell=False, input="y\n", env=_clean_env(), capture_output=True,
                       text=True, timeout=60)
    sys.stdout.write(d.stdout or "")
    sys.stderr.write(d.stderr or "")
    return d.returncode


def do_reboot_delayed(args, content):
    """Reboot a couple of seconds from now, so the command that asked for it can return first.

    Was `( sleep 2 ; reboot ) >/dev/null 2>&1 & echo scheduled` — a subshell, a background job and
    a redirect, all needing a shell. The double fork does the same thing: the grandchild is
    re-parented to init, survives this process exiting, waits, and execs reboot. No shell, and the
    only thing it can exec is the reboot binary this table resolves.

    With systemd as PID 1 the delay is a transient timer instead (_reboot_timer): the sleeping
    grandchild sat in the panel's cgroup, where a panel stop in those two seconds ended it and the
    reboot never happened. The grandchild stays as the path for a host without systemd."""
    if _job_launcher_available() and _reboot_timer() == 0:
        return 0
    pid = os.fork()
    if pid == 0:                       # child
        os.setsid()                    # detach from the session, so our exit cannot kill it
        if os.fork() == 0:             # grandchild — re-parented to init
            # finally, not except: os.execv does not return on success, so this only runs when the
            # exec failed. It guarantees the grandchild can never fall back into the caller's code
            # — for any exception, without catching BaseException to do it.
            try:
                devnull = os.open(os.devnull, os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(devnull, fd)
                if devnull > 2:
                    os.close(devnull)        # dup2 kept the copies; this one would leak
                time.sleep(REBOOT_DELAY_SECONDS)
                # nosec B606 - start_process_with_no_shell. No shell is exactly the point:
                # resolve() returns an absolute path from the fixed TOOLS table or raises,
                # "reboot" is a literal, and argv is a literal list. Nothing here is
                # user-influenced. Bandit flags the exec family on sight; the shell-using
                # members of it (B602/B604/B607) are what would matter, and this is not one.
                os.execv(resolve("reboot"), ["reboot"])  # nosec B606
            finally:
                os._exit(1)
        os._exit(0)
    os.waitpid(pid, 0)                 # reap the middle process immediately
    return 0


REBOOT_DELAY_SECONDS = 2


def _reboot_timer():
    """Start a transient timer, owned by the system manager, that reboots in a moment.

    REBOOT_DELAY_SECONDS from now. Returns systemd-run's exit status: anything but 0 means no
    timer, and the caller forks instead.
    """
    try:
        argv = [resolve("systemd-run"), "--on-active=%d" % REBOOT_DELAY_SECONDS, "--collect",
                "--quiet", "--", resolve("reboot")]
        return subprocess.run(argv, env=_clean_env(), stdin=subprocess.DEVNULL,  # nosec B603 - fixed argv
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30,
                              check=False).returncode
    except (OSError, subprocess.SubprocessError):
        return 1


def _sshd_includes_dropin_dir():
    """Whether sshd_config pulls in /etc/ssh/sshd_config.d at all.

    Debian 11 and the RHEL family do not ship the Include line, and on those hosts a file in that
    directory is inert — so the drop-in is written only where it is actually read, and the
    sshd_config edit below is what hardens everywhere else."""
    try:
        with open(SSHD_CONFIG, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if re.match(r"^\s*Include\s+\S*sshd_config\.d", line, re.IGNORECASE):
                    return True
    except OSError:
        return False
    return False


def _write_sshd_hardening_dropin(key, value):
    """Set one directive in the panel's hardening drop-in, leaving the others it already holds.

    Read-modify-write rather than an append, so setting PasswordAuthentication twice does not
    leave two lines whose second one is dead. Only keys from SSHD_DIRECTIVES survive the rewrite:
    this file is root-owned sshd config, and it should never be able to accumulate anything the
    verb is not allowed to set in the first place."""
    held = {}
    try:
        with open(SSHD_HARDENING_DROPIN, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] in SSHD_DIRECTIVES:
                    held[parts[0]] = parts[1].strip()
    except OSError:
        pass                              # not there yet, or unreadable: start from what we know
    held[key] = value
    body = SSHD_HARDENING_HEADER + "".join("%s %s\n" % (k, held[k]) for k in sorted(held))
    d = os.path.dirname(SSHD_HARDENING_DROPIN)
    os.makedirs(d, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.write(body)
    # 0600, not the 0644 the distro's own drop-ins carry. Nothing unprivileged reads this file:
    # sshd parses it as root, and the panel only ever reaches it back through this helper, which
    # is root too. There is no secret in it — just directive names and values — so this is not a
    # disclosure fix; it is that a root-owned file with no non-root reader has no reason to be
    # world-readable, which is what CodeQL's overly-permissive-mask rule is for.
    os.chmod(tmp, 0o600)
    os.replace(tmp, SSHD_HARDENING_DROPIN)


def _sshd_effective_value(key):
    """What `sshd -T` says `key` is actually set to, or None when that could not be read.

    None is NOT "unset": sshd -T prints every directive with its effective value, so a missing
    line means the read did not happen — sshd absent, the config failing to parse, the binary
    refusing to run. A failed read is not a fact, so the caller reports "could not verify"
    separately rather than reporting the directive as wrong."""
    try:
        argv = [resolve("sshd"), "-T"]
    except FileNotFoundError:
        return None
    try:
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=30)  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    low = key.lower()
    for line in r.stdout.decode("utf-8", "replace").splitlines():
        parts = line.strip().split(None, 1)
        if parts and parts[0].lower() == low:
            return parts[1].strip() if len(parts) > 1 else ""
    return None


def do_sshd_set_directive(args, content):
    """Set one sshd_config directive to one of its allowed values, and CHECK that it took.

    Was `sed -i 's/^#\\?<Key>.*/<Key> <value>/' /etc/ssh/sshd_config` — a regex substitution
    running as root, once per directive. Same edit here: replace the first line that sets the
    directive (commented or not), or append it if there is none. Both the key and the value come
    from SSHD_DIRECTIVES, so this cannot write a directive the panel does not harden.

    Editing sshd_config was not enough, and the verb could not tell. sshd uses the FIRST value it
    obtains for a keyword, Ubuntu's sshd_config Includes sshd_config.d before its own body, and
    cloud images put PasswordAuthentication in 50-cloud-init.conf — so on a stock Ubuntu VPS the
    panel wrote `PasswordAuthentication no`, `sshd -t` passed, sshd restarted, the bootstrap log
    said "Hardening SSH configuration", and password SSH stayed open to the internet. The write
    always succeeded, so rc 0 meant "written", never "in effect". Now the value also goes into a
    00- drop-in that sorts ahead of the distro's, and `sshd -T` is read back afterwards.

    Exit codes, because "not applied" and "could not check" are different answers:
      0  written, and sshd -T confirms the requested value
      4  written, but sshd -T still reports something else — another file wins
      5  written, but sshd -T could not be read, so nothing here is verified
    """
    key, value = args[0], args[1]
    try:
        with open(SSHD_CONFIG, encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return 1
    pattern = re.compile(r"^\s*#?\s*%s\b" % re.escape(key))
    out, replaced = [], False
    for line in lines:
        if not replaced and pattern.match(line):
            out.append("%s %s\n" % (key, value))
            replaced = True
        else:
            out.append(line)
    if not replaced:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out.append("%s %s\n" % (key, value))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(SSHD_CONFIG), prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.writelines(out)
    os.chmod(tmp, stat.S_IMODE(os.stat(SSHD_CONFIG).st_mode))   # keep sshd_config's own mode
    os.replace(tmp, SSHD_CONFIG)
    # ...and again where it will actually be obtained first, on the distros that read it.
    if _sshd_includes_dropin_dir():
        _write_sshd_hardening_dropin(key, value)
    effective = _sshd_effective_value(key)
    if effective is None:
        print("panel-helper: sshd-set-directive: wrote %s, but could not read sshd -T to "
              "confirm it took effect" % key, file=sys.stderr)
        return 5
    if effective.lower() != value.lower():
        print("panel-helper: sshd-set-directive: %s is still in effect as %r after the write — "
              "another sshd_config.d file sets it first" % (key, effective), file=sys.stderr)
        return 4
    return 0


def do_nodesource_setup(args, content):
    """Refused, always. nodesource-setup configures NodeSource's apt repository with its signing
    key pinned, and it exists for REMOTE hosts: the add-host bootstrap sends its shell rendering
    over SSH, and that bootstrap refuses the panel's own host. On this host NodeSource is
    install.sh's job (its nodesource_setup, the same pinned key), which runs as root anyway.

    So the helper gains nothing by implementing it, and would gain a lot of surface: a network
    fetch, gpg, and writes into apt's trust configuration, reachable by the panel user under the
    narrow grant. The verb is in VERBS only because the panel's table and this one must list the
    same verbs."""
    print("panel-helper: nodesource-setup is for remote hosts; on this host install.sh configures "
          "NodeSource", file=sys.stderr)
    return 2


def do_gamedig_install(args, content):
    """Refused, always. gamedig-install writes the panel's tools/gamedig files into
    /usr/local/lib/linuxgsm-panel/gamedig and runs install-gamedig.sh from there, as root. It exists
    for REMOTE hosts, where the panel already has `sudo bash -c`; the add-host bootstrap and the
    daily pass send its shell rendering over SSH.

    On this host those files come from install.sh, which stages them from root's own source like
    this helper, never from the checkout the panel user owns. Doing it here would take the lockfile
    and the script from that checkout and run them as root, which is the exact hole this helper
    closes. The weekly cron re-runs the root-owned copy install.sh placed. The verb is in VERBS only
    because the panel's table and this one must list the same verbs."""
    print("panel-helper: gamedig-install is for remote hosts; on this host install.sh installs "
          "gamedig from its root-owned copy", file=sys.stderr)
    return 2


def do_create_swapfile(args, content):
    """Create, enable and persist a 2G swap file, if there isn't one already.

    Was `fallocate && chmod && mkswap && swapon && grep -q /etc/fstab || echo >> /etc/fstab`. Note
    the shell version's precedence bug: `a && b && c || d` means the fstab line was appended
    whenever ANY earlier step failed, not only when grep found nothing. Here the steps are
    sequential and the fstab append happens only when the swap is actually on and the line is
    absent."""
    if os.path.exists(SWAPFILE):
        return 0
    for argv in ([resolve("fallocate"), "-l", "2G", SWAPFILE],):
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=120)  # nosec B603
        if r.returncode != 0:
            return r.returncode
    os.chmod(SWAPFILE, stat.S_IRUSR | stat.S_IWUSR)
    for argv in ([resolve("mkswap"), SWAPFILE], [resolve("swapon"), SWAPFILE]):
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=120)  # nosec B603
        if r.returncode != 0:
            return r.returncode
    try:
        with open(FSTAB, encoding="utf-8", errors="replace") as fh:
            already = any(SWAPFILE in ln for ln in fh)
    except OSError:
        already = True                     # no fstab to persist into; the swap is still on
    if not already:
        with open(FSTAB, "a", encoding="utf-8") as fh:
            fh.write(SWAP_FSTAB_LINE + "\n")
    return 0


# ── The detached jobs: each in the foreground of a transient service of its own ────────────────
# panel-db-repair, os-update-run, panel-restore and panel-self-update used to "detach" with
# setsid and a double fork. That leaves the SESSION, not the cgroup, so each job stayed in
# linuxgsm-panel.service's cgroup — and three of them stop that unit. On a system install
# `systemctl stop linuxgsm-panel.service` from inside it signals the whole cgroup, the job
# included: the repair and the restore died at their first step and left the panel DOWN (an
# explicit stop is not a crash, so Restart=always never brought it back), and the self-update died
# at the installer's [1/6]. os-update-run's apt was killed by any panel restart, mid-dpkg.
#
# So on a host booted with systemd each job is started as the MAIN process of a transient service
# (`systemd-run --unit=<fixed name>`), and does its work in the FOREGROUND there: re-launching the
# old double fork under systemd-run would let the unit's main process exit at once, and systemd
# would then kill the grandchild with it. A fixed name per job means a second one while the first
# runs is refused by systemd ("already loaded") instead of running twice. The job is
# `panel-helper --job <name>`, which refuses to run anywhere but inside that unit.
#
# Without systemd as PID 1 (a container) there is no unit to stop and nothing to escape from, and
# the double fork below is kept for that case.
JOB_UNITS = {
    "panel-db-repair": "linuxgsm-panel-db-repair.service",
    "os-update-run": "linuxgsm-panel-os-update.service",
    "panel-restore": "linuxgsm-panel-restore.service",
    "panel-self-update": "linuxgsm-panel-self-update.service",
}


def _job_launcher_available():
    """Say whether a job can be started as a transient service.

    That needs systemd as PID 1, systemd-run here, and a unified (v2) cgroup path for this process:
    the job finds its own unit by that path (_in_own_unit) and refuses to run anywhere else, so on a
    host booted with the legacy hierarchy (`0::/` and nothing else in /proc/self/cgroup) a launched
    job would only ever refuse. That host keeps the double fork, as before.
    """
    if not _systemd_booted() or not _cgroup_v2_placed():
        return False
    try:
        resolve("systemd-run")
    except FileNotFoundError:
        return False
    return True


def _job_setenv():
    """Return --setenv options for the SUDO_* identity sudo gave us.

    systemd-run starts the job with a clean environment, and install.sh's _panel_started_run reads
    SUDO_UID. Values are sudo's own.
    """
    out = []
    for key in _KEPT_IDENTITY:
        val = os.environ.get(key, "")
        if val and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", val):
            out.append("--setenv=%s=%s" % (key, val))
    return out


def _launch_job(job, args):
    """Start `job` as the main process of its own transient service.

    Returns systemd-run's verdict: 0 once the service has started, 1 (with systemd's words) when it
    could not, one of the same name still running included.
    """
    unit = JOB_UNITS[job]
    argv = ([resolve("systemd-run"), "--unit=" + unit, "--collect", "--quiet",
             "--description=linuxgsm-panel " + job] + _job_setenv()
            + ["--", os.path.realpath(__file__), "--job", job] + list(args))
    try:
        r = subprocess.run(argv, env=_clean_env(), stdin=subprocess.DEVNULL,  # nosec B603 - fixed argv
                           capture_output=True, text=True, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        sys.stderr.write("could not start %s (%s)\n" % (unit, type(exc).__name__))
        return 1
    if r.returncode != 0:
        sys.stderr.write("could not start %s: %s\n" % (unit, (r.stderr or "").strip()[-300:]))
        return 1
    return 0


def _in_own_unit(unit):
    """True when this process runs inside the transient service `unit`."""
    cg = _cgroup_of(os.getpid())
    return bool(cg) and cg.endswith("/" + unit)


def _detach():
    """Leave the session, fork again, and put stdio onto /dev/null.

    Returns in the grandchild only; the middle process exits at once. The no-systemd path of the
    jobs above.
    """
    os.setsid()                       # detach from the session so the caller's exit cannot kill us
    if os.fork() != 0:
        os._exit(0)                   # middle process: hand the work to the grandchild and go
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        if devnull > 2:
            os.close(devnull)         # dup2 kept the copies; this one would leak
    except OSError:
        # Best-effort: the job matters more than where its (unread) output goes.
        pass


def _os_update_detached():
    """The OS update in a detached grandchild. NEVER RETURNS — it ends in os._exit."""
    _detach()
    os._exit(_os_update_run())


def _os_update_run():
    """Run the OS update itself: apt update, full-upgrade, autoremove, then the UI's sentinel.

    0, or 1 once a FAILURE sentinel has been written for a run that died before its own.
    """
    try:
        env = _clean_env(DEBIAN_FRONTEND="noninteractive")
        apt = resolve("apt-get")
        with open(OS_UPDATE_LOG, "w", encoding="utf-8") as log:
            log.write("=== OS update started %s ===\n"
                      % time.strftime("%a %d %b %H:%M:%S %Z %Y"))
            log.flush()
            subprocess.run([apt, "update"], shell=False, env=env,  # nosec B603 - fixed argv
                           stdout=log, stderr=subprocess.STDOUT, timeout=1800)
            # The same flags apt-full-upgrade uses, for the same reasons: include Ubuntu's phased
            # rollouts so an explicit "install updates" actually reaches zero, and keep any config
            # file the operator has edited.
            rc = subprocess.run([apt, "-y", "-o", "APT::Get::Always-Include-Phased-Updates=true"]
                                + APT_CONFOLD + ["full-upgrade"], shell=False, env=env,  # nosec B603
                                stdout=log, stderr=subprocess.STDOUT, timeout=7200).returncode
            subprocess.run([apt, "-y", "autoremove"], shell=False, env=env,  # nosec B603
                           stdout=log, stderr=subprocess.STDOUT, timeout=1800)
            log.write("%s%d\n" % (OS_UPDATE_DONE, rc))
    except Exception:
        # Fall through to the failure sentinel below. Caught rather than allowed to propagate
        # because this may be a forked child: an unhandled traceback here would unwind into
        # whatever the parent was doing.
        pass
    else:
        return 0
    # Only here when the run above died before writing its own sentinel. The sentinel is how the
    # UI knows the job ended at all — without one the popup waits forever — so -1 says "it ended,
    # badly" rather than leaving the reader to guess.
    try:
        with open(OS_UPDATE_LOG, "a", encoding="utf-8") as fh:
            fh.write("%s-1\n" % OS_UPDATE_DONE)
    except OSError:
        # The log is unwritable (a full or read-only /run). Nothing further to try, and the caller
        # has long since returned — the exit status below is all that is left to say.
        pass
    return 1


def _db_repair_account(db_path):
    """The account the offline repair runs as: whoever owns the directory the database lives in.
    None when that cannot be established, and the caller then does not repair at all.

    Every file repair() makes is CREATED — the rebuilt database is a new file renamed over
    panel.db, and so is a restored backup — so it must be created as the panel's account, or the
    panel, started again straight afterwards, cannot open its own database. db_maintenance already
    confines itself to that owner when it starts as root; the helper drops before exec anyway, so
    root runs none of the script's code in a directory the panel user controls, and the boundary
    does not rest on the script. The one thing that drop skips — db_maintenance's reclaim of files
    an older, root-run repair left root-owned — the helper does itself (_db_repair_reclaim).

    lstat, not stat: that directory entry is one the panel user can replace, and a symlink it put
    there must not borrow the owner of whatever it points at — a root-owned target would hand the
    repair back to root. A link ROOT made (an operator who moved data/ to another disk) is
    followed, because then the directory it names is the panel's."""
    d = os.path.dirname(db_path)
    try:
        st = os.lstat(d)
        if stat.S_ISLNK(st.st_mode) and st.st_uid == 0:
            st = os.stat(d)
        return pwd.getpwuid(st.st_uid)
    except (OSError, KeyError):
        return None


def _db_repair_as(account):
    """subprocess.run keyword arguments that run the repair as `account` (see _db_repair_account).

    Nothing for root: a panel whose data directory root owns runs as root, and its files are
    root's. Otherwise the child drops to the account before exec, through _drop_to — which refuses
    to report success in any state that is still root — and a drop that does not take raises in
    the child, so subprocess.run raises here and the repair does not run as root instead."""
    if account.pw_uid == 0:
        return {}

    def _become_owner():
        if not _drop_to(account):
            raise OSError("could not become %s" % account.pw_name)

    return {"preexec_fn": _become_owner, "env": _clean_env(HOME=account.pw_dir)}


def _db_reclaim_files(dir_fd, name, uid, gid):
    """Hand the database's own files in `dir_fd` back to uid:gid. The same rule as
    db_maintenance._reclaim_db_files, on the root side of the drop (see _db_repair_reclaim).

    Each file is opened relative to the pinned directory with O_NOFOLLOW (a symlink is refused at
    open) and O_NONBLOCK (a fifo cannot hang root), and fchown'd only if it is a regular file with
    ONE link: a second link would mean the inode is also some other file, which must not change
    hands."""
    for member in (name, name + "-wal", name + "-shm", name + ".backup"):
        try:
            mfd = os.open(member, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK,
                          dir_fd=dir_fd)
        except OSError:
            continue          # absent, a symlink, or unopenable: nothing to hand back
        try:
            mst = os.fstat(mfd)
            if stat.S_ISREG(mst.st_mode) and mst.st_nlink == 1 and mst.st_uid != uid:
                os.fchown(mfd, uid, gid)
        except OSError:
            pass              # best effort: the repair reports a database it still cannot open
        finally:
            os.close(mfd)


def _db_repair_reclaim(db_path, account):
    """ROOT, before the repair drops to `account`: give back the database files an earlier
    root-run repair left root-owned.

    db_maintenance does this itself when it starts as root, and then becomes the directory's owner.
    Dropping here, before exec, means it never starts as root, so its reclaim never runs — and a
    panel.db, -wal, -shm or .backup that is root:root 0600 is then one the repair cannot open: it
    fails, or restores a backup beside a stale -wal the panel cannot read, and the panel comes back
    up on a database it cannot open. So the helper does that reclaim here, and only that.

    The directory is opened once and checked by DESCRIPTOR to still belong to `account`: the
    directory entry is one the panel user can swap after _db_repair_account looked, and a link to
    somebody else's directory must not get that directory's files handed to the panel user."""
    if account.pw_uid == 0:
        return                # a root-owned data directory: root keeps its files, nothing to give
    try:
        dfd = os.open(os.path.dirname(db_path), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        if os.fstat(dfd).st_uid == account.pw_uid:
            _db_reclaim_files(dfd, os.path.basename(db_path), account.pw_uid, account.pw_gid)
    except OSError:
        # Best effort: the repair still runs as the owner, and a file it cannot reclaim is reported
        # by db_maintenance's own write check rather than raised from here.
        pass
    finally:
        os.close(dfd)


def _db_repair_detached(db_path):
    """The offline repair in a detached grandchild. NEVER RETURNS — it ends in os._exit."""
    _detach()
    os._exit(_db_repair_run(db_path))


def _db_repair_run(db_path):
    """The offline repair itself: 0 once it ran, 1 when it could not start (and stopped nothing).

    stop -> repair -> start, as three argv calls with no shell between them. The panel used to
    compose this as a `bash -c` string and hand it to `sudo systemd-run`; the string was built from
    the panel's OWN directory, so root ran the panel user's interpreter on the panel user's script.
    Here the interpreter is the system one and the script is the root-owned copy beside this file,
    and it runs as the database's owner, not as root (_db_repair_account says why).
    """
    python = next((p for p in SYSTEM_PYTHON if os.path.isfile(p) and os.access(p, os.X_OK)), None)
    # No account, no repair — and no stop either, so the panel is left as it was. Running it as
    # root instead is exactly what leaves the database unopenable.
    account = _db_repair_account(db_path)
    if python is None or account is None:
        return 1
    try:
        systemctl = resolve("systemctl")
        # The panel is holding the database open; it has to go down before the file can be rebuilt.
        subprocess.run([systemctl, "stop", PANEL_UNIT],  # nosec B603 - fixed argv
                       check=False, timeout=120)
        # The drop below means db_maintenance never starts as root, so its own reclaim of files a
        # root-run repair left root-owned never runs; do it here, as root, before dropping.
        _db_repair_reclaim(db_path, account)
        subprocess.run([python, DBM_PATH, "repair", db_path],  # nosec B603 - root-owned script
                       check=False, timeout=900, **_db_repair_as(account))
    except Exception:
        # Swallowed so the finally below ALWAYS runs. This job has no stderr anyone reads, and the
        # only thing that matters after a failed repair is that the panel is started again —
        # which the finally does. A raise here would skip it and leave it down.
        pass
    finally:
        # Start it again WHATEVER happened above. A panel left down by a failed repair is worse
        # than a panel up with a database it will complain about.
        try:
            subprocess.run([resolve("systemctl"), "start", PANEL_UNIT],  # nosec B603 - fixed argv
                           check=False, timeout=120)
        except Exception:
            # Last resort in a finally: there is nobody to report to and nothing further to try.
            # Returning is the only remaining behaviour.
            pass
    return 0


def _copy_one_regular(src, dst, src_dir_fd=None, dst_dir_fd=None):
    """Copy ONE regular file, refusing to follow a symlink at either end. True if it was copied,
    False if `src` is not there.

    `src`/`dst` are plain NAMES when the directory descriptors are given, which is how
    restore_copy_members calls it — see there for why the directory has to be a descriptor and
    not a path.

    O_NOFOLLOW ON BOTH SIDES, and that is the whole point of this function.

    The staging directory belongs to the PANEL USER — it is the panel that creates it and unpacks
    the archive into it — and this code runs as ROOT. The loop this replaces was
    `if os.path.isfile(src): shutil.copyfile(src, dst)`, and both of those follow symlinks. So a
    panel that had been compromised could stage a SYMLINK under one of the four member names and
    have root do its reading and writing for it:

      * a link at stage/cred_key -> /etc/shadow, and root copies shadow's contents into the data
        directory as a real file the panel user owns and can read. Arbitrary read as root.
      * a link at data_dir/cred_key -> /etc/cron.d/anything, and root writes the staged content
        THROUGH it. Arbitrary write as root, which is a root shell a minute later.

    That is precisely the boundary this helper exists to create, so the fixed staging path is not
    enough on its own: the directory being fixed says nothing about what the names inside it
    resolve to. O_NOFOLLOW refuses a symlink AT OPEN TIME, atomically, so there is no window
    between checking and opening for the link to be swapped in.

    S_ISREG as well, because O_NOFOLLOW alone still opens a fifo or a device node — a fifo would
    hang the restore holding the panel down, and /dev/zero would fill the disk.

    HARD LINKS are handled here too, not left to the kernel. This used to say they were "covered
    by the kernel instead — fs.protected_hardlinks is 1 by default", but a sysctl is host state,
    and not state this code controls. So a staged source with a second link is refused (the inode
    is also some other file), and the destination is never opened over what is there: the copy is
    written to a fresh O_EXCL temp beside it and RENAMED onto the member name. A rename replaces
    the name, so whatever inode that name had — a link to anything — is left as it was.

    OWNERSHIP AND MODE are this function's to set, never the staged file's. It copied the staged
    file's mode with fchmod(S_IMODE(st_mode)) — set-uid, set-gid and sticky bits included — onto a
    file root had just created, and never chowned it. A member missing before the restore came
    back as a ROOT-owned file with whatever mode bits the panel user staged: a set-uid root file of
    its choosing. And config.json restored onto a fresh install came back root:root 0600, which the
    non-root service cannot even read, so its next save quietly replaced the restore with defaults.
    Every restored member is now 0600 and owned by the data directory's owner.
    """
    try:
        sfd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=src_dir_fd)
    except OSError:
        # ENOENT (nothing staged for this member) and ELOOP (it is a symlink) are both "do not
        # copy this one", and neither is worth failing the whole restore over.
        return False
    try:
        st = os.fstat(sfd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            return False
        if dst_dir_fd is not None:
            owner = os.fstat(dst_dir_fd)
        else:
            owner = os.stat(os.path.dirname(os.path.abspath(dst)))
        tmp = ".%s.restoring-%s" % (os.path.basename(dst), os.urandom(6).hex())
        try:
            dfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600,
                          dir_fd=dst_dir_fd)
        except OSError:
            return False            # the temp name could not be created fresh
        placed = False
        try:
            with open(sfd, "rb", closefd=False) as fsrc, open(dfd, "wb", closefd=False) as fdst:
                shutil.copyfileobj(fsrc, fdst)
            os.fchmod(dfd, 0o600)
            try:
                os.fchown(dfd, owner.st_uid, owner.st_gid)
            except OSError:
                # Only root can give a file away. Unprivileged it is already the caller's own.
                if os.geteuid() == 0:
                    raise
            os.fsync(dfd)
            os.rename(tmp, dst, src_dir_fd=dst_dir_fd, dst_dir_fd=dst_dir_fd)
            placed = True
        finally:
            os.close(dfd)
            if not placed:
                try:
                    os.unlink(tmp, dir_fd=dst_dir_fd)
                except OSError:
                    # A leftover dot-temp in the panel's own data dir; nothing reads it.
                    pass
    finally:
        os.close(sfd)
    return True


def restore_copy_members(stage, data_dir):
    """Copy the staged backup members over the live ones. Returns the names actually copied.

    Extracted from _restore_detached so a test can drive it: that function forks, detaches and
    ends in os._exit, so anything left inside it can only be tested by reimplementing it — and a
    test that reimplements the code it is guarding is how the original symlink follow would have
    stayed invisible.
    """
    copied = []
    # BOTH directories are opened ONCE, O_NOFOLLOW, and every member is opened relative to those
    # descriptors. The check this replaces — islink(stage) and then os.path.join(stage, member) —
    # was a check on a PATH followed by a use of that path: O_NOFOLLOW covers only the last
    # component, so swapping `stage` itself for a symlink between the two had root reading
    # <somewhere else>/panel.db and writing it over the live one. Narrow (it needs a file named
    # exactly like a member, in a directory of the attacker's choosing, in that window) and free
    # to close: a descriptor cannot be re-pointed once it is open.
    try:
        sdir = os.open(stage, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return copied           # the staging dir itself must be a real directory, not a link
    try:
        try:
            ddir = os.open(data_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            return copied
        try:
            for member in RESTORE_MEMBERS:
                dst = "panel.db" if member == "panel.db" else member
                if _copy_one_regular(member, dst, src_dir_fd=sdir, dst_dir_fd=ddir):
                    copied.append(member)
        finally:
            os.close(ddir)
    finally:
        os.close(sdir)
    return copied


def _restore_detached(data_dir):
    """The restore swap in a detached grandchild. NEVER RETURNS — it ends in os._exit."""
    _detach()
    _restore_run(data_dir)
    os._exit(0)


def _restore_run(data_dir):
    """The restore swap itself.

    Returns 0 whatever happened: the panel is started again and the staging directory removed on
    every path.

    stop -> copy the staged files over the live ones -> drop the WAL/SHM sidecars -> start -> wipe
    the staging directory. The panel used to write this as a bash script into its own data dir and
    hand the path to `sudo systemd-run`; root then executed a file the panel user had just written.
    Here the sequence is fixed in root-owned code and the only thing that varies is which of the
    four known members happen to be present."""
    stage = os.path.join(data_dir, RESTORE_STAGE)
    try:
        systemctl = resolve("systemctl")
        subprocess.run([systemctl, "stop", PANEL_UNIT],  # nosec B603 - fixed argv
                       check=False, timeout=120)
        restore_copy_members(stage, data_dir)
        # The restored database is authoritative; a stale WAL/SHM pair beside it is not.
        for side in ("-wal", "-shm"):
            try:
                os.unlink(os.path.join(data_dir, "panel.db" + side))
            except FileNotFoundError:
                # Nothing to drop — the panel was shut down cleanly. Not a problem.
                pass
    except Exception:
        # Swallowed so the finally below ALWAYS runs: after a half-finished restore the one thing
        # that matters is that the panel comes back up. A raise here would skip that.
        pass
    finally:
        try:
            subprocess.run([resolve("systemctl"), "start", PANEL_UNIT],  # nosec B603 - fixed argv
                           check=False, timeout=120)
        except Exception:
            # In a finally, with nobody to tell: nothing left to try.
            pass
        # The staging dir holds a plaintext database AND both encryption keys — the pair that
        # decrypts every stored SSH credential. Remove it whatever happened above.
        shutil.rmtree(stage, ignore_errors=True)
    return 0


def _restore_target():
    """Return panel.conf's data_dir when something is staged in it to restore.

    None (and why, on stderr) otherwise.
    """
    data_dir = panel_conf().get("data_dir", "")
    if not data_dir or not os.path.isabs(data_dir) or not os.path.isdir(data_dir):
        sys.stderr.write("panel.conf has no usable data_dir\n")
        return None
    if not os.path.isdir(os.path.join(data_dir, RESTORE_STAGE)):
        sys.stderr.write("nothing staged to restore\n")
        return None
    return data_dir


def _fork_detached(detached, *args):
    """Run `detached(*args)` in a child, and reap the middle process it leaves.

    `detached` is one of the NEVER-RETURNING _*_detached functions. 0: the job is on its way.
    """
    pid = os.fork()
    if pid == 0:
        detached(*args)               # never returns
    os.waitpid(pid, 0)
    return 0


def do_panel_restore(args, content):
    """Swap a staged backup into place, in a job of its own, and report that it started.

    Zero arguments. Both the staging directory and the destinations come from panel.conf's
    data_dir, so a caller chooses neither the source nor the target of a root-run copy.
    """
    data_dir = _restore_target()
    if data_dir is None:
        return 1
    if _job_launcher_available():
        rc = _launch_job("panel-restore", [])
    else:
        rc = _fork_detached(_restore_detached, data_dir)
    if rc == 0:
        sys.stdout.write("RESTORE_STARTED")
    return rc


SELF_UPDATE_LOG = "self-update.log"


def _open_log_in_dir(dir_path, name):
    """Open a FRESH log file `name` inside `dir_path` for writing, as root, and return it as a text
    file object. Raises OSError.

    For a directory the panel user owns — its data/ directory. `open(os.path.join(data_dir,
    "self-update.log"), "w")` there followed a symlink and truncated whatever it named, so the panel
    user could point that name at any file on the box and have root empty it (or create it) with
    one panel-self-update call. And O_NOFOLLOW alone would still truncate a hard link.

    So: the directory is opened once, O_NOFOLLOW, and everything happens relative to that
    descriptor. The old name is unlinked (removing a link removes the link, never its target) and
    the log is CREATED with O_EXCL, which fails on any name that reappears in between rather than
    opening it. The new file is then given to the directory's owner through the descriptor, so the
    panel can still read — and rotate — its own log."""
    dfd = os.open(dir_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        owner = os.fstat(dfd)
        try:
            os.unlink(name, dir_fd=dfd)
        except FileNotFoundError:
            # No previous log to replace: the O_EXCL create below is all that is needed.
            pass
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=dfd)
        try:
            os.fchown(fd, owner.st_uid, owner.st_gid)
        except OSError:
            # Only root can give a file away; unprivileged (a test, or a --user install that
            # reaches this some other way) it is already the caller's own file.
            if os.geteuid() == 0:
                os.close(fd)
                raise
    finally:
        os.close(dfd)
    return os.fdopen(fd, "w", encoding="utf-8")


def _self_update_env(ref, branch):
    """The environment the root-owned installer runs with for a panel-self-update.

    PANEL_SELF_UPDATE is what tells the installer the PANEL chose this run, and so chose
    PANEL_BRANCH: root then verifies its own pieces (this helper, db_maintenance, the installer,
    gamedig's lockfile and install script) against main only, and withholds them on any other
    branch. An operator running install.sh as
    root chooses the branch themselves, and root follows it. Set AFTER building the base, so no
    value the panel hands sudo can remove it — this verb is the panel's only way to run the
    installer as root, so there is no route on which the panel looks like the operator.

    The base is _clean_env(), not a copy of os.environ: this is root starting bash, and bash acts
    on BASH_ENV, SHELLOPTS and exported functions from its environment before the script's first
    line. SUDO_UID survives it, which install.sh's _panel_started_run also reads."""
    env = _clean_env()
    env["PANEL_UPDATE_REF"] = "" if ref == "-" else ref
    env["PANEL_BRANCH"] = "" if branch == "-" else branch
    # A panel update must never apply host OS packages or reboot the box — that would take every
    # game server down mid-update. OS updates stay a separate, explicit action.
    env["PANEL_NO_UPGRADE"] = "1"
    env["PANEL_SELF_UPDATE"] = "1"
    return env


def _self_update_detached(panel_dir, data_dir, ref, branch):
    """The self-update in a detached grandchild. NEVER RETURNS — it ends in os._exit."""
    _detach()
    _self_update_run(panel_dir, data_dir, ref, branch)
    os._exit(0)


def _self_update_run(panel_dir, data_dir, ref, branch):
    """The self-update itself: the installer, with its output and its exit line in the log.

    Runs the ROOT-OWNED installer, not the one in the panel's checkout. The panel used to write a
    wrapper script into its own data dir that exported three variables and then ran
    `bash <panel_dir>/install.sh`, and hand that wrapper to `sudo systemd-run` — so root executed
    two files the panel user could rewrite.

    Note what this does NOT try to be: self-update inherently means "fetch new code and run it".
    No amount of argv discipline makes that untrusted-safe. What it buys is that the ROOT-run part
    is fixed and small; the code the installer pulls goes on to run as the PANEL user, and its
    trustworthiness rests on the signed, CI-verified commit — which is checked before we get here.
    """
    env = _self_update_env(ref, branch)
    try:
        with _open_log_in_dir(data_dir, SELF_UPDATE_LOG) as log:
            log.write("=== panel self-update ===\n")
            log.flush()
            log.write("=== installer exit %s ===\n" % _run_installer_to(log, panel_dir, env))
    except Exception:
        # Nobody reads this process's stderr; the installer's own log is the record. Returning is
        # all that is left.
        pass
    return 0


def _run_installer_to(log, panel_dir, env):
    """Run the root-owned installer with its output in `log`; return how it ended, as the text the
    exit line carries: its exit status, a number first.

    The panel's update card reads that line (panel_update_log in panel/ops/system_ops.py). An
    update that stops BEFORE the panel restarts — the source unreachable, a pinned commit that
    cannot be verified, a hold — never flips the panel's boot id, so without it the card could not
    tell a finished run from a slow one: the [ERROR] was in the log, and after three minutes the
    card said "Still working — reload the page to check." The wrapper script _launch_installer
    writes for the path without the helper ends on the same line.

    From "/", not from `panel_dir`. The installer's first decision is "is there an app.py where I
    am standing? then that directory is my SOURCE", and standing in the panel's checkout made
    root treat the panel-owned tree as an operator's clone. Worse, chdir() follows a symlink: the
    panel user owns the home that holds the checkout, so it could swap the checkout for a link to
    another tree of its own, and the installer's `pwd` (physical) then no longer matched
    PANEL_DIR -- the one test that kept the two apart -- and root tar-copied that tree into
    PANEL_DIR, extracting through whatever directory links waited there. install.sh now also
    ignores its working directory whenever PANEL_SELF_UPDATE is set; `panel_dir` stays a
    parameter only because it is what the callers already hold."""
    try:
        rc = subprocess.run([resolve("bash_installer"), INSTALLER_PATH],  # nosec B603 - fixed path
                            cwd="/", env=env, stdout=log, stderr=subprocess.STDOUT,
                            check=False, timeout=1800).returncode
    except subprocess.TimeoutExpired:
        return "124 (the installer was stopped after 30 minutes)"
    except Exception as exc:
        return "127 (the installer could not be run: %s)" % type(exc).__name__
    # A negative status is the signal that ended it, which the shell reports as 128 + N.
    return str(rc if rc >= 0 else 128 - rc)


def _self_update_target():
    """Return (panel_dir, data_dir) from panel.conf for the self-update.

    Only when both exist and the root-owned installer is in place; None (and why, on stderr)
    otherwise.
    """
    conf = panel_conf()
    panel_dir, data_dir = conf.get("panel_dir", ""), conf.get("data_dir", "")
    if not panel_dir or not os.path.isdir(panel_dir) or not data_dir or not os.path.isdir(data_dir):
        sys.stderr.write("panel.conf has no usable panel_dir/data_dir\n")
        return None
    if not os.path.isfile(INSTALLER_PATH):
        sys.stderr.write("installer is not installed root-owned; re-run install.sh as root\n")
        return None
    return panel_dir, data_dir


def do_panel_self_update(args, content):
    """Start the panel self-update in a job of its own, and report that it launched.

    In the panel's cgroup the installer's own `systemctl stop linuxgsm-panel.service` ([1/6], before
    its signal traps are armed) ended the installer with the panel, on a system install, and left
    the panel down. So it runs as its own transient service — see _launch_job.
    """
    ref, branch = args[0], args[1]
    target = _self_update_target()
    if target is None:
        return 1
    if _job_launcher_available():
        rc = _launch_job("panel-self-update", [ref, branch])
    else:
        rc = _fork_detached(_self_update_detached, target[0], target[1], ref, branch)
    if rc == 0:
        sys.stdout.write("UPDATE_STARTED")
    return rc


def do_lgsm_discover(args, content):
    """List the LinuxGSM instances already installed on this host, one FOUND| line each.

    Reimplemented here rather than shelled out. The panel's version is a twenty-line shell program
    (nested loops, greps, a crontab read per user) and it needed root for exactly ONE thing:
    `crontab -u <someone-else> -l`. Everything else it does — reading config files under /home and
    counting backups — is ordinary file reading.

    Same output contract as the shell form, so the panel's parser is unchanged:
        FOUND|user|instance|port|backups|mods|cronlines|autostart
    """
    # crontab is OPTIONAL here. The shell form sent its errors to /dev/null, so a host without a
    # cron implementation still listed its instances with zero cron counts; resolving it eagerly
    # would turn "no crontab installed" into "no game servers found", which is a worse answer than
    # the one it replaced.
    try:
        crontab = resolve("crontab")
    except FileNotFoundError:
        crontab = None
    try:
        users = sorted(os.listdir(HOME_ROOT))
    except OSError:
        return 0                       # no /home is not an error, just nothing to find
    for user in users:
        if not re.fullmatch(USERNAME_RE, user):
            continue                   # not an account name: it could not be a FOUND field either
        cfg_dir = os.path.join(HOME_ROOT, user, "lgsm", "config-lgsm")
        if not os.path.isdir(cfg_dir):
            continue
        cron = ""
        try:
            if crontab is not None:
                r = subprocess.run([crontab, "-u", user, "-l"],  # nosec B603 - argv, user from /home
                                   check=False, timeout=15,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                cron = (r.stdout or b"").decode("utf-8", "replace")
        except Exception:
            # A user with no crontab exits non-zero; anything else here is equally non-fatal —
            # the instance still counts, it just reports zero cron lines.
            cron = ""
        cron_lines = [ln for ln in cron.splitlines()
                      if ln.strip() and not ln.strip().startswith("#")]
        autostart = sum(1 for ln in cron_lines if "@reboot" in ln or "monitor" in ln)
        # The FILE reads happen as that user, not as root. Everything below lives inside their own
        # home, so every path component is theirs to replace: a symlink at ~/lgsm/config-lgsm/x/
        # x.cfg turned this into a port-number oracle over any root-readable file, one at
        # ~/lgsm/backup into a directory-entry count, and one at ~/lgsm/mods/installed-mods.txt
        # into a line count. Small answers, but the same class as the mount.cfg read, and the fix
        # is the one the download verbs already use. crontab -u stays in the parent: it is the one
        # thing here that genuinely needs root.
        _discover_user(user, cfg_dir, cron_lines, autostart)
    return 0


def _discover_user(user, cfg_dir, cron_lines, autostart):
    """Emit the FOUND| lines for one /home user, reading their files AS THEM.

    Forks and drops when running as root, which is when it matters. Unprivileged (a test, or a
    per-user install) there is no boundary to cross, so it reads in-process and the answer is
    identical."""
    def _emit():
        try:
            instances = sorted(os.listdir(cfg_dir))
        except OSError:
            return
        for inst in instances:
            # The name is a file name the GAME account chose, and it lands in a line protocol the
            # panel splits on newlines and '|'. `x\nFOUND|<any account>|pzserver|...` forged a
            # second record naming another account, which the import route then trusted as "the
            # scan found it". Only a name in the panel's own identifier grammar is reported.
            if not re.fullmatch(DISCOVER_INSTANCE_RE, inst):
                continue
            if not os.access(os.path.join(HOME_ROOT, user, inst), os.X_OK):
                continue               # the launcher script is what makes it a real instance
            port = 0
            for cand in ("%s.cfg" % inst, "common.cfg", "_default.cfg"):
                try:
                    with open(os.path.join(cfg_dir, inst, cand), encoding="utf-8",
                              errors="replace") as fh:
                        m = re.search(r"^\s*port=\D*(\d+)", fh.read(), re.M)
                    if m:
                        port = int(m.group(1))
                        break
                except OSError:
                    continue
            try:
                backups = sum(1 for f in os.listdir(os.path.join(HOME_ROOT, user, "lgsm", "backup"))
                              if re.search(r"\.(tar|tgz|zip)", f))
            except OSError:
                backups = 0
            try:
                with open(os.path.join(HOME_ROOT, user, "lgsm", "mods", "installed-mods.txt"),
                          encoding="utf-8", errors="replace") as fh:
                    mods = sum(1 for ln in fh if ln.strip())
            except OSError:
                mods = 0
            sys.stdout.write("FOUND|%s|%s|%d|%d|%d|%d|%d\n"
                             % (user, inst, port, backups, mods, len(cron_lines), autostart))

    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        pw = None
    if os.getuid() != 0 or pw is None or pw.pw_uid == 0:
        _emit()                       # nothing to drop to, or nothing to drop FROM
        return
    sys.stdout.flush()                # the child gets a copy of this buffer; do not double-print
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
            if os.getuid() != pw.pw_uid or os.geteuid() == 0:
                os._exit(1)           # refuse to read anything if the drop did not take
            _emit()
            sys.stdout.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    os.waitpid(pid, 0)


def do_game_backup_read(args, content):
    """Stream a game server's backup archive to stdout, reading it AS THE GAME USER.

    The panel ran `sudo -u <user> cat /home/<user>/lgsm/backup/<name>`. Note what that form gets
    right and this must not lose: the read happens as the GAME user, so a symlink planted at that
    path can only reach files that user could already read. Reading it as root instead would turn a
    download button into "hand me any file on the box" — a privilege INCREASE, from a change meant
    to reduce privilege.

    So the child drops credentials completely — supplementary groups, gid, then uid, in that order,
    because setuid first would make the rest impossible — and only then opens the file."""
    user, name = args[0], args[1]
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        sys.stderr.write("no such user\n")
        return 1
    if pw.pw_uid == 0:
        sys.stderr.write("refusing a uid-0 account\n")   # see v_managed_user
        return 1
    path = os.path.join(pw.pw_dir, "lgsm", "backup", name)
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
            if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
                os._exit(1)          # refuse to read anything if the drop did not take
            # ...and "the drop took" is not "we are no longer root". setuid(0) SUCCEEDS when
            # already root, so the line above compares 0 against 0 and passes — a target of uid 0
            # sailed straight through the one guard these read verbs rest on. v_managed_user
            # refuses that NAME now; this refuses the STATE, so any future path that reaches here
            # with uid 0 still cannot read as root.
            if os.getuid() == 0 or os.geteuid() == 0:
                os._exit(1)
            with open(path, "rb") as fh:
                buf = sys.stdout.buffer
                while True:
                    chunk = fh.read(262144)
                    if not chunk:
                        break
                    buf.write(chunk)
                buf.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    _pid, status = os.waitpid(pid, 0)
    return 0 if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 else 1


def _game_home_path(user, relpath):
    """(passwd entry, absolute path) for `relpath` under a game user's home — or (None, None).

    The home directory comes from the PASSWD ENTRY, never from the caller, and the joined path is
    normalised and re-checked lexically here. Symlinks are deliberately NOT settled at this point:
    that answer is only honest after the credential drop, so _as_game_user redoes it there."""
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return None, None
    if pw.pw_uid == 0:
        # Belt and braces with v_managed_user: uid 0's home is /root, and the credential drop that
        # is supposed to contain this read is a no-op for it.
        return None, None
    home = os.path.realpath(pw.pw_dir)
    abspath = os.path.normpath(os.path.join(home, relpath))
    if abspath != home and not abspath.startswith(home + "/"):
        return None, None
    return pw, abspath


def _drop_to(pw, own_groups=False):
    """Become `pw` irreversibly. True if the drop took, False if anything about it did not.

    Order matters: supplementary groups, then gid, then uid, because setuid first makes the other
    two impossible.

    The checks afterwards are not belt-and-braces. setuid(0) SUCCEEDS when already root, so
    `getuid() != pw.pw_uid` compares 0 against 0 and passes -- a target of uid 0 sailed straight
    through the one guard the read verbs rest on. v_managed_user refuses that NAME; this refuses
    the STATE, so any future path reaching here with uid 0 still cannot act as root.

    `own_groups` picks which supplementary groups the process ends up with, and the two callers
    genuinely want different answers. A read verb wants NONE: it is opening a path chosen by the
    caller, and every group the account happens to be in is reach it does not need. Running a game
    wants the account's OWN groups, which is what `sudo -u` gave it before this verb existed --
    the panel puts game users in a shared group for content directories, and the game process
    inherits these, so dropping them would take mounted content away at runtime.
    """
    if own_groups:
        os.initgroups(pw.pw_name, pw.pw_gid)
    else:
        os.setgroups([])
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)
    if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
        return False
    return not (os.getuid() == 0 or os.geteuid() == 0)


def _as_game_user(pw, abspath, emit):
    """Fork, drop to `pw`, re-resolve `abspath` inside that user's home, then emit(resolved).

    The credential drop is the whole security story of the download verbs, and it is the same one
    do_game_backup_read tells: the read must happen AS THE GAME USER. Reading as root would mean a
    symlink anywhere under that home — planted by a mod, by the game, or by anyone with a shell as
    that user — could hand the panel any file on the box, turning a privilege-reducing change into
    a privilege-increasing one.

    Order matters twice. Supplementary groups, then gid, then uid, because setuid first makes the
    rest impossible. And realpath AFTER the drop, because a check done before it is a check against
    a path nobody is going to open."""
    home = os.path.realpath(pw.pw_dir)
    pid = os.fork()
    if pid == 0:
        try:
            if not _drop_to(pw):
                os._exit(1)          # refuse to read anything if the drop did not take
            resolved = os.path.realpath(abspath)
            if resolved != home and not resolved.startswith(home + "/"):
                os._exit(1)          # a symlink pointing out of the home directory
            emit(resolved)
            sys.stdout.buffer.flush()
        except Exception:
            os._exit(1)
        os._exit(0)
    _pid, status = os.waitpid(pid, 0)
    return 0 if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 else 1


def _emit_file(path, buf):
    """Copy a regular file to `buf` in chunks. Raises on anything that is not a regular file."""
    if not os.path.isfile(path):
        raise ValueError("not a regular file")   # a directory, a device, a socket, a FIFO
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(262144)
            if not chunk:
                break
            buf.write(chunk)


def _emit_dir_tar(path, buf):
    """Write a streaming .tar.gz of the directory `path` to `buf`. Raises if it is not a directory.

    Entries are added ONE AT A TIME so that a single unreadable entry — permissions, a temp file
    that vanished mid-walk, a unix socket the game left behind — skips instead of truncating the
    archive half-way through somebody's download. Symlinks are stored as symlinks (tarfile's
    default), so the archive never carries out the contents of something the walk did not follow.
    """
    if not os.path.isdir(path):
        raise ValueError("not a directory")
    base = os.path.basename(path.rstrip("/")) or "download"
    # "w|gz" is the STREAMING writer: it never seeks, which is what makes a pipe a valid
    # destination. "w:gz" seeks, and would fail on one.
    with tarfile.open(fileobj=buf, mode="w|gz") as tf:
        try:
            tf.add(path, arcname=base, recursive=False)
        except OSError:
            # The directory's OWN entry — its mode and mtime. Losing it costs the archive nothing
            # a caller notices: tar recreates a missing parent when the members below are
            # extracted. Refusing to build the archive because its top entry could not be stat'd
            # would turn a readable folder into a failed download, so carry on to the walk.
            pass
        for root, dirs, files in os.walk(path, onerror=lambda _e: None):
            for name in dirs + files:
                full = os.path.join(root, name)
                try:
                    tf.add(full, arcname=os.path.join(base, os.path.relpath(full, path)),
                           recursive=False)
                except OSError:
                    continue


# ── A game server's own scope ─────────────────────────────────────────────────────────────────
# Every LinuxGSM action the panel starts on its own host forks from the panel. Nothing on the way
# leaves its cgroup: sudo opens no session (Ubuntu's /etc/pam.d/sudo includes
# common-session-noninteractive, which has no pam_systemd), and neither the fork below, setsid nor
# tmux daemonising moves a process. So LinuxGSM's tmux server, the game and the console's `cat`
# all lived in linuxgsm-panel.service's cgroup, and that unit is KillMode=control-group: every
# panel stop, restart, crash and self-update signalled them. On a system install that killed every
# game the panel had started, silently (the journal names none of them); on a per-user install it
# killed those running as the panel's own account and failed with EPERM for the rest. Their memory
# and tasks were charged to the panel, and they ran at the panel's own priority.conf (Nice=10,
# CPUWeight=30, I/O best-effort/6), the low priority meant for the panel alone.
#
# So before the child drops to the game account, root moves it into a transient SCOPE of its own
# under the system manager — beside cron.service in system.slice, where LinuxGSM's own monitor
# cron puts a server it restarts — and sets the priority it should start at. A scope, not a unit
# per server: nothing is written to /etc, and every panel control keeps working as it did. A fresh
# name every time, because a restart's new tmux must not collide with the old scope, which still
# holds the old server until it has stopped (an empty scope is collected).
#
# NOT `systemd-run --scope --uid=`: up to systemd v261 that keeps root's supplementary groups, so
# the game ran with group 0 and without lgsmpanel-games. The drop stays _drop_to's, initgroups and
# all.
#
# Anything that goes wrong here — no systemd as PID 1 (a container), no D-Bus, a refusal — leaves
# the child where it was, which is the behaviour from before this existed. The debug report names
# game processes it finds in the panel's cgroup, so that case is visible rather than silent.
SYSTEMD_BOOTED_DIR = "/run/systemd/system"     # sd_booted()'s own test
SCOPE_SLICE = "system.slice"
SCOPE_WAIT_SECONDS = 3.0
# The nice a game starts at. panel/ops/ssh_manager/_core.py's GAME_PRIORITY_NICE is the panel's
# copy, the value its priority keeper renices games to; a unit check holds the two equal.
GAME_NICE = -1
# LinuxGSM's maintenance actions stop the server and START it again inside them. They run at the
# nice LinuxGSM's own cron gives the same actions, 0 — so an update's download is not lifted above
# every other game — and the keeper takes the restarted game to GAME_NICE, as after a cron restart.
MAINT_NICE = 0
SCOPED_START_ACTIONS = frozenset(("start", "restart", "monitor"))
SCOPED_MAINT_ACTIONS = frozenset(("update", "force-update", "validate", "backup", "mods-update"))
TMUX_SERVER_COMM = "tmux: server"


def _systemd_booted():
    """Say whether systemd is PID 1 here (sd_booted). Without it there is no manager to ask."""
    return os.path.isdir(SYSTEMD_BOOTED_DIR)


def _scope_unit(prefix, label, pid):
    """Return a new scope name, <prefix>-<label>-<pid>-<random>.scope (`label`: a valid account)."""
    return "%s-%s-%d-%s.scope" % (prefix, label, pid, os.urandom(4).hex())


def _cgroup_of(pid):
    """Return the cgroup v2 path of `pid`, or None when it cannot be read."""
    try:
        with open("/proc/%d/cgroup" % pid, encoding="ascii", errors="replace") as fh:
            for line in fh:
                if line.startswith("0::"):
                    return line[3:].strip()
    except OSError:
        return None
    return None


def _cgroup_v2_placed():
    """Say whether this process has a real unified (v2) cgroup path, so a move can be seen.

    Every wait and every "am I in my own unit" test here reads the `0::` line of /proc/<pid>/cgroup.
    A host booted with the legacy hierarchy (systemd.unified_cgroup_hierarchy=0 on 22.04 or 24.04)
    shows only `0::/` there, whatever unit a process is in: a scope would never be seen to land, and
    a job would refuse to run inside its own unit. Such a host keeps the placement from before.
    """
    cg = _cgroup_of(os.getpid())
    return bool(cg) and cg.startswith("/") and cg != "/"


def _scope_argv(unit, pids, description):
    """Return busctl's StartTransientUnit call for a scope holding `pids`.

    Every element is fixed here, a pid this helper read or forked, or a name built from a validated
    account.
    """
    return ([resolve("busctl"), "call", "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
             "org.freedesktop.systemd1.Manager", "StartTransientUnit", "ssa(sv)a(sa(sv))",
             unit, "fail", "4", "PIDs", "au", str(len(pids))] + [str(p) for p in pids]
            + ["Slice", "s", SCOPE_SLICE, "Description", "s", description,
               "CollectMode", "s", "inactive-or-failed", "0"])


def _scope_landed(unit, pids):
    """Say where `pids` are: True once a live one is inside `unit`, None while none is yet.

    False when every one of them is gone: there is nothing left to wait for. Any live pid of the
    group answers, not only the first: an adopted group's first pid can exit while the rest move.
    """
    alive = False
    for pid in pids:
        cg = _cgroup_of(pid)
        if cg is None:
            continue
        if cg.endswith("/" + unit):
            return True
        alive = True
    return None if alive else False


def _start_scope(unit, pids, description):
    """Move `pids` into a new transient scope `unit` under the system manager.

    True once one of them is inside it; False when there is no systemd (or no unified cgroup path
    to watch the move by), the call failed, or the move did not land in time. Nothing has changed
    then, except a move that lands after SCOPE_WAIT_SECONDS.
    """
    if not pids or not _systemd_booted() or not _cgroup_v2_placed():
        return False
    try:
        r = subprocess.run(_scope_argv(unit, pids, description),  # nosec B603 - fixed argv
                           env=_clean_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=15, check=False)
    except (OSError, subprocess.SubprocessError):
        return False
    if r.returncode != 0:
        return False
    # StartTransientUnit returns once the job is QUEUED, and the move happens when it runs
    # (measured: the first read after the call still showed the old cgroup). Waiting for it is
    # what makes "moved before the drop" true.
    deadline = time.monotonic() + SCOPE_WAIT_SECONDS
    while time.monotonic() < deadline:
        landed = _scope_landed(unit, pids)
        if landed is not None:
            return landed
        time.sleep(0.01)
    return False


def _reset_priority(pid, nice):
    """Give `pid` nice `nice` and the I/O class "none".

    A scope cannot carry Nice= or an I/O class (systemd refuses both on a scope), and everything
    the panel's unit starts inherits its Nice=10 and best-effort/6, inside a scope as anywhere.
    """
    try:
        os.setpriority(os.PRIO_PROCESS, pid, nice)
    except OSError:
        # The pid is gone, or this is not root: it keeps what it inherited, as before.
        pass
    try:
        subprocess.run([resolve("ionice"), "-c", "0", "-p", str(pid)],  # nosec B603 - fixed argv
                       env=_clean_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        # No ionice here, or it hung: the I/O class stays the inherited one, as it always was.
        pass


def _fork_placed(child_main, prefix, label, description, nice):
    """Fork; while the child waits, give it its own scope and `nice`; then let it run child_main.

    The child blocks on a pipe until the parent closes its end, so nothing it does as the game
    account happens inside the panel's cgroup. Returns the child's pid. The child ends with
    child_main()'s return value and can never fall back into the caller's code: the finally runs
    for any exception, without catching BaseException to do it.
    """
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        rc = 1
        try:
            os.close(w)
            os.read(r, 1)            # EOF once the parent has placed it, or given up trying
            os.close(r)
            rc = child_main()
        finally:
            os._exit(rc)
    os.close(r)
    try:
        _start_scope(_scope_unit(prefix, label, pid), [pid], description)
        _reset_priority(pid, nice)
    finally:
        os.close(w)
    return pid


def _action_nice(action):
    """Return the nice a LinuxGSM action that can start the server begins at.

    None for any other action, which runs where it always did (a `details` or a `stop` leaves
    nothing running).
    """
    if action in SCOPED_START_ACTIONS:
        return GAME_NICE
    if action in SCOPED_MAINT_ACTIONS:
        return MAINT_NICE
    return None


def _game_env(pw, home):
    """Return the environment a game account's LinuxGSM script or cron job starts with.

    Built, never inherited: the panel's own environment carries its secrets, and LinuxGSM reads a
    good deal.
    """
    return {
        "HOME": home, "USER": pw.pw_name, "LOGNAME": pw.pw_name, "PWD": home,
        "SHELL": "/bin/bash",
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        # Without this LinuxGSM emits `tput: unknown terminal "unknown"` on almost every line.
        "TERM": "xterm",
        "LANG": os.environ.get("LANG", "C.UTF-8"),
    }


# ── Moving what is already in the panel's cgroup out of it ────────────────────────────────────
def _panel_cgroup():
    """Return this process's cgroup when it is the panel's unit, else None.

    sudo opens no session, so the helper runs in the cgroup of whoever called it: the panel. The
    verbs below move processes OUT of that cgroup and nowhere else, so anything else answers None
    and they do nothing.
    """
    cg = _cgroup_of(os.getpid())
    if not cg or not cg.startswith("/") or ".." in cg.split("/"):
        return None
    return cg if cg.endswith("/" + PANEL_UNIT) else None


# Where the unified (v2) hierarchy is mounted: /sys/fs/cgroup itself, or /sys/fs/cgroup/unified on a
# hybrid boot (systemd.unified_cgroup_hierarchy=0 without systemd.legacy_systemd_cgroup_controller,
# which 22.04 and 24.04 still allow). A hybrid host's /proc/<pid>/cgroup has the real `0::` path,
# so everything else here works there; only this read has to look in the other place.
CGROUP_V2_ROOTS = ("/sys/fs/cgroup", "/sys/fs/cgroup/unified")


def _cgroup_pids(cg):
    """Return the pids in cgroup `cg` (a path _panel_cgroup accepted).

    Read from the unified hierarchy, wherever it is mounted (CGROUP_V2_ROOTS). FileNotFoundError
    when it is in none of them: the caller fails out loud rather than finding nothing to move.
    """
    for root in CGROUP_V2_ROOTS:
        try:
            with open(root + cg + "/cgroup.procs", encoding="ascii") as fh:
                return [int(p) for p in fh.read().split()]
        except FileNotFoundError:
            continue
    raise FileNotFoundError("no cgroup.procs for %s under %s" % (cg, " or ".join(CGROUP_V2_ROOTS)))


def _proc_facts(pid):
    """Return (comm, ppid, session id, real uid) of `pid`, or None when /proc cannot say."""
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as fh:
            raw = fh.read()
        comm = raw[raw.index("(") + 1:raw.rindex(")")]
        rest = raw[raw.rindex(")") + 2:].split()
        with open("/proc/%d/status" % pid, encoding="ascii", errors="replace") as fh:
            uids = [line.split()[1] for line in fh if line.startswith("Uid:")]
        return (comm, int(rest[1]), int(rest[3]), int(uids[0])) if uids else None
    except (OSError, ValueError, IndexError):
        return None


def _tmux_root(pid, facts):
    """Return the non-root 'tmux: server' that `pid` is (or descends from) within `facts`."""
    seen = set()
    while pid in facts and pid not in seen:
        seen.add(pid)
        comm, ppid, _sid, uid = facts[pid]
        if comm == TMUX_SERVER_COMM and uid != 0:
            return pid
        pid = ppid
    return None


def _is_game_uid(uid, caller):
    """Say whether `uid` is an account the panel acts as (v_game_account), not root or the caller."""
    if uid in (0, caller):
        return False
    name = _pw_name(uid)
    if not name:
        return False
    try:
        v_game_account(name)
    except ValueError:
        return False
    return True


def _adoption_groups(pids, caller):
    """Return ({group key: [pids]}, {pid: facts}) for what to move out of the panel's cgroup.

    Every tmux server and its descendants, whoever owns them: the panel never runs tmux new-session
    itself, so a tmux server there is a game server (on a same-account install, the panel's own
    uid). And every other process of a game account, one group per account: an update or backup
    that outlived a restart. Never root's: that is sudo and this helper.
    """
    facts = {}
    for pid in pids:
        if pid != os.getpid():
            got = _proc_facts(pid)
            if got is not None:
                facts[pid] = got
    groups = {}
    for pid in sorted(facts):
        uid = facts[pid][3]
        if uid == 0:
            continue
        root = _tmux_root(pid, facts)
        if root is not None:
            groups.setdefault(("tmux", root), []).append(pid)
        elif _is_game_uid(uid, caller):
            groups.setdefault(("account", uid), []).append(pid)
    return groups, facts


ADOPTED_DESCRIPTION = "LinuxGSM processes moved out of linuxgsm-panel.service"


def _adopt_group(cg, owner, pids):
    """Move one group out of the panel's cgroup; return (moved, failed) counts of pids.

    One StartTransientUnit call moves the whole group, and systemd refuses all of it when any one
    pid has exited since cgroup.procs was read: a short-lived child of a running server is enough.
    So a refusal is tried once more with those of the group still in the panel's cgroup. One that
    has gone since is neither moved nor a failure.
    """
    if _start_scope(_scope_unit("lgsm-adopted", owner, pids[0]), pids, ADOPTED_DESCRIPTION):
        return len(pids), 0
    try:
        present = set(_cgroup_pids(cg))
    except OSError:
        return 0, len(pids)
    left = [p for p in pids if p in present]
    if not left:
        return 0, 0
    if _start_scope(_scope_unit("lgsm-adopted", owner, left[0]), left, ADOPTED_DESCRIPTION):
        return len(left), 0
    return 0, len(left)


def do_adopt_game_processes(args, content):
    """Move game-server processes that are ALREADY in the panel's cgroup into scopes of their own.

    The scope in do_lgsm_command keeps every server the panel starts from now on out of the panel's
    cgroup. This is for the ones started before it: a per-user install's servers survived every
    panel restart (the user manager cannot signal another account, and says so in the journal) and
    are still inside the unit, charged to it and signalled at every stop. The panel calls this once
    at start. Zero arguments: the cgroup is this process's own, and only when it is the panel's.

    Memory charged before a move stays with the panel's cgroup until it is freed: cgroup v2 does
    not move a charge. Prints `ADOPTED <moved> <failed>`; exit 1 if any group could not be moved.
    """
    cg = _panel_cgroup()
    if cg is None:
        print("ADOPTED 0 0")
        return 0
    caller = _int_or_none(os.environ.get("SUDO_UID"))
    groups, facts = _adoption_groups(_cgroup_pids(cg), caller)
    moved = failed = 0
    for _key, pids in sorted(groups.items()):
        got = _adopt_group(cg, _pw_name(facts[pids[0]][3]) or "unknown", pids)
        moved, failed = moved + got[0], failed + got[1]
    print("ADOPTED %d %d" % (moved, failed))
    return 1 if failed else 0


def _helper_lineage():
    """Return this process's pid and its ancestors' (sudo, the panel, ...), up to init.

    Read from /proc's ppid chain, which a caller cannot rewrite: the panel's own process is the
    parent of the sudo that ran this helper.
    """
    out, pid = set(), os.getpid()
    while pid > 1 and pid not in out:
        out.add(pid)
        facts = _proc_facts(pid)
        if facts is None:
            break
        pid = facts[1]
    return out


def _terminal_refusal(pid, caller, cg):
    """Return why terminal-scope must not move `pid`, or None when it may.

    `pid` must run as the account that invoked sudo, sit in the panel's own cgroup, lead its own
    session (the panel starts the shell with start_new_session), and be neither this helper nor
    one of its ancestors. That last test is the panel itself: systemd starts every unit's main
    process as a session leader, so the panel passes the other three, and moving it would take the
    panel and everything in its session out of its own unit, at the shell's priority.
    """
    facts = _proc_facts(pid)
    if cg is None or not caller or facts is None or facts[3] != caller or _cgroup_of(pid) != cg:
        return "not a process of the panel's own account in its cgroup"
    if pid in _helper_lineage():
        return "that process is the panel itself, or the sudo that ran this helper"
    if facts[2] != pid:
        return "that process does not lead its own session"
    return None


def _session_members(cg, sid, caller):
    """Return the pids in cgroup `cg` that belong to session `sid` and run as `caller`."""
    members = []
    for p in _cgroup_pids(cg):
        got = _proc_facts(p)
        if got is not None and got[2] == sid and got[3] == caller:
            members.append(p)
    return members


def do_terminal_scope(args, content):
    """Give the panel's local web terminal shell (`pid`) and its session a scope of their own.

    The terminal is the panel account's own login shell, a child of the panel, so it lived in the
    panel's cgroup: a server an operator starts there (`./gmodserver start`, or `sudo -u mcserver
    ./mcserver start`), and any tmux, screen or nohup job, outlived the browser tab but died at the
    next panel restart or self-update. The shell is moved, with whatever its session has already
    forked, and given an SSH login's priority (nice 0, no I/O class) instead of the panel's.

    Bounded to what the caller already owns, and never the panel itself (_terminal_refusal).
    Nothing here starts, signals or reads anything else.
    """
    pid = int(args[0])
    caller = _int_or_none(os.environ.get("SUDO_UID"))
    cg = _panel_cgroup()
    why = _terminal_refusal(pid, caller, cg)
    members = [] if why else _session_members(cg, pid, caller)
    if not why and pid not in members:
        why = "that process does not lead its own session"
    if why:
        sys.stderr.write("refusing: %s\n" % why)
        return 1
    unit = _scope_unit("linuxgsm-panel-terminal", _pw_name(caller) or "panel", pid)
    if not _start_scope(unit, members, "linuxgsm-panel web terminal shell"):
        sys.stderr.write("could not create the terminal's scope\n")
        return 1
    for p in members:
        _reset_priority(p, MAINT_NICE)
    print(unit)
    return 0


# ── Scheduled tasks' "Run now" ────────────────────────────────────────────────────────────────
CRON_RUNNER = ".lgsm-cron/run"


def _cron_job_exec(pw, home, job_id, b64):
    """Run the dropped half of cron-run-now: become the account and exec ITS OWN runner.

    Returns only when that could not be done.
    """
    if not _drop_to(pw, own_groups=True):
        return 1
    runner = os.path.realpath(os.path.join(home, CRON_RUNNER))
    if not runner.startswith(home + "/") or not (os.path.isfile(runner)
                                                 and os.access(runner, os.X_OK)):
        return 1                          # missing, or a symlink out of the home directory
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    if devnull > 2:
        os.close(devnull)                 # dup2 kept the copies; this one would leak
    os.chdir(home)
    # nosec B606 - no shell here: the runner is the account's own script, run AS that account
    # after the drop above, with arguments that passed v_cron_job_id and v_cron_b64.
    os.execve(runner, [runner, job_id, b64], _game_env(pw, home))  # nosec B606
    return 1


def do_cron_run_now(args, content):
    """Run one scheduled task NOW, detached, as its game account, in a scope of its own.

    "Run now" ran `sudo -u <account> … | setsid bash &` from the panel. setsid leaves the session,
    not the cgroup, so a task that starts the server — `monitor`, `restart`, `update` — left it in
    the panel's cgroup, where the next panel restart ended it. This runs the same thing the
    crontab line runs, the account's own ~/.lgsm-cron/run with the job's id and its base64
    command, as that account, in its own scope at cron's priority (nice 0, no I/O class).

    Nothing here interprets the command: the runner decodes and runs it, AS THE ACCOUNT, after the
    drop — the same reach the panel's `sudo -u <account>` grant already gives it, and no more.
    Waits only until the runner has started (a close-on-exec pipe says so); prints
    CRON_RUN_STARTED. The run records its own result in ~/.lgsm-cron/<id>.status.
    """
    user, job_id, b64 = args[0], args[1], args[2]
    pw = pwd.getpwnam(user)
    home = os.path.realpath(pw.pw_dir)
    st_r, st_w = os.pipe()               # close-on-exec: the exec closes the child's end

    def _child():
        os.close(st_r)
        os.setsid()
        try:
            _cron_job_exec(pw, home, job_id, b64)
        finally:
            os.write(st_w, b"x")         # reached only when the runner was NOT exec'd
        return 1

    pid = _fork_placed(_child, "lgsm-cron", user, "Scheduled task for %s, run now from "
                       "linuxgsm-panel" % user, MAINT_NICE)
    os.close(st_w)
    try:
        failed = os.read(st_r, 1)
    finally:
        os.close(st_r)
    if failed:
        os.waitpid(pid, 0)
        sys.stderr.write("the task could not be started as %s (no runnable ~/%s)\n"
                         % (user, CRON_RUNNER))
        return 1
    sys.stdout.write("CRON_RUN_STARTED")
    return 0


def _lgsm_log_path(home, action):
    """Where a long action's output is tee'd, DERIVED rather than passed in.

    panel/routes/_shared.py:_action_log_path builds the same path from the same two values, so the
    panel can tail the file while the action runs. Deriving it on both sides instead of sending it
    means this verb takes no path argument at all -- there is nothing to point somewhere else."""
    return os.path.join(home, ".panel-%s.log" % action)


def _lgsm_child(pw, home, selfname, action, stdin_text, tee):
    """The dropped half of do_lgsm_command: runs the LinuxGSM script, returns its exit status.

    Everything here happens AS THE GAME USER, and not only because LinuxGSM refuses to run as root
    (`[ FAIL ] Do NOT run as root!` -- which it prints while exiting 0, so a command wrongly run as
    root reads as a success). The script, its config and every file it touches sit under a home
    directory the game, its mods and anyone with a shell as that account can write, so running it
    as root would make a symlink there a route to the rest of the box.
    """
    try:
        if not _drop_to(pw, own_groups=True):
            return 1
        script = os.path.realpath(os.path.join(home, selfname))
        if script != home and not script.startswith(home + "/"):
            return 1                      # a symlink pointing out of the home directory
        if not (os.path.isfile(script) and os.access(script, os.X_OK)):
            sys.stderr.write("no executable %s in %s\n" % (selfname, home))
            return 1
        env = _game_env(pw, home)
        out_fd = os.dup(1)
        log_fd = None
        if tee:
            try:
                # O_NOFOLLOW because the destination sits in a directory the game user writes: the
                # final component is the one part of this path that could have become a symlink.
                log_fd = os.open(_lgsm_log_path(home, action),
                                 os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            except OSError:
                tee = False               # no log to tail, but the action still runs
        try:
            # `./<selfname>` from cwd=home, not the resolved path: the command line is then
            # `/bin/bash ./<selfname> <action>`, which is exactly what LinuxGSM's monitor looks for
            # (`pgrep -fcx "/bin/bash ./<selfname> start"`, command_monitor.sh) before it starts or
            # restarts a server itself. Given the absolute path, a */5 monitor tick could not see a
            # start or stop this helper was running and started a second copy beside it -- one that
            # took the console log's pipe from the first. The containment check above still decides
            # WHETHER it runs; it runs as the game account, so the name resolves as that account's.
            proc = subprocess.Popen(          # nosec B603 - argv from an allowlisted action
                ["./" + selfname, action], cwd=home, env=env, stdin=subprocess.PIPE,
                stdout=(log_fd if tee else out_fd), stderr=subprocess.STDOUT)
            proc.communicate(stdin_text.encode())
            rc = proc.returncode
        finally:
            if log_fd is not None:
                os.close(log_fd)
        if tee:
            # Hand the whole output back too, exactly as the shell form's trailing `cat` did: the
            # audit entry and the bot's completion summary read it from here, while the live
            # console tails the file as it fills.
            with open(_lgsm_log_path(home, action), "rb") as fh:
                with os.fdopen(os.dup(out_fd), "wb") as sink:
                    shutil.copyfileobj(fh, sink, 262144)
        return rc if 0 <= rc <= 255 else 1
    except Exception:
        return 1


def do_gameuser_group(args, content):
    """Put a game account in GAME_GROUP, creating the group if it is not there yet.

    This is the other half of the fix `lgsm-command` started. Converting run_as_game_user to a
    verb put SERVER CONTROL back on a narrow-grant host, but it was one of about 45 sites that
    build `sudo -u <game user> bash -c '<shell>'`: the file browser, the GMod content mounts, the
    cron writers and the install flows are the same shape and fail the same way. Rather than
    leave those broken, install.sh grants the panel the right to become an account IN THIS GROUP
    -- never root, which stays reachable only through this helper.

    So membership of this group is a privilege boundary, and the group name is a literal here
    rather than an argument: a caller that could name the group could name one that root is in.
    The ACCOUNT is checked by _enrolment_refusal. It used to be checked only for being able to
    reach root, which is the wrong question for a grant: any other account on the host -- a
    colleague's login, postgres, www-data, nobody -- passed, and the panel could then become it.
    Now it must look like what the panel manages: an ordinary uid, only ordinary groups, and a
    LinuxGSM install (or content tree) in its own home. The two callers still work: an imported
    server has its install by definition, and an account the panel just created was enrolled by
    user-create itself (_enrol_created_account), so the call create_game_user makes right after
    finds it already a member.

    `groupadd -f` succeeds when the group already exists, and `usermod -aG` is append-only, so
    running this for an account that is already a member is a no-op."""
    user = args[0]
    try:
        member = GAME_GROUP in _groups_of(user)
    except Exception:
        member = False
    # A member is not asked for an install again -- it was let in by one of the two routes above,
    # and a content account's tree may not be downloaded yet -- but every other test still applies:
    # an account that has since gained sudo is refused here, as it always was.
    reason = _enrolment_refusal(user, need_install=not member)
    if reason:
        sys.stderr.write("refusing to enrol %s in %s: %s\n" % (user, GAME_GROUP, reason))
        return 1
    return _enrol(user)


def _enrol(user):
    """groupadd -f GAME_GROUP, then usermod -aG it for `user`. The caller has already decided."""
    rc = subprocess.run([resolve("groupadd"), "-f", GAME_GROUP],      # nosec B603 - fixed argv
                        shell=False, capture_output=True, timeout=30).returncode
    if rc != 0:
        sys.stderr.write("could not create group %s\n" % GAME_GROUP)
        return rc
    r = subprocess.run([resolve("usermod"), "-aG", GAME_GROUP, user],  # nosec B603 - fixed argv
                       shell=False, capture_output=True, timeout=30)
    if r.returncode != 0:
        sys.stderr.write(r.stderr.decode("utf-8", "replace")[:400])
    return r.returncode


# Steam's crash handler insists on a crash-dump directory under /tmp that the RUNNING user owns,
# and it only ever tries ten names: /tmp/dumps, then /tmp/dumps01 .. /tmp/dumps09. That is one slot
# per Linux account, taken for good. The panel creates one account per game server, so the ELEVENTH
# Steam game on a host finds the table full and every SteamCMD run there dies:
#
#     src/crashhandler/breakpad_linux.cpp (740) : Fatal Assertion Failed:
#     FATAL: Steam cannot run. Please delete some /tmp/dumps* directories or change their
#     ownership to the local user.
#
# Not just installs — `update` and `validate` on servers that were working yesterday go with it.
# LinuxGSM reports it as "No appmanifest_<appid>.acf found", which is why this took so long to see.
#
# And the panel was the one filling the table: `user-delete` removes the account and leaves the
# directory, so the slot outlives the server. Ten uninstalls wedge a host with nothing running on
# it. Reproduced on the test box, where four of the ten slots belonged to accounts that no longer
# existed; freeing one let a fresh account's SteamCMD log in immediately.
#
# The paths are a FIXED list built here. Nothing a caller sends can name a path, and a slot is
# removed only when its owner is gone or is the account being named — never another live user's.
# Bandit flags a hard-coded /tmp path; these are not OUR temp paths to choose. They are the ten
# names Steam's crash handler hard-codes, so they are a fact to be read, not a location we could
# make unpredictable. Nothing is ever created here: the verb only REMOVES, after an lstat that
# refuses anything but a real directory (so a planted symlink is left alone) and an ownership test
# that keeps every live account's. shutil.rmtree walks by file descriptor on Linux, so there is no
# traversal to race.
STEAM_DUMP_SLOTS = ("/tmp/dumps",) + tuple("/tmp/dumps%02d" % i   # nosec B108 - Steam's own paths
                                           for i in range(1, 10))


def do_steam_dumps_sweep(args, content):
    """Free Steam crash-dump slots: the orphaned ones, plus the named account's own.

    Call it BEFORE deleting the account, while the name still resolves; a slot missed that way is
    picked up as an orphan by the next sweep, so this is self-healing either order.

    Fail-closed on a lookup that does not simply say "no such uid": a passwd database that cannot
    be read must not make every slot look orphaned."""
    user = args[0]
    try:
        own_uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        own_uid = None            # already deleted — the orphan rule below still frees its slot
    freed, held = [], []
    for path in STEAM_DUMP_SLOTS:
        try:
            st = os.lstat(path)
        except OSError:
            continue
        # lstat, and a directory test that a symlink fails: a symlink wearing one of these names is
        # left exactly where it is rather than followed out of /tmp.
        if not stat.S_ISDIR(st.st_mode):
            continue
        if st.st_uid == own_uid:
            drop = True
        else:
            try:
                pwd.getpwuid(st.st_uid)
                drop = False
            except KeyError:
                drop = True       # no account owns it any more
            except Exception:
                drop = False      # could not tell: keep it
        if not drop:
            held.append(path)
            continue
        try:
            shutil.rmtree(path)
            freed.append(path)
        except OSError as exc:
            sys.stderr.write("could not free %s: %s\n" % (path, exc))
    sys.stdout.write("freed=%d held=%d slots=%d\n"
                     % (len(freed), len(held), len(STEAM_DUMP_SLOTS)))
    for path in freed:
        sys.stdout.write("freed %s\n" % path)
    return 0


def do_steamcmd_install(args, content):
    """Install steamcmd, having pre-accepted its Steam licence.

    steamcmd is in multiverse and its licence is a debconf prompt. Unanswered, apt blocks forever
    waiting for input nobody can give -- which on the panel's own host meant the install step of
    a new Steam game hung until its timeout.

    The two preseed lines are FIXED STRINGS written here, not arguments: the only thing a caller
    could vary about them is which question gets which answer, and there is no legitimate reason
    to vary that. debconf-set-selections reads them on stdin, so nothing is interpolated into a
    command either.

    Tries the 32-bit package alongside the 64-bit one first and falls back to 64-bit alone,
    because steamcmd:i386 is unavailable on some releases while steamcmd itself installs fine. A
    box that gets only the 64-bit package still runs SteamCMD.
    """
    preseed = ("steam steam/question select I AGREE\n"
               "steam steam/license note \n")
    r = subprocess.run([resolve("debconf-set-selections")],   # nosec B603 - fixed argv
                       shell=False, input=preseed, text=True, capture_output=True, timeout=60)
    if r.returncode != 0:
        sys.stderr.write("could not preseed the steam licence: %s\n"
                         % r.stderr[:200])
        # Carry on anyway: on a host where the licence was already accepted the install still
        # works, and refusing here would turn a cosmetic failure into no steamcmd at all.
    env = _clean_env(DEBIAN_FRONTEND="noninteractive")
    apt = resolve(APT)
    for pkgs in (["steamcmd", "steamcmd:i386"], ["steamcmd"]):
        r = subprocess.run([apt, "install", "-y"] + pkgs,     # nosec B603 - fixed argv
                           shell=False, env=env, capture_output=True, text=True, timeout=1800)
        sys.stdout.write(r.stdout[-2000:])
        if r.returncode == 0:
            return 0
    sys.stderr.write(r.stderr[-500:])
    return r.returncode


def do_restart_flags(args, content):
    """Print the game users whose ~/.restart-pending flag exists, one per line.

    The panel ran `ls -1d /home/*/.restart-pending`. Globbing /home is fine -- it is 0755 -- but
    the final component is not a wildcard, so the shell STATS each candidate, and that needs
    search permission on the game user's 0750 home. As the panel user every stat is EACCES, the
    glob matches nothing, `|| true` swallows the rc, and the caller receives an empty set: a
    confident "no restarts pending" produced by a read that never happened.

    Walking as root is the one part that needed root. Nothing here is built from an argument --
    the verb takes none.
    """
    try:
        homes = sorted(os.listdir("/home"))
    except OSError as exc:
        sys.stderr.write("cannot list /home: %s\n" % exc)
        return 1
    for name in homes:
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", name):
            continue
        try:
            if os.path.exists(os.path.join("/home", name, ".restart-pending")):
                print(name)
        except OSError:
            # One unreadable home must not lose the others. The caller distinguishes "none
            # pending" from "could not look" by this verb's EXIT CODE, not by empty output.
            continue
    return 0


def do_lgsm_command(args, content):
    """Run ONE LinuxGSM action as a game user, from that user's home directory.

    WHY THIS VERB EXISTS
        run_as_game_user was the last local escalation that did not route through one. It built
        `sudo -u <user> bash -c '<inner>'` and ran it with sudo=False, so the narrow sudoers grant
        install.sh writes -- which permits this helper and nothing else -- never covered it.

        That grant is not an edge case, it is the hardened install: run as root, install.sh creates
        a dedicated non-root `lgsmpanel` and reports `sudo grant: narrow`. On such a host, measured
        on a test box: `sudo -n -u gmodserver id` answered "sudo: a password is required",
        run_as_game_user returned rc=1 with no output, a restart through the API left the pid
        unchanged at 96218 and logged `restart_server success=False`, and /api/server/<id> reported
        "unknown" -- while /api/servers, which port-scans instead, still reported "online", so the
        dashboard looked entirely healthy. Status, start/stop/restart, console, mods and LinuxGSM
        backups were all dead.

    WHAT BOUNDS IT
        The account must be a managed, non-uid-0 user; the script name is an identifier and is
        re-resolved inside that user's home after the drop; the action is one word from
        LGSM_ACTIONS; the answers are bare tokens joined with newlines here. Nothing in this verb
        is assembled into a shell string -- the command is argv and the answers go down a pipe.
    """
    user, selfname, action, answers, tee = args[0], args[1], args[2], args[3], args[4]
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        sys.stderr.write("no such user\n")
        return 1
    home = os.path.realpath(pw.pw_dir)
    stdin_text = "" if answers == "-" else "".join(a + "\n" for a in answers.split(","))

    nice = _action_nice(action)
    if nice is None:
        pid = os.fork()
        if pid == 0:
            os._exit(_lgsm_child(pw, home, selfname, action, stdin_text, tee == "yes"))
    else:
        # An action that can leave the server running gets a scope of its own BEFORE the child
        # drops to the account — see "A game server's own scope" above for why.
        pid = _fork_placed(lambda: _lgsm_child(pw, home, selfname, action, stdin_text, tee == "yes"),
                           "lgsm", user, "LinuxGSM %s (%s), started by linuxgsm-panel"
                           % (selfname, user), nice)
    _pid, status = os.waitpid(pid, 0)
    return os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1


def do_game_file_read(args, content):
    """Stream one file from under a game user's home to stdout, reading it AS THAT USER.

    The download side of the panel's file browser. Unlike the editor's read — text only, size
    capped, whole body in memory — a download has to work for a 4 GB map pack, so the bytes go
    straight to stdout in chunks and the panel streams them on to the browser."""
    user, relpath = args[0], args[1]
    pw, abspath = _game_home_path(user, relpath)
    if pw is None:
        sys.stderr.write("no such user, or path outside the home directory\n")
        return 1

    return _as_game_user(pw, abspath, lambda path: _emit_file(path, sys.stdout.buffer))


def do_game_dir_tar(args, content):
    """Stream a .tar.gz of one directory under a game user's home, built AS THAT USER.

    Python's tarfile rather than the tar binary, for two reasons. The helper resolves only the
    tools its verbs name, and an archiver that takes a path argument and reads whatever it finds
    is a general file-reader by another name. And tarfile can write to a pipe as it walks, so a
    multi-gigabyte addons/ directory streams instead of being staged on disk first.

    See _emit_dir_tar for how the walk tolerates an unreadable entry."""
    user, relpath = args[0], args[1]
    pw, abspath = _game_home_path(user, relpath)
    if pw is None:
        sys.stderr.write("no such user, or path outside the home directory\n")
        return 1

    return _as_game_user(pw, abspath, lambda path: _emit_dir_tar(path, sys.stdout.buffer))


def do_tailscale_install(args, content):
    """Install Tailscale on this host, from Tailscale's own installer.

    The panel ran `sudo bash -c "curl -fsSL https://tailscale.com/install.sh | sh"`. A sudoers rule
    permitting bash IS NOPASSWD:ALL, so that one line was on its own enough to keep the grant wide.

    There is no pipe here, and no shell string. curl writes the script to a root-owned file under
    /run (tmpfs, cleared on reboot, 0600) and sh runs THAT file. The download is still remote code
    executed as root — that is what installing Tailscale is, and pretending otherwise would be
    theatre — but the URL is fixed here, the caller supplies nothing, and no shell is reachable to
    build anything else with."""
    url = "https://tailscale.com/install.sh"
    path = "/run/panel-tailscale-install.sh"
    try:
        os.unlink(path)
    except FileNotFoundError:
        # First install on this host, or /run was cleared by a reboot. Nothing to remove.
        pass
    # O_NOFOLLOW beside O_EXCL: O_EXCL already refuses a symlink at the name, and saying so
    # explicitly keeps the two /run opens in this file (see tailscale-up-login) identical.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            # --proto =https: -L follows redirects, and nothing checks this body before root runs
            # it, so TLS on every hop is all there is. The flag refuses a redirect to http.
            r = subprocess.run([resolve("curl"), "--proto", "=https", "-fsSL", url],  # nosec B603 - fixed argv
                               stdout=fh, stderr=subprocess.PIPE, check=False, timeout=120)
        if r.returncode != 0:
            sys.stderr.write("download failed\n")
            return 1
        r = subprocess.run([resolve("sh_installer"), path],  # nosec B603 - fixed root-owned path
                           check=False, timeout=600,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        sys.stdout.write((r.stdout or b"").decode("utf-8", "replace")[-1500:])
        return r.returncode
    finally:
        try:
            os.unlink(path)
        except OSError:
            # /run is tmpfs and this is 0600 root-owned; a leftover is harmless if unlink fails.
            pass


def _db_repair_target():
    """Return panel.conf's db_path when it is a real file the root-owned repair may run on.

    None (and why, on stderr) otherwise.
    """
    db_path = panel_conf().get("db_path", "")
    if not db_path or not os.path.isabs(db_path) or not os.path.exists(db_path):
        sys.stderr.write("panel.conf has no usable db_path\n")
        return None
    # os.path.exists() above follows symlinks, and db_path names a file inside the panel's own
    # data/ directory — which the panel user owns. A symlink there aimed the root-side repair at
    # any file on the box; db_maintenance refuses it too, and this is the copy on the far side of
    # the privilege boundary, so it does not rely on that one.
    if os.path.islink(db_path):
        sys.stderr.write("refusing: the database path is a symlink\n")
        return None
    if not os.path.isfile(DBM_PATH):
        sys.stderr.write("db_maintenance is not installed root-owned; re-run install.sh as root\n")
        return None
    return db_path


def do_panel_db_repair(args, content):
    """Repair the panel database offline, in a job of its own, and report that it started.

    Zero arguments. The database path comes from panel.conf, which install.sh wrote as root — not
    from the caller, because "run the repair on THIS file" with a caller-chosen path is a way to
    make root clobber any file on the box.

    The job stops the panel, so it must not be IN the panel's cgroup: there, on a system install,
    the stop ended the job too and left the panel down with nothing repaired. See _launch_job."""
    db_path = _db_repair_target()
    if db_path is None:
        return 1
    if _job_launcher_available():
        rc = _launch_job("panel-db-repair", [])
    else:
        rc = _fork_detached(_db_repair_detached, db_path)
    if rc == 0:
        sys.stdout.write("REPAIR_STARTED")
    return rc


def do_os_update_run(args, content):
    """Start the OS update detached and report that it launched.

    Was one `setsid bash -c '<script>' </dev/null >/dev/null 2>&1 &` wrapping a seven-statement
    shell program: truncate, header, export, apt-get update, apt-get full-upgrade with four -o
    flags, autoremove, and a sentinel carrying the exit code. It took no caller input at all — the
    only variables in it were two constants — which is what makes it a zero-argument verb.

    In the panel's cgroup any panel stop — a restart, a self-update, a crash and Restart=always —
    killed apt mid-dpkg on a system install, so it runs as its own transient service (see
    _launch_job). Without systemd, the detached child below, whose function never returns."""
    if _job_launcher_available():
        rc = _launch_job("os-update-run", [])
    else:
        rc = _fork_detached(_os_update_detached)
    if rc == 0:
        sys.stdout.write(OS_UPDATE_STARTED)
    return rc


def _job_db_repair(args):
    db_path = _db_repair_target()
    return 1 if db_path is None else _db_repair_run(db_path)


def _job_restore(args):
    data_dir = _restore_target()
    return 1 if data_dir is None else _restore_run(data_dir)


def _job_self_update(args):
    ref, branch = v_git_ref(args[0]), v_branch_name(args[1])
    target = _self_update_target()
    return 1 if target is None else _self_update_run(target[0], target[1], ref, branch)


# {job: (its body, how many arguments it takes)}. The arguments are re-validated here: this entry
# is reachable as `sudo panel-helper --job ...` too, where it refuses (run_job), but it is checked
# as if it were not.
_JOBS = {
    "panel-db-repair": (_job_db_repair, 0),
    "os-update-run": (lambda args: _os_update_run(), 0),
    "panel-restore": (_job_restore, 0),
    "panel-self-update": (_job_self_update, 2),
}


def run_job(job, args):
    """`panel-helper --job <job> [args]`: one detached job's work, in the FOREGROUND of the
    transient service _launch_job started for it.

    Refused anywhere else. Run from the panel's own cgroup it would be the old bug exactly — the
    job stopping the unit it runs in — so it insists on being inside JOB_UNITS[job]."""
    spec, unit = _JOBS.get(job), JOB_UNITS.get(job)
    if spec is None or unit is None or not _in_own_unit(unit):
        print("panel-helper: --job runs only inside its own transient unit", file=sys.stderr)
        return 2
    body, nargs = spec
    if len(args) != nargs:
        print("panel-helper: --job %s takes %d argument(s)" % (job, nargs), file=sys.stderr)
        return 2
    try:
        return body(args)
    except ValueError as exc:
        print("panel-helper: --job %s: %s" % (job, exc), file=sys.stderr)
        return 2

def do_tailscale_up_login(args, content):
    """Start `tailscale up` detached and print its login URL once it appears.

    Was a shell one-liner: `rm -f /tmp/tsup.log ; nohup tailscale up … > /tmp/tsup.log 2>&1 & for i
    in $(seq 1 20); do u=$(grep -oE '…' /tmp/tsup.log | head -1); [ -n "$u" ] && …; sleep 1; done`.
    A backgrounded process, a redirect, a loop and a grep, all needing a shell.

    The log path is fixed here, so the poll cannot be pointed at a file a caller names, and it
    lives in /run — tmpfs, cleared on reboot, root-owned — rather than /tmp, where any local user
    could have pre-created or replaced it."""
    ssh, routes = args[0], args[1]
    try:
        os.unlink(TS_UP_LOG)
    except FileNotFoundError:
        pass                      # first run on this host, or /run was cleared by a reboot
    argv = ts_up_argv(ssh, routes)
    argv[0] = resolve("tailscale")
    # O_EXCL | O_NOFOLLOW, after the unlink above, as tailscale-install does. This was O_CREAT |
    # O_TRUNC, which opens whatever already sits at the name: a symlink there made root truncate
    # its target and stream `tailscale up` into it, and a FIFO parked this verb on the open. /run
    # is root's, so only root can plant either -- but "nobody else can write there" is a property
    # of the directory, and the open should not depend on it. A name that reappears between the
    # unlink and here fails the open instead of being written through.
    fd = os.open(TS_UP_LOG, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        subprocess.Popen(argv, shell=False,  # nosec B603 - argv from validated pieces
                         stdin=subprocess.DEVNULL, stdout=fd, stderr=subprocess.STDOUT,
                         start_new_session=True)
    finally:
        os.close(fd)
    for _ in range(TS_UP_POLL_SECONDS):
        time.sleep(1)
        try:
            with open(TS_UP_LOG, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        m = TS_LOGIN_RE.search(text)
        if m:
            sys.stdout.write(m.group(0))
            return 0
        if "success" in text.lower():
            sys.stdout.write("ALREADY_CONNECTED")
            return 0
    return 0                      # still waiting; the caller polls status separately


def do_f2b_log_lines(args, content):
    """Print fail2ban Ban/Found lines at or after a cutoff date, across the rotated logs.

    Replaces the read half of a `zcat -f /var/log/fail2ban.log* | awk -v c=<date> '$1 >= c' | grep
    -oE '...'` pipeline that ran as root with the cutoff interpolated into it. The tallying half is
    the caller's job now; this only reads and filters.

    Gzip is handled here rather than by zcat, so the only thing this verb can open is the fail2ban
    log family — the glob is fixed, and nothing about the path comes from the caller."""
    cutoff = args[0]
    # STREAMED, and stopped at a ceiling. This used to append every matching line to a list and
    # write the list at the end: a million-line log (IPv6 rotation defeats per-address bans, and
    # sustaining the events needs no login) cost this root process 448 MB and the panel reading it
    # 656 MB. The caller cannot use a partial tally anyway — the auto-block reconcile RELEASES any
    # block that falls under the threshold — so past the ceiling this says so and exits 3, and the
    # callers read that as "unread", exactly as they read the transport's own cap on remotes.
    sent, sep = 0, ""
    for path in sorted(glob.glob(F2B_LOG_GLOB)):
        try:
            opener = gzip.open if path.endswith(".gz") else open
            with opener(path, "rt", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    # The awk compared field one — the date — as a string, which works because the
                    # format is ISO-ish and fixed-width. Same comparison, same reason.
                    first = line.split(" ", 1)[0]
                    if first >= cutoff and F2B_EVENT_RE.search(line):
                        chunk = sep + line.rstrip("\n")
                        sent += len(chunk.encode("utf-8", "replace"))
                        if sent > F2B_LOG_MAX_BYTES:
                            sys.stderr.write("f2b-log-lines: the log passed %d bytes; truncated, "
                                             "so it must be treated as unread\n" % F2B_LOG_MAX_BYTES)
                            return 3
                        sys.stdout.write(chunk)
                        sep = "\n"
        except FileNotFoundError:
            continue          # a rotated file that vanished mid-read; the others still count
        except OSError as e:
            # Anything ELSE — a permission error, a truncated or corrupt .gz (gzip.BadGzipFile is
            # an OSError) — means this verb did not read what it was asked to read, and a PARTIAL
            # tally is not a smaller true answer: it is a wrong one. The callers
            # (system_ops.fail2ban_top_ips, hosts.remote_fail2ban_top_ips) both answer None on a
            # non-zero rc precisely so an unreadable log cannot be mistaken for a quiet one, and
            # returning 0 here defeated that guard from the inside. This used to be a bare
            # `except OSError: continue`, which is the same defect as an empty read believed as
            # fact — the handler turned "I could not look" into "there was nothing there".
            sys.stderr.write("could not read %s: %s\n" % (path, e))
            return 1
    return 0


def do_content_scan(args, content):
    """Print `HIT|user|game` for every /home user whose serverfiles already hold a wanted game.

    Was a shell loop: `for u in $(ls -1 /home); do d="/home/$u/serverfiles"; [ -d "$d" ] || continue;
    for g in <games>; do [ -d "$d/$g" ] && echo "HIT|$u|$g"; done; done`. Read-only, but it ran as
    root and built its inner list by interpolating the game keys.

    A user name that would not survive v_username is skipped rather than reported: the caller acts
    on what comes back, and a directory in /home whose name is not a name we would ever pass to a
    verb is not a candidate. So is a name no account has, and one whose probe could not be asked
    (see _probe_as): the panel then installs content afresh, which is the answer it had before the
    scan found anything. Each user's games are looked at AS THAT USER, following its own links."""
    try:
        entries = sorted(os.listdir(HOME_ROOT))
    except OSError:
        return 0                      # no /home to scan; no hits, not an error
    hits = []
    for entry in entries:
        try:
            user = v_username(entry)
            paths = [(game, content_path(user, CONTENT_SUBDIR, game)) for game in args]
        except ValueError:
            continue
        found = _probe_as(user, lambda paths=paths: "\n".join(
            game for game, path in paths if os.path.isdir(path)))
        for game in (found or "").splitlines():
            hits.append("HIT|%s|%s" % (user, game))
    sys.stdout.write("\n".join(hits))
    return 0


def _probe_as(user, probe):
    """Run probe() — which returns a str — AS `user`, with that account's own groups, in a forked
    child, and return what it returned. None when no account has that name, when it is root, or
    when the drop did not take: the question could not be asked, which is not the same answer as
    "absent".

    The three content probes used to answer as root with isdir / isfile / access, which FOLLOW
    links, and everything below the home is the content account's to replace: `ln -s /root
    ~/serverfiles` made content-game-present an existence oracle over /root. They were then made to
    refuse a link at every step below the home, which closed that and broke the layout it is
    normal to have — serverfiles moved to a bigger disk and linked back, which the game itself
    reads through. The panel host then said "absent" where a remote (`test -d` through the link)
    said "present", and the panel downloaded the content again, ran auto-install over it, dropped
    it from the update cron, and reported it removed when nothing was.

    Asked as the account, a link is followed with exactly that account's access, so the answer is
    only ever something the account could learn for itself — the oracle is gone, and the link it
    made on purpose still works. Groups are its own (initgroups), as its shell and the game have."""
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        return None
    if pw.pw_uid == 0:
        return None
    rfd, wfd = os.pipe()
    pid = os.fork()
    if pid == 0:
        code = 1
        try:
            os.close(rfd)
            if _drop_to(pw, own_groups=True):
                data = probe().encode("utf-8")
                while data:
                    data = data[os.write(wfd, data):]
                code = 0
        finally:
            # code is 0 only past a complete write; anything raised leaves it 1. os._exit, so the
            # child never unwinds into the helper's own code with the account's identity.
            os._exit(code)
    os.close(wfd)
    chunks = []
    try:
        while True:
            chunk = os.read(rfd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
    finally:
        os.close(rfd)
    _pid, status = os.waitpid(pid, 0)
    if not (os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0):
        return None
    return b"".join(chunks).decode("utf-8", "replace")


def _probe_rc(user, path, test):
    """A probe verb's exit status: 0 when test(path) holds as `user`, 1 when it does not — and
    when there is no such account, which then has nothing — and 2 when the question could not be
    asked. content_present and _installed_content_lgsm_names read 2 as "unknown", not "absent"."""
    try:
        pwd.getpwnam(user)
    except KeyError:
        return 1
    answer = _probe_as(user, lambda: "1" if test(path) else "0")
    if answer is None:
        return 2
    return 0 if answer == "1" else 1


def _is_exec_file(path):
    """`test -x` as the rule was written for it: a regular file with any execute bit, links
    followed (with whatever access the caller has)."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and bool(st.st_mode & 0o111)


def do_content_dir_create(args, content):
    """Create <content user>/serverfiles, owned by that user and PRIVATE to it.

    The shell form created this group-readable (`install -m 750`) whether or not any GMod user had
    been granted access — the group bits were there from the moment the directory existed. They are
    added by content-grant-read now, when access is actually granted, so an ungranted content box
    shares nothing.

    Created with mkdir and then adjusted THROUGH A DESCRIPTOR, because makedirs(exist_ok=True)
    accepts a SYMLINK TO A DIRECTORY — its check is isdir(), which follows — and the chown and
    chmod that came after followed it too. The parent here is /home/<user>, which the user owns,
    so `ln -s /root ~/serverfiles` made root hand /root to that account: write
    /root/.ssh/authorized_keys and the boundary is gone. O_NOFOLLOW refuses the link outright
    rather than resolving it, and a descriptor cannot be swapped for something else afterwards."""
    user = args[0]
    path = home_of(user) + "/" + CONTENT_SUBDIR
    info = pwd.getpwnam(user)
    try:
        os.mkdir(path, stat.S_IRWXU)
    except FileExistsError:
        pass                      # already there; the fchown/fchmod below still normalise it
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fchown(fd, info.pw_uid, info.pw_gid)
        os.fchmod(fd, stat.S_IRWXU)
    finally:
        os.close(fd)
    return 0


def do_content_game_present(args, content):
    """Exit 0 when <content user>/serverfiles/<game> is a directory — `test -d`, without a shell,
    asked as the content account so a link it made is followed with its access only (_probe_as).
    Exit 2 when the account could not be asked."""
    return _probe_rc(args[0], content_path(args[0], CONTENT_SUBDIR, args[1]), os.path.isdir)


def do_content_script_present(args, content):
    """Exit 0 when <content user>/<script> is an executable regular file — `test -x`, which any
    execute bit satisfies — asked as the content account (_probe_as). Exit 2 when it could not be."""
    return _probe_rc(args[0], content_path(args[0], args[1]), _is_exec_file)


def _remove_at(parent_fd, name):
    """Remove `name` — a file, a link, or a whole tree — relative to the directory `parent_fd`,
    never following a symlink at ANY depth. A link is removed as a link.

    Every directory is entered by descriptor with O_NOFOLLOW and checked to be the one just
    lstat'ed, so a name swapped for a link between the two is left alone rather than followed."""
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    try:
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    except OSError:
        return                    # became a link (ELOOP) or vanished: not ours to chase
    try:
        if not os.path.samestat(st, os.fstat(fd)):
            return
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for child in names:
            _remove_at(fd, child)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def _remove_under_home(user, parts):
    """Remove home_of(user)/<parts...> as root, walking EVERY component by descriptor.

    content_path() builds a correct STRING, and that is all it can do: the account owns its home,
    so it can make `serverfiles` or `lgsm` a symlink to anywhere, and shutil.rmtree's own symlink
    guard covers only the LAST component — an intermediate link is followed like any directory.
    `rm -rf ~/serverfiles` + `ln -s /home/<another box>/serverfiles ~/serverfiles` then had root
    delete another tenant's content. Here the home is opened O_NOFOLLOW (its parent, HOME_ROOT, is
    root's), each intermediate directory is opened O_NOFOLLOW relative to the last, and the final
    entry is removed relative to that pinned directory. A link anywhere on the way ends the walk."""
    content_path(user, *parts)            # the same validation, for its refusals
    fd = os.open(home_of(user), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts[:-1]:
            nfd = os.open(v_ident(part), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nfd
        _remove_at(fd, v_ident(parts[-1]))
    finally:
        os.close(fd)


def do_content_game_remove(args, content):
    """Remove one game's content and, if it has one, its LinuxGSM script and config.

    Three removals as root. Every path comes from validated pieces, so the only inputs are a
    validated user name and a validated identifier — a caller cannot name what gets deleted. And
    every one is walked by descriptor (_remove_under_home), because the account whose home this is
    can turn any directory on the way into a symlink."""
    user, game, script = args[0], args[1], args[2]
    targets = [(CONTENT_SUBDIR, game)]
    if script != "-":
        targets.append((script,))
        targets.append(("lgsm", "config-lgsm", script))
    for parts in targets:
        try:
            _remove_under_home(user, parts)
        except OSError:
            # Best effort, as the shell form was: a game whose files are already gone, a link on the
            # way, or a path the filesystem will not let go of must not abort the other removals.
            pass
    return 0


def content_cron_line_re(user):
    """What a /etc/cron.d/lgsm-gmod-content-<user> line may say.

    The same argument as WRITE_CONTENT above, for the second writer of a cron.d file. That table
    guards `write-file`, and this verb is not one of its destinations — the path is per-user, so it
    cannot be a fixed name — which left this the one root-owned write with no content rule at all.
    Its stdin went to /etc/cron.d verbatim, and a cron.d line carries a USER FIELD: one
    `* * * * * root <cmd>` and the caller has root, within the minute, across reboots.

    The panel's body (ssh_manager/gmod.py:_content_update_cron_body) is a fixed shape, so it gets a
    grammar that admits that shape and nothing else. The user field is pinned to the VALIDATED
    ARGUMENT — not to a name in the payload — so the worst a hostile body can ask for is that the
    content account run its own ~/<script>, which is what the account is for."""
    u = re.escape(v_username(user))
    return re.compile(
        r"(?:PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        r"|[0-9]{1,2} [12] \* \* 0 %(u)s /home/%(u)s/[a-z0-9][a-z0-9_-]{0,31}"
        r" update(?:-lgsm)? > /dev/null 2>&1)" % {"u": u})


def do_content_cron_write(args, content):
    """Write the weekly content-update cron for one content user."""
    user = v_username(args[0])
    if not _lines_match(content, content_cron_line_re(user)):
        print("panel-helper: content-cron-write body rejected", file=sys.stderr)
        return 2
    path = "%s-%s" % (CONTENT_CRON_PREFIX, user)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.write(content)
    # Root is the only thing that reads /etc/cron.d. The shell form used 644 because that is what
    # the distro ships, but nothing here needs to be world-readable.
    os.chmod(tmp, stat.S_IRUSR | stat.S_IWUSR)
    os.replace(tmp, path)
    return 0


def do_content_cron_remove(args, content):
    """Drop that cron file — the user has no content games left."""
    try:
        os.unlink("%s-%s" % (CONTENT_CRON_PREFIX, v_username(args[0])))
    except FileNotFoundError:
        pass                      # already absent; the shell form used `rm -f` for the same reason
    return 0


def _emit_mount_cfg(path):
    """_as_game_user's emit for mount.cfg: print the file, or print nothing if there is no file.

    The two cases the caller has to be able to tell apart. A mount.cfg that was never created is a
    real READING — a GMod server that has never mounted anything does not have one — so it emits
    nothing and the verb succeeds. Anything else (a permission error, a read that dies part-way
    through, something that is not a regular file) propagates out of the forked child, so
    _as_game_user returns 1 and gmod_current_mounts reports "unknown" instead of "no mounts".

    os.lstat rather than os.path.isfile, because isfile() answers False for a file it could not
    stat as well as for one that is not there — the very conflation this exists to remove."""
    try:
        os.lstat(path)
    except FileNotFoundError:
        return                    # never created: nothing is mounted, and that IS a measurement
    _emit_file(path, sys.stdout.buffer)


def do_gmod_mount_read(args, content):
    """Print a GMod server's mount.cfg, or nothing. Was `cat <path> 2>/dev/null || true`.

    Read AS THE GAME USER, through the same fork-and-drop the download verbs use. Opening it as
    root was the hole those verbs were written to avoid: every component of the path sits inside
    that account's own home, so `ln -s /etc/shadow ~/serverfiles/garrysmod/cfg/mount.cfg` made
    this verb print /etc/shadow into the panel UI. _as_game_user re-resolves after the drop, so a
    link that leaves the home is refused by the kernel rather than trusted by a check."""
    pw, abspath = _game_home_path(args[0], GMOD_CFG_SUBPATH + "/mount.cfg")
    if pw is None:
        return 0                  # no such user: empty, which the caller reads as "no mounts"
    # Return what the read actually DID, the way do_game_file_read and do_game_dir_tar already do.
    # This used to `return 0` unconditionally. _as_game_user returns 1 for a credential drop that
    # did not take, a resolved path that leaves the home, a child killed by a signal, and any
    # exception out of _emit_file — including one raised part-way through its chunk loop, which
    # leaves TRUNCATED output already flushed on stdout. Every one of those reached
    # gmod_current_mounts as rc 0, which reads it as "this server mounts nothing"; server_files
    # then rewrote mount.cfg to exactly the visible selection and dropped every mount the panel had
    # failed to read, reporting success. gmod_current_mounts is already written for this — it
    # returns None on a non-zero rc — so the only thing missing was the helper telling the truth.
    # An ABSENT mount.cfg is still rc 0: see _emit_mount_cfg, that one really is "no mounts".
    return _as_game_user(pw, abspath, _emit_mount_cfg)


def _chmod_nofollow(path, add, x_if_user=False, dir_fd=None):
    """Add mode bits to `path` WITHOUT following it if it is a symlink.

    os.chmod follows, and Linux has no lchmod, so `chmod -R g+rX` over a tree the content account
    owns was a chmod of whatever anything in it pointed AT. Worse than a stray permission: the walk
    read the mode with lstat and wrote it back with chmod, and a symlink's own mode is 0777 — so
    every link in the tree made its TARGET world-writable. Two of those (/etc/shadow, /etc/cron.d)
    are root.

    O_NOFOLLOW makes the kernel refuse the open instead. O_NONBLOCK so a FIFO cannot park root
    forever, and non-regular, non-directory entries are left alone — a device or socket has no
    content to share and no business being chmod'd by this.

    Nor a regular file with more than one name. O_NOFOLLOW stops a SYMLINK, not a HARD link: a
    hard link is the target itself under a second name, and on a host with
    fs.protected_hardlinks=0 (the kernel's own default; systemd's sysctl defaults turn it on, and a
    host or container that does not boot through them keeps 0) the content account can `ln /etc/shadow
    ~/serverfiles/cstrike/x` and have root add g+r to /etc/shadow itself. The link count is read
    from the descriptor, so the file checked is the file chmod'd. A game's own files are never
    hard-linked in a LinuxGSM tree, so nothing that should be shared is skipped."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        if not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
            return
        if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
            return
        mode = stat.S_IMODE(st.st_mode) | add
        # g+rX: read for everything, execute only where a user already has it. That is what
        # `chmod -R g+rX` means, and why it is not a blanket g+rx.
        if x_if_user and mode & stat.S_IXUSR:
            mode |= stat.S_IXGRP
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


# Mirrors panel/security/privileged.py _NEVER_A_CONTENT_GROUP; root never imports panel code.
NEVER_A_CONTENT_GROUP = frozenset({"root", "wheel", "sudo", "admin", "adm", "shadow", "docker",
                                   "lxd", "disk", "staff",
                                   "incus-admin", "libvirt",
                                   "incus", "microk8s", "snap_microk8s", "lpadmin", "kmem",
                                   "src", "systemd-journal", "syslog", "ssl-cert"})


def do_content_grant_read(args, content):
    """Let a GMod user read a content user's game trees.

    Was `usermod -aG <grp> <gmod>; chmod g+x /home/<content>; chmod -R g+rX …` in one root shell.
    Each step is best-effort here exactly as it was there — a host where one of them fails should
    still get the others."""
    content_user, group, gmod_user, games = args[0], args[1], args[2], args[3:]
    content_pw = pwd.getpwnam(content_user)
    # The group is derived from an account the CALLER names, so the equality check below is
    # self-consistent rather than restrictive: naming root made `actual` "root" and it passed,
    # turning this into `usermod -aG root <user>` — gid 0 on every root:root 0640 file on the box.
    # v_managed_user refuses uid 0 for the two USER slots; this refuses the GROUP, which is
    # validated by shape alone because a host may have a group named after a system account.
    if content_pw.pw_gid == 0:
        print("panel-helper: refusing a gid-0 group", file=sys.stderr)
        return 2
    actual = grp.getgrgid(content_pw.pw_gid).gr_name
    if actual in NEVER_A_CONTENT_GROUP:
        # The same deny set privileged.py keeps (_NEVER_A_CONTENT_GROUP). A content account whose
        # PRIMARY group is one of these would make the grant `usermod -aG sudo|docker|shadow ...`.
        print("panel-helper: refusing to grant membership of that group", file=sys.stderr)
        return 2
    if group != actual:
        # The caller named a group that is not this content user's. Adding the GMod user to an
        # arbitrary group is exactly the kind of thing this boundary exists to refuse.
        print("panel-helper: content-grant-read group does not match the content user",
              file=sys.stderr)
        return 2
    subprocess.run([resolve("usermod"), "-aG", group, gmod_user],  # nosec B603 - validated argv
                   shell=False, capture_output=True, timeout=60)
    # Traversal, outermost first: the home, then serverfiles, then each granted game tree. The
    # shell form skipped serverfiles because content-dir-create had already made it group-readable;
    # it does not any more, so the grant is what opens the path.
    #
    # Every step below works from DESCRIPTORS pinned here. The home's parent is root's, so the home
    # opened O_NOFOLLOW is the real one; serverfiles is opened O_NOFOLLOW relative to it. The walk
    # used to start from the PATH .../serverfiles/<game>: fwalk's own check covers the last
    # component only, so the content account could make ~/serverfiles a symlink to another tenant's
    # directory and have root `chmod g+rX` that tenant's game tree for the content group — the same
    # shape content-game-remove had with rmtree.
    try:
        home_fd = os.open(home_of(content_user), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return 0                  # no home to grant anything in; best-effort, as before
    try:
        try:
            _chmod_nofollow(home_of(content_user), stat.S_IXGRP)
        except OSError:
            pass                  # traversal bit is best-effort, as it was in the shell form
        try:
            sf_fd = os.open(CONTENT_SUBDIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=home_fd)
        except OSError:
            return 0              # no serverfiles, or a link where it should be: nothing to open
        try:
            try:
                _chmod_nofollow(CONTENT_SUBDIR, stat.S_IXGRP, dir_fd=home_fd)
            except OSError:
                # No content subdir to open up (nothing mounted yet) — the grant still stands.
                pass
            for game in games:
                name = v_ident(game)
                # fwalk, not walk, and follow_symlinks=False: it hands each level a DESCRIPTOR and
                # checks that the directory it descended into is the one it stat'd, so a component
                # swapped mid-walk stops the descent instead of redirecting it.
                for _root, dirs, files, rootfd in os.fwalk(
                        name, dir_fd=sf_fd, follow_symlinks=False, onerror=lambda _e: None):
                    for entry in dirs + files:
                        try:
                            _chmod_nofollow(entry, stat.S_IRGRP, x_if_user=True, dir_fd=rootfd)
                        except OSError:
                            continue
                try:
                    _chmod_nofollow(name, stat.S_IRGRP | stat.S_IXGRP, dir_fd=sf_fd)
                except OSError:
                    # This game's tree is missing or not ours to chmod. The shell form was
                    # per-command best-effort for the same reason, and the other granted games
                    # must still be done.
                    pass
        finally:
            os.close(sf_fd)
    finally:
        os.close(home_fd)
    return 0


def do_write_file(args, content):
    """Write `content` to a named root-owned destination.

    Done here in Python rather than by shelling out to tee or `base64 -d > path`, which is what the
    panel used to do: the content was base64'd onto a ROOT COMMAND LINE, and the redirect needed a
    shell. Here the content arrives on this process's stdin and never becomes an argument at all.

    Written to a temporary file in the same directory and renamed, so a reader never sees a
    half-written config — fail2ban and sshd both read these while the panel is editing them."""
    target = args[0]
    path, mode = WRITE_TARGETS[target]
    # Deny by default: a destination with no entry in WRITE_CONTENT is refused outright, so adding
    # one to WRITE_TARGETS forces a decision about its content instead of inheriting "anything".
    if target not in WRITE_CONTENT:
        print("panel-helper: no content rule for %s" % target, file=sys.stderr)
        return 2
    rule = WRITE_CONTENT[target]
    if target == "node-tools-cron":
        content = NODE_TOOLS_CRON_BODY      # helper-owned; stdin is not trusted for a cron file
    elif rule is not None and not _content_ok(content, rule):
        print("panel-helper: content rejected for %s" % target, file=sys.stderr)
        return 2
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".panel-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)          # atomic within the same filesystem
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            # The temp file may already be gone (a partial os.replace, or the directory removed
            # under us). Either way the original error below is the one worth reporting, so a
            # failure to clean up must not replace it.
            pass
        raise
    return 0


