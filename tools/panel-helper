def panel_conf():
    """The install's fixed facts: {"db_path": ...}. Missing or unreadable is an empty dict, and the
    verbs that need it fail cleanly rather than guessing at a path."""
    out = {}
    try:
        with open(PANEL_CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    except OSError:
        # No panel.conf, or it is unreadable. Deliberately not fatal HERE: the callers below decide
        # what a missing key means for them, and every one of them refuses rather than guessing at a
        # path. Raising instead would turn "not installed yet" into a crash on an unrelated verb.
        pass
    return out


