#!/usr/bin/env python3
"""The panel's privileged helper — the only thing on this host that should be granted sudo.

WHY THIS EXISTS
    The panel escalates local work as `sudo bash -c '<command>'`. A sudoers rule that permits
    /bin/bash is exactly as powerful as NOPASSWD:ALL, so the grant could not be narrowed by editing
    sudoers: any list containing bash reads as scoped while granting identical power. The only way
    to narrow it for real is to stop passing shell strings across the privilege boundary.

    This script is that boundary. It takes a VERB and already-separated ARGUMENTS on argv, checks
    every argument against a pattern fixed here, and execs a fixed argument vector. There is no
    shell anywhere in it: no shell=True, no os.system, no string interpolation into a command. A
    caller cannot ask it to run something that is not in the table below, and cannot smuggle a
    second command through an argument, because arguments never become shell text.

INTEGRITY
    This file must be owned by root and NOT writable by the panel user — otherwise the panel could
    rewrite the table and the boundary is theatre. install.sh copies it to
    /usr/local/lib/linuxgsm-panel/panel-helper as root:root 0755, deliberately OUTSIDE the panel's
    git checkout: the checkout is owned by the panel user and rewritten by `git pull` on every
    self-update, so a helper living there would be panel-writable by design.

    A consequence worth stating plainly: updating this helper requires root. The panel's own
    self-update cannot do it. When the verb table changes, the operator re-runs install.sh as root.

STATUS
    Conversion is in progress. Until EVERY privileged call site in the panel routes through a verb
    here, /etc/sudoers.d/linuxgsm-panel still grants NOPASSWD:ALL and this helper reduces nothing —
    a boundary with a hole in it is not a boundary. See SECURITY.md.

USAGE
    panel-helper <verb> [arg ...]      exit 2 = unknown verb / bad argument, else the tool's own rc
    panel-helper --list-verbs          print the verb table (used by the panel's tests)
"""
import ipaddress
import os
import re
import subprocess  # nosec B404 - fixed argv, shell=False, no untrusted text reaches a shell
import sys

# Tool name -> the absolute paths it is allowed to be. PATH is never consulted: sudo sanitises it,
# but "never" is easier to audit than "sanitised". A name that is not a key here cannot be run.
TOOLS = {
    "ufw": ("/usr/sbin/ufw", "/sbin/ufw", "/usr/bin/ufw"),
    "fail2ban-client": ("/usr/bin/fail2ban-client", "/bin/fail2ban-client"),
    "systemctl": ("/usr/bin/systemctl", "/bin/systemctl"),
    "apt-get": ("/usr/bin/apt-get",),
    "dpkg": ("/usr/bin/dpkg",),
    "add-apt-repository": ("/usr/bin/add-apt-repository",),
    "pgrep": ("/usr/bin/pgrep", "/bin/pgrep"),
    "fuser": ("/usr/bin/fuser", "/bin/fuser"),
    "reboot": ("/usr/sbin/reboot", "/sbin/reboot"),
}
UFW = "ufw"
F2B = "fail2ban-client"
SYSTEMCTL = "systemctl"

# The services the panel is allowed to touch, named exhaustively. Everything the panel actually
# does is in this list, so a unit-name PATTERN would only buy the ability to control units nobody
# asked it to control. sshd is here because the ssh unit is called ssh on Debian/Ubuntu and sshd
# elsewhere, and the panel tries both.
UNITS = ("ssh", "sshd", "fail2ban", "whoopsie", "cups", "modemmanager")

APT = "apt-get"

# dpkg's conflict answers, fixed here rather than passed in: keep any config file the operator has
# edited, and take the package default for one they have not. An unattended upgrade that clobbered
# a hand-edited sshd_config would be a very expensive surprise.
APT_CONFOLD = ["-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]

# Verbs that must run with DEBIAN_FRONTEND=noninteractive, so apt never blocks on a prompt nobody
# can answer. Set as an environment variable on the child rather than as a `VAR=value cmd` prefix,
# which would need a shell.
NONINTERACTIVE = {"apt-full-upgrade", "apt-upgrade", "apt-install"}

# The only extra apt sources the panel adds.
REPOS = ("universe",)


def resolve(prog):
    """The absolute path for a tool name, or FileNotFoundError. Only names in TOOLS resolve."""
    for cand in TOOLS.get(prog, ()):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    raise FileNotFoundError(prog)

# ── Argument validators ───────────────────────────────────────────────────────────────────────
# Each returns the value to place in argv, or raises ValueError. They are deliberately strict:
# a rejected argument is a bug report, not a fallback to something looser.


def v_portspec(s):
    """A UFW port specification: 27015, 27015/tcp, 27000:27100, 27000:27100/udp."""
    m = re.fullmatch(r"(\d{1,5})(?::(\d{1,5}))?(?:/(tcp|udp))?", s)
    if not m:
        raise ValueError("not a port specification")
    for p in (m.group(1), m.group(2)):
        if p is not None and not (1 <= int(p) <= 65535):
            raise ValueError("port out of range")
    if m.group(2) is not None and int(m.group(2)) < int(m.group(1)):
        raise ValueError("reversed port range")
    return s


def v_iface(s):
    """A network interface name. Linux caps these at 15 characters (IFNAMSIZ)."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", s):
        raise ValueError("not an interface name")
    return s


def v_cidr(s):
    """An IPv4/IPv6 address or network. Parsed, not pattern-matched, so 'any' and
    '1.2.3.4 || rm -rf /' are both rejected for the same reason: they are not addresses."""
    try:
        ipaddress.ip_network(s, strict=False)
    except ValueError:
        raise ValueError("not an IP address or network")
    return s


def v_comment(s):
    """A UFW rule comment. The panel already strips these to this charset before storing them;
    re-checking here is the point — the helper trusts nothing it is told."""
    if not re.fullmatch(r"[A-Za-z0-9 _.-]{0,60}", s):
        raise ValueError("comment has characters outside [A-Za-z0-9 _.-] or is over 60 chars")
    return s


def v_jail(s):
    """A fail2ban jail name."""
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", s):
        raise ValueError("not a jail name")
    return s


def v_package(s):
    """A Debian package name, optionally with an architecture qualifier (gcc:i386)."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]{0,60}(?::[a-z0-9]{1,10})?", s):
        raise ValueError("not a package name")
    return s


class Rest:
    """A validator that consumes every REMAINING argument — apt-install takes a package list, and
    the count is not known here. Each element is still checked individually."""

    def __init__(self, check, minimum=1, maximum=64):
        self.check, self.minimum, self.maximum = check, minimum, maximum


def v_rulenum(s):
    if not re.fullmatch(r"[1-9]\d{0,3}", s):
        raise ValueError("not a rule number")
    return s


def v_choice(*allowed):
    def check(s):
        if s not in allowed:
            raise ValueError("expected one of: " + ", ".join(allowed))
        return s
    return check


# ── The verb table ────────────────────────────────────────────────────────────────────────────
# verb -> (validators, build(args) -> argv, stdin or None)
#
# `build` returns a complete argument vector. Every element is either a literal written here or a
# value that has passed the matching validator; nothing else can reach it.

VERBS = {
    "ufw-status": (
        [v_choice("plain", "numbered", "verbose")],
        lambda a: [UFW, "status"] if a[0] == "plain" else [UFW, "status", a[0]],
        None),
    "ufw-enable": (
        [],
        lambda a: [UFW, "--force", "enable"],
        None),
    "ufw-default": (
        [v_choice("allow", "deny", "reject"), v_choice("incoming", "outgoing")],
        lambda a: [UFW, "default", a[0], a[1]],
        None),
    "ufw-allow-port": (
        [v_portspec, v_comment],
        lambda a: [UFW, "allow", a[0]] + (["comment", a[1]] if a[1] else []),
        None),
    "ufw-allow-proto-port": (
        [v_choice("tcp", "udp"), v_portspec, v_comment],
        lambda a: [UFW, "allow", "proto", a[0], "to", "any", "port", a[1]]
        + (["comment", a[2]] if a[2] else []),
        None),
    "ufw-delete-allow-proto-port": (
        [v_choice("tcp", "udp"), v_portspec],
        lambda a: [UFW, "delete", "allow", "proto", a[0], "to", "any", "port", a[1]],
        None),
    # ── fail2ban ──
    "f2b-status": ([], lambda a: [F2B, "status"], None),
    "f2b-status-jail": ([v_jail], lambda a: [F2B, "status", a[0]], None),
    "f2b-unban": ([v_jail, v_cidr], lambda a: [F2B, "set", a[0], "unbanip", a[1]], None),
    "f2b-reload": ([], lambda a: [F2B, "reload"], None),

    # ── systemd units, from a fixed list ──
    "service-restart": ([v_choice(*UNITS)], lambda a: [SYSTEMCTL, "restart", a[0]], None),
    "service-reload": ([v_choice(*UNITS)], lambda a: [SYSTEMCTL, "reload", a[0]], None),
    "service-enable-now": ([v_choice(*UNITS)], lambda a: [SYSTEMCTL, "enable", "--now", a[0]], None),
    "service-disable-now": ([v_choice(*UNITS)],
                            lambda a: [SYSTEMCTL, "disable", "--now", a[0]], None),

    # ── apt / dpkg ──
    "apt-update": ([], lambda a: [APT, "update", "-qq"], None),
    # Two upgrade shapes, because the panel really does want two. "phased" includes Ubuntu's
    # phased rollouts so an explicit "install updates" applies everything the Check list showed;
    # "standard" is apt's default set, used when bootstrapping a host.
    "apt-full-upgrade": (
        [v_choice("phased", "standard")],
        lambda a: [APT, "full-upgrade", "-y"]
        + (["-o", "APT::Get::Always-Include-Phased-Updates=true"] if a[0] == "phased" else [])
        + APT_CONFOLD,
        None),
    "apt-upgrade": ([], lambda a: [APT, "upgrade", "-y"] + APT_CONFOLD, None),
    "apt-autoremove": ([], lambda a: [APT, "autoremove", "-y"], None),
    "apt-install": ([Rest(v_package)], lambda a: [APT, "install", "-y"] + a, None),
    "apt-add-repo": ([v_choice(*REPOS)], lambda a: ["add-apt-repository", "-y", a[0]], None),
    "dpkg-add-arch": ([v_choice("i386")], lambda a: ["dpkg", "--add-architecture", a[0]], None),

    # Two process probes with FIXED patterns. pgrep takes a regex, so the pattern is written here
    # and never comes from a caller.
    "apt-any-running": ([], lambda a: ["pgrep", "-f", "apt-get"], None),
    "apt-upgrade-running": (
        [], lambda a: ["pgrep", "-f", "apt-get (upgrade|dist-upgrade|full-upgrade)"], None),
    "dpkg-lock-held": ([], lambda a: ["fuser", "/var/lib/dpkg/lock-frontend"], None),

    "reboot": ([], lambda a: ["reboot"], None),

    "ufw-delete-limit-port": (
        [v_portspec],
        lambda a: [UFW, "delete", "limit", a[0]],
        None),
    # Only OpenSSH. The panel deletes exactly this one UFW application profile, so the validator is
    # the literal rather than an app-name pattern — the narrowest thing that still works.
    "ufw-delete-allow-app": (
        [v_choice("OpenSSH")],
        lambda a: [UFW, "delete", "allow", a[0]],
        None),
    "ufw-limit-port": (
        [v_portspec],
        lambda a: [UFW, "limit", a[0]],
        None),
    "ufw-allow-iface": (
        [v_iface],
        lambda a: [UFW, "allow", "in", "on", a[0]],
        None),
    "ufw-delete-allow-port": (
        [v_portspec],
        lambda a: [UFW, "delete", "allow", a[0]],
        None),
    "ufw-deny-ip": (
        [v_cidr, v_comment],
        lambda a: [UFW, "insert", "1", "deny", "from", a[0]] + (["comment", a[1]] if a[1] else []),
        None),
    "ufw-delete-deny-ip": (
        [v_cidr],
        lambda a: [UFW, "delete", "deny", "from", a[0]],
        None),
    # `ufw delete <n>` asks "Proceed (y|n)?". The panel used to answer it with `yes | ufw delete n`,
    # which needs a shell for the pipe. Feeding stdin directly removes the pipe and the shell.
    "ufw-delete-num": (
        [v_rulenum],
        lambda a: [UFW, "delete", a[0]],
        "y\n"),
}


def validate(verb, args):
    """The checked arguments for `verb`, or ValueError. Shared by main() and by the panel's unit
    test, which compares this table's argv against privileged.py's for every verb — the two copies
    exist so that root never imports panel code, and only a test keeps them honest."""
    validators = VERBS[verb][0]
    args = list(args)
    rest = validators[-1] if validators and isinstance(validators[-1], Rest) else None
    fixed = validators[:-1] if rest else validators
    if rest is None:
        if len(args) != len(fixed):
            raise ValueError("%s takes %d argument(s), got %d" % (verb, len(fixed), len(args)))
        checks = list(fixed)
    else:
        low, high = len(fixed) + rest.minimum, len(fixed) + rest.maximum
        if not low <= len(args) <= high:
            raise ValueError("%s takes %d..%d argument(s), got %d" % (verb, low, high, len(args)))
        checks = list(fixed) + [rest.check] * (len(args) - len(fixed))
    out = []
    for i, (value, check) in enumerate(zip(args, checks)):
        try:
            out.append(check(value))
        except ValueError as e:
            raise ValueError("%s argument %d rejected (%s)" % (verb, i + 1, e))
    return out


def main(argv):
    if len(argv) >= 2 and argv[1] == "--list-verbs":
        for verb in sorted(VERBS):
            print("%s\t%d" % (verb, len(VERBS[verb][0])))
        return 0
    if len(argv) < 2:
        print("panel-helper: a verb is required", file=sys.stderr)
        return 2
    verb, args = argv[1], argv[2:]
    spec = VERBS.get(verb)
    if spec is None:
        print("panel-helper: unknown verb %r" % verb, file=sys.stderr)
        return 2
    _, build, stdin_text = spec
    try:
        checked = validate(verb, args)
    except ValueError as e:
        # The rejected value is NOT echoed back: this runs as root and its stderr is surfaced in
        # the panel UI, so repeating attacker-controlled text here would be a reflection.
        print("panel-helper: %s" % e, file=sys.stderr)
        return 2
    argv = build(checked)
    env = dict(os.environ)
    if verb in NONINTERACTIVE:
        env["DEBIAN_FRONTEND"] = "noninteractive"
    try:
        argv[0] = resolve(argv[0])
        p = subprocess.run(argv, shell=False,  # nosec B603 - argv is built from literals
                           input=stdin_text, env=env, capture_output=True, text=True,
                           timeout=1800)
    except FileNotFoundError:
        print("panel-helper: the tool for %s is not installed" % verb, file=sys.stderr)
        return 127
    except subprocess.TimeoutExpired:
        print("panel-helper: %s timed out" % verb, file=sys.stderr)
        return 124
    sys.stdout.write(p.stdout or "")
    sys.stderr.write(p.stderr or "")
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv))
