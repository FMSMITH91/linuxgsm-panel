# fail2ban's config files are declarative and their content is genuinely open-ended — ignoreip
# lists, ports, log paths, filter regexes — so a grammar over the whole file would break real
# configs for no gain. Two KEYS are the exception, because they are the ones that decide what
# fail2ban RUNS, and it runs it as root on reload:
#
#   action / banaction / action_*   names a definition in action.d/, whose actionstart and
#                                   actionban are shell commands. fail2ban resolves the name by
#                                   joining it onto "action.d", so a value carrying a path
#                                   separator may reach a file outside that directory — and
#                                   filter.d/linuxgsm-panel.conf IS a write target, so a caller
#                                   could write its own actionban there and then point a jail at
#                                   it. I could not verify the traversal (no fail2ban here to test
#                                   against), so this is a guard against a maybe rather than a
#                                   proven hole — but the panel never writes any of these keys, so
#                                   refusing a separator in them costs nothing at all.
#   filter                          same shape, one directory over.
#
# A legitimate value for either is a bare name. Everything else in these files stays unconstrained.
# Every action* spelling, not just "action": actionban, actionstart, actionstop, actionunban and
# actioncheck are the lines that hold the COMMAND, and banaction/banactionallports name one.
_RE_F2B_RUNNABLE_KEY = re.compile(r"(?:ban)?action[a-z0-9_]*|filter|chain", re.IGNORECASE)
_RE_F2B_PLAIN_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")


def _fail2ban_line_ok(line):
    """A fail2ban config line the panel may write. See the note above for the two keys that are
    constrained and why every other key is not."""
    if "=" not in line:
        return True                       # a [section] header, or a bare flag
    key, value = line.split("=", 1)
    if not _RE_F2B_RUNNABLE_KEY.fullmatch(key.strip()):
        return True
    return bool(_RE_F2B_PLAIN_NAME.fullmatch(value.strip()))


_RE_FAIL2BAN_OPEN = _fail2ban_line_ok


def _lines_match(content, pattern):
    """Every non-blank, non-comment line is accepted by `pattern`.

    `pattern` is a compiled regex (matched in FULL) or a callable taking the line — the fail2ban
    rule needs the second form, because only two of its keys are constrained."""
    check = pattern if callable(pattern) and not hasattr(pattern, "fullmatch") \
        else pattern.fullmatch
    for line in (content or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if not check(line):
            return False
    return True


