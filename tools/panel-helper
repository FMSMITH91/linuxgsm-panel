def do_sshd_backup(args, content):
    """Snapshot the panel's sshd drop-in, if it exists. A missing file is success, not an error —
    the restore below treats "no snapshot" as "there was no drop-in before us"."""
    if os.path.isfile(SSHD_DROPIN):
        # copy2, not copyfile: it carries the mode across, so the restore below can be an exact
        # inverse. The snapshot is no more exposed than the file it copies, by construction.
        shutil.copy2(SSHD_DROPIN, SSHD_DROPIN_BAK)
    return 0


def do_sshd_restore(args, content):
    """Put the snapshot back, or remove the drop-in if there was no snapshot.

    This is the rollback for a port change that did not work, so it has to be the exact inverse of
    do_sshd_backup: a host that had no drop-in before ends with no drop-in, not with an empty one."""
    if os.path.isfile(SSHD_DROPIN_BAK):
        # os.replace moves the inode, so the snapshot's mode comes with it. There was a chmod 0o644
        # here, which was wrong twice over: it widened the file to world-readable, and it IMPOSED a
        # mode rather than restoring the one the host had. A rollback that changes permissions is
        # not a rollback.
        os.replace(SSHD_DROPIN_BAK, SSHD_DROPIN)
    else:
        try:
            os.unlink(SSHD_DROPIN)
        except FileNotFoundError:
            # Nothing to undo. The caller reverts unconditionally on any failure, including ones
            # that happen before the drop-in is written, so this is a normal path.
            pass
    return 0


def do_sshd_discard_backup(args, content):
    """Drop the snapshot after a successful change."""
    try:
        os.unlink(SSHD_DROPIN_BAK)
    except FileNotFoundError:
        pass          # there was no drop-in to snapshot; nothing to clean up
    return 0


def do_sshd_socket_backup(args, content):
    """Snapshot the panel's ssh.socket drop-in, if it exists. Exact mirror of do_sshd_backup."""
    if os.path.isfile(SSHD_SOCKET_DROPIN):
        shutil.copy2(SSHD_SOCKET_DROPIN, SSHD_SOCKET_DROPIN_BAK)
    return 0


def do_sshd_socket_restore(args, content):
    """Put the socket snapshot back, or remove the drop-in if there was no snapshot.

    The rollback for a port change on a socket-activated host, and the exact inverse of
    do_sshd_socket_backup: a host that had no drop-in before ends with none. systemd still needs a
    daemon-reload after this; the caller does that, because a reload is not the helper's to decide."""
    if os.path.isfile(SSHD_SOCKET_DROPIN_BAK):
        os.replace(SSHD_SOCKET_DROPIN_BAK, SSHD_SOCKET_DROPIN)
    else:
        try:
            os.unlink(SSHD_SOCKET_DROPIN)
        except FileNotFoundError:
            pass          # reverted before the drop-in was written; a normal path
    return 0


def do_sshd_socket_discard(args, content):
    """Drop the socket snapshot after a successful change."""
    try:
        os.unlink(SSHD_SOCKET_DROPIN_BAK)
    except FileNotFoundError:
        pass          # there was no drop-in to snapshot; nothing to clean up
    return 0


def do_f2b_sshd_ports(args, content):
    r"""Point fail2ban's [sshd] jail at a new port list.

    Was an in-place `sed -i '/^\[sshd\]/,/^\[/{s/^port *=.*/port = …/}'` running as root. The
    same edit in Python: walk jail.local, and inside the [sshd] section only, replace the port line.
    No jail.local, or no [sshd] section, means nothing to do — fail2ban keeps its default."""
    ports = args[0]
    path = F2B_JAIL_LOCAL
    if not os.path.isfile(path):
        return 0
    with open(path) as fh:
        lines = fh.readlines()
    out, in_sshd, changed = [], False, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            in_sshd = stripped == "[sshd]"
        elif in_sshd and re.match(r"\s*port\s*=", line):
            line = "port = %s\n" % ports
            changed = True
        out.append(line)
    if changed:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".panel-", suffix=".tmp")
        with os.fdopen(fd, "w") as fh:
            fh.writelines(out)
        # Keep jail.local's existing mode instead of imposing 0o644 — this edits a file the
        # distro (or the operator) created, and rewriting its permissions is not part of the edit.
        os.chmod(tmp, stat.S_IMODE(os.stat(path).st_mode))
        os.replace(tmp, path)
    return 0


def do_reboot_delayed(args, content):
    """Reboot a couple of seconds from now, so the command that asked for it can return first.

    Was `( sleep 2 ; reboot ) >/dev/null 2>&1 & echo scheduled` — a subshell, a background job and
    a redirect, all needing a shell. The double fork does the same thing: the grandchild is
    re-parented to init, survives this process exiting, waits, and execs reboot. No shell, and the
    only thing it can exec is the reboot binary this table resolves."""
    pid = os.fork()
    if pid == 0:                       # child
        os.setsid()                    # detach from the session, so our exit cannot kill it
        if os.fork() == 0:             # grandchild — re-parented to init
            # finally, not except: os.execv does not return on success, so this only runs when the
            # exec failed. It guarantees the grandchild can never fall back into the caller's code
            # — for any exception, without catching BaseException to do it.
            try:
                devnull = os.open(os.devnull, os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(devnull, fd)
                if devnull > 2:
                    os.close(devnull)        # dup2 kept the copies; this one would leak
                time.sleep(REBOOT_DELAY_SECONDS)
                # nosec B606 - start_process_with_no_shell. No shell is exactly the point:
                # resolve() returns an absolute path from the fixed TOOLS table or raises,
                # "reboot" is a literal, and argv is a literal list. Nothing here is
                # user-influenced. Bandit flags the exec family on sight; the shell-using
                # members of it (B602/B604/B607) are what would matter, and this is not one.
                os.execv(resolve("reboot"), ["reboot"])  # nosec B606
            finally:
                os._exit(1)
        os._exit(0)
    os.waitpid(pid, 0)                 # reap the middle process immediately
    return 0


REBOOT_DELAY_SECONDS = 2


def _sshd_includes_dropin_dir():
    """Whether sshd_config pulls in /etc/ssh/sshd_config.d at all.

    Debian 11 and the RHEL family do not ship the Include line, and on those hosts a file in that
    directory is inert — so the drop-in is written only where it is actually read, and the
    sshd_config edit below is what hardens everywhere else."""
    try:
        with open(SSHD_CONFIG, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if re.match(r"^\s*Include\s+\S*sshd_config\.d", line, re.IGNORECASE):
                    return True
    except OSError:
        return False
    return False


def _write_sshd_hardening_dropin(key, value):
    """Set one directive in the panel's hardening drop-in, leaving the others it already holds.

    Read-modify-write rather than an append, so setting PasswordAuthentication twice does not
    leave two lines whose second one is dead. Only keys from SSHD_DIRECTIVES survive the rewrite:
    this file is root-owned sshd config, and it should never be able to accumulate anything the
    verb is not allowed to set in the first place."""
    held = {}
    try:
        with open(SSHD_HARDENING_DROPIN, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] in SSHD_DIRECTIVES:
                    held[parts[0]] = parts[1].strip()
    except OSError:
        pass                              # not there yet, or unreadable: start from what we know
    held[key] = value
    body = SSHD_HARDENING_HEADER + "".join("%s %s\n" % (k, held[k]) for k in sorted(held))
    d = os.path.dirname(SSHD_HARDENING_DROPIN)
    os.makedirs(d, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.write(body)
    # 0600, not the 0644 the distro's own drop-ins carry. Nothing unprivileged reads this file:
    # sshd parses it as root, and the panel only ever reaches it back through this helper, which
    # is root too. There is no secret in it — just directive names and values — so this is not a
    # disclosure fix; it is that a root-owned file with no non-root reader has no reason to be
    # world-readable, which is what CodeQL's overly-permissive-mask rule is for.
    os.chmod(tmp, 0o600)
    os.replace(tmp, SSHD_HARDENING_DROPIN)


def _sshd_effective_value(key):
    """What `sshd -T` says `key` is actually set to, or None when that could not be read.

    None is NOT "unset": sshd -T prints every directive with its effective value, so a missing
    line means the read did not happen — sshd absent, the config failing to parse, the binary
    refusing to run. A failed read is not a fact, so the caller reports "could not verify"
    separately rather than reporting the directive as wrong."""
    try:
        argv = [resolve("sshd"), "-T"]
    except FileNotFoundError:
        return None
    try:
        r = subprocess.run(argv, shell=False, capture_output=True, timeout=30)  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    low = key.lower()
    for line in r.stdout.decode("utf-8", "replace").splitlines():
        parts = line.strip().split(None, 1)
        if parts and parts[0].lower() == low:
            return parts[1].strip() if len(parts) > 1 else ""
    return None


def do_sshd_set_directive(args, content):
    """Set one sshd_config directive to one of its allowed values, and CHECK that it took.

    Was `sed -i 's/^#\\?<Key>.*/<Key> <value>/' /etc/ssh/sshd_config` — a regex substitution
    running as root, once per directive. Same edit here: replace the first line that sets the
    directive (commented or not), or append it if there is none. Both the key and the value come
    from SSHD_DIRECTIVES, so this cannot write a directive the panel does not harden.

    Editing sshd_config was not enough, and the verb could not tell. sshd uses the FIRST value it
    obtains for a keyword, Ubuntu's sshd_config Includes sshd_config.d before its own body, and
    cloud images put PasswordAuthentication in 50-cloud-init.conf — so on a stock Ubuntu VPS the
    panel wrote `PasswordAuthentication no`, `sshd -t` passed, sshd restarted, the bootstrap log
    said "Hardening SSH configuration", and password SSH stayed open to the internet. The write
    always succeeded, so rc 0 meant "written", never "in effect". Now the value also goes into a
    00- drop-in that sorts ahead of the distro's, and `sshd -T` is read back afterwards.

    Exit codes, because "not applied" and "could not check" are different answers:
      0  written, and sshd -T confirms the requested value
      4  written, but sshd -T still reports something else — another file wins
      5  written, but sshd -T could not be read, so nothing here is verified
    """
    key, value = args[0], args[1]
    try:
        with open(SSHD_CONFIG, encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return 1
    pattern = re.compile(r"^\s*#?\s*%s\b" % re.escape(key))
    out, replaced = [], False
    for line in lines:
        if not replaced and pattern.match(line):
            out.append("%s %s\n" % (key, value))
            replaced = True
        else:
            out.append(line)
    if not replaced:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out.append("%s %s\n" % (key, value))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(SSHD_CONFIG), prefix=".panel-", suffix=".tmp")
    with os.fdopen(fd, "w") as fh:
        fh.writelines(out)
    os.chmod(tmp, stat.S_IMODE(os.stat(SSHD_CONFIG).st_mode))   # keep sshd_config's own mode
    os.replace(tmp, SSHD_CONFIG)
    # ...and again where it will actually be obtained first, on the distros that read it.
    if _sshd_includes_dropin_dir():
        _write_sshd_hardening_dropin(key, value)
    effective = _sshd_effective_value(key)
    if effective is None:
        print("panel-helper: sshd-set-directive: wrote %s, but could not read sshd -T to "
              "confirm it took effect" % key, file=sys.stderr)
        return 5
    if effective.lower() != value.lower():
        print("panel-helper: sshd-set-directive: %s is still in effect as %r after the write — "
              "another sshd_config.d file sets it first" % (key, effective), file=sys.stderr)
        return 4
    return 0


