def do_sshd_backup(args, content):
    """Snapshot the panel's sshd drop-in, if it exists. A missing file is success, not an error —
    the restore below treats "no snapshot" as "there was no drop-in before us"."""
    if os.path.isfile(SSHD_DROPIN):
        # copy2, not copyfile: it carries the mode across, so the restore below can be an exact
        # inverse. The snapshot is no more exposed than the file it copies, by construction.
        shutil.copy2(SSHD_DROPIN, SSHD_DROPIN_BAK)
    return 0


def do_sshd_restore(args, content):
    """Put the snapshot back, or remove the drop-in if there was no snapshot.

    This is the rollback for a port change that did not work, so it has to be the exact inverse of
    do_sshd_backup: a host that had no drop-in before ends with no drop-in, not with an empty one."""
    if os.path.isfile(SSHD_DROPIN_BAK):
        # os.replace moves the inode, so the snapshot's mode comes with it. There was a chmod 0o644
        # here, which was wrong twice over: it widened the file to world-readable, and it IMPOSED a
        # mode rather than restoring the one the host had. A rollback that changes permissions is
        # not a rollback.
        os.replace(SSHD_DROPIN_BAK, SSHD_DROPIN)
    else:
        try:
            os.unlink(SSHD_DROPIN)
        except FileNotFoundError:
            # Nothing to undo. The caller reverts unconditionally on any failure, including ones
            # that happen before the drop-in is written, so this is a normal path.
            pass
    return 0


def do_sshd_discard_backup(args, content):
    """Drop the snapshot after a successful change."""
    try:
        os.unlink(SSHD_DROPIN_BAK)
    except FileNotFoundError:
        pass          # there was no drop-in to snapshot; nothing to clean up
    return 0


def do_f2b_sshd_ports(args, content):
    r"""Point fail2ban's [sshd] jail at a new port list.

    Was an in-place `sed -i '/^\[sshd\]/,/^\[/{s/^port *=.*/port = …/}'` running as root. The
    same edit in Python: walk jail.local, and inside the [sshd] section only, replace the port line.
    No jail.local, or no [sshd] section, means nothing to do — fail2ban keeps its default."""
    ports = args[0]
    path = F2B_JAIL_LOCAL
    if not os.path.isfile(path):
        return 0
    with open(path) as fh:
        lines = fh.readlines()
    out, in_sshd, changed = [], False, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            in_sshd = stripped == "[sshd]"
        elif in_sshd and re.match(r"\s*port\s*=", line):
            line = "port = %s\n" % ports
            changed = True
        out.append(line)
    if changed:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".panel-", suffix=".tmp")
        with os.fdopen(fd, "w") as fh:
            fh.writelines(out)
        # Keep jail.local's existing mode instead of imposing 0o644 — this edits a file the
        # distro (or the operator) created, and rewriting its permissions is not part of the edit.
        os.chmod(tmp, stat.S_IMODE(os.stat(path).st_mode))
        os.replace(tmp, path)
    return 0


def do_reboot_delayed(args, content):
    """Reboot a couple of seconds from now, so the command that asked for it can return first.

    Was `( sleep 2 ; reboot ) >/dev/null 2>&1 & echo scheduled` — a subshell, a background job and
    a redirect, all needing a shell. The double fork does the same thing: the grandchild is
    re-parented to init, survives this process exiting, waits, and execs reboot. No shell, and the
    only thing it can exec is the reboot binary this table resolves."""
    pid = os.fork()
    if pid == 0:                       # child
        os.setsid()                    # detach from the session, so our exit cannot kill it
        if os.fork() == 0:             # grandchild — re-parented to init
            # finally, not except: os.execv does not return on success, so this only runs when the
            # exec failed. It guarantees the grandchild can never fall back into the caller's code
            # — for any exception, without catching BaseException to do it.
            try:
                devnull = os.open(os.devnull, os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(devnull, fd)
                if devnull > 2:
                    os.close(devnull)        # dup2 kept the copies; this one would leak
                time.sleep(REBOOT_DELAY_SECONDS)
                os.execv(resolve("reboot"), ["reboot"])
            finally:
                os._exit(1)
        os._exit(0)
    os.waitpid(pid, 0)                 # reap the middle process immediately
    return 0


REBOOT_DELAY_SECONDS = 2


def do_write_file(args, content):
    """Write `content` to a named root-owned destination.

    Done here in Python rather than by shelling out to tee or `base64 -d > path`, which is what the
    panel used to do: the content was base64'd onto a ROOT COMMAND LINE, and the redirect needed a
    shell. Here the content arrives on this process's stdin and never becomes an argument at all.

    Written to a temporary file in the same directory and renamed, so a reader never sees a
    half-written config — fail2ban and sshd both read these while the panel is editing them."""
    path, mode = WRITE_TARGETS[args[0]]
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".panel-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)          # atomic within the same filesystem
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            # The temp file may already be gone (a partial os.replace, or the directory removed
            # under us). Either way the original error below is the one worth reporting, so a
            # failure to clean up must not replace it.
            pass
        raise
    return 0


# Verbs implemented by a function here instead of by running a tool. Each takes the validated
# arguments and the content read from this process's stdin.
ACTIONS = {
    "write-file": do_write_file,
    "sshd-backup-dropin": do_sshd_backup,
    "sshd-restore-dropin": do_sshd_restore,
    "sshd-discard-backup": do_sshd_discard_backup,
    "f2b-set-sshd-ports": do_f2b_sshd_ports,
    "reboot-delayed": do_reboot_delayed,
}


def validate(verb, args):
    """The checked arguments for `verb`, or ValueError. Shared by main() and by the panel's unit
    test, which compares this table's argv against privileged.py's for every verb — the two copies
    exist so that root never imports panel code, and only a test keeps them honest."""
    validators = VERBS[verb][0]
    args = list(args)
    rest = validators[-1] if validators and isinstance(validators[-1], Rest) else None
    fixed = validators[:-1] if rest else validators
    if rest is None:
        if len(args) != len(fixed):
            raise ValueError("%s takes %d argument(s), got %d" % (verb, len(fixed), len(args)))
        checks = list(fixed)
    else:
        low, high = len(fixed) + rest.minimum, len(fixed) + rest.maximum
        if not low <= len(args) <= high:
            raise ValueError("%s takes %d..%d argument(s), got %d" % (verb, low, high, len(args)))
        checks = list(fixed) + [rest.check] * (len(args) - len(fixed))
    out = []
    for i, (value, check) in enumerate(zip(args, checks)):
        try:
            out.append(check(value))
        except ValueError as e:
            raise ValueError("%s argument %d rejected (%s)" % (verb, i + 1, e))
    return out


def main(argv):
    if len(argv) >= 2 and argv[1] == "--list-verbs":
        for verb in sorted(VERBS):
            print("%s\t%d" % (verb, len(VERBS[verb][0])))
        return 0
    if len(argv) < 2:
        print("panel-helper: a verb is required", file=sys.stderr)
        return 2
    verb, args = argv[1], argv[2:]
    spec = VERBS.get(verb)
    if spec is None:
        print("panel-helper: unknown verb %r" % verb, file=sys.stderr)
        return 2
    _, build, stdin_text = spec
    try:
        checked = validate(verb, args)
    except ValueError as e:
        # The rejected value is NOT echoed back: this runs as root and its stderr is surfaced in
        # the panel UI, so repeating attacker-controlled text here would be a reflection.
        print("panel-helper: %s" % e, file=sys.stderr)
        return 2
    action = ACTIONS.get(verb)
    if action is not None:
        # The payload is this process's stdin. It is never an argument, so no amount of it can
        # change what runs.
        try:
            return action(checked, sys.stdin.read())
        except OSError as e:
            print("panel-helper: %s failed (%s)" % (verb, e.__class__.__name__), file=sys.stderr)
            return 1

    argv = build(checked)
    env = dict(os.environ)
    if verb in NONINTERACTIVE:
        env["DEBIAN_FRONTEND"] = "noninteractive"
    try:
        argv[0] = resolve(argv[0])
        p = subprocess.run(argv, shell=False,  # nosec B603 - argv is built from literals
                           input=stdin_text, env=env, capture_output=True, text=True,
                           timeout=1800)
    except FileNotFoundError:
        print("panel-helper: the tool for %s is not installed" % verb, file=sys.stderr)
        return 127
    except subprocess.TimeoutExpired:
        print("panel-helper: %s timed out" % verb, file=sys.stderr)
        return 124
    sys.stdout.write(p.stdout or "")
    sys.stderr.write(p.stderr or "")
    return p.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv))
