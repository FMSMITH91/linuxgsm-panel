# B3 (Big Brother Bot) for linuxgsm-panel's Add-ons tab, built on the game's host, as the game
# server's account, by rootless Podman (panel/services/addons.py writes this folder and runs
# `podman build` with the two build arguments below).
#
# What the build trusts, and how each piece is checked:
#   - the base image, by its digest (python:3.15-slim, Debian 13), then Debian's security updates,
#     each checked by apt against Debian's signing keys;
#   - B3's source, fetched from GitHub at ONE commit: the build fails unless the checkout's commit
#     id is exactly B3_COMMIT (git checks every object against its id as it fetches);
#   - B3's Python dependencies, each pinned with its hash (requirements.txt, pip --require-hashes),
#     from wheels only.
# git and the fetched history stay in the first stage; the image keeps B3's code and its packages,
# and not the pip that installed them.
# The values have no default here: they come from the signed add-on catalog (its source is
# panel/addon_images/catalog.json, where Renovate keeps them current), passed as --build-arg by the panel
# and by CI's image scan. So a new base or B3 release changes no file a panel runs, and needs no panel
# update. A build missing one stops at once: FROM has no image without BASE_IMAGE, and the first RUN
# refuses an empty B3_COMMIT.
#   BASE_IMAGE  the catalog's b3 `base`: python:3.15-slim by digest
#   B3_COMMIT   the catalog's b3 `commit`: the commit of its `tag`
ARG BASE_IMAGE
ARG B3_COMMIT

FROM ${BASE_IMAGE} AS source
ARG B3_COMMIT
RUN test -n "${B3_COMMIT}" || { echo "B3_COMMIT build argument missing (the add-on catalog's b3 commit)" >&2; exit 1; }
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/FMSMITH91/big-brother-bot.git "${B3_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${B3_COMMIT}" \
    && rm -rf .git

FROM ${BASE_IMAGE}
ARG B3_COMMIT
LABEL org.opencontainers.image.title="B3 (Big Brother Bot) for linuxgsm-panel" \
      org.opencontainers.image.source="https://github.com/FMSMITH91/big-brother-bot" \
      org.opencontainers.image.revision="${B3_COMMIT}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/data
# `b3_run.py --version` and B3's health.json name the commit they run from this (the source has no .git).
ENV B3_COMMIT=${B3_COMMIT}
# Debian's security fixes, installed when the image is built. The base is pinned by digest and Docker
# rebuilds python:3.15-slim on its own schedule, so a fix Debian has already shipped can be missing from
# it (libzstd1, CVE-2026-124851: fixed in 1.5.7+dfsg-1+deb13u1, still 1.5.7+dfsg-1 in the newest image
# on 2026-11-25). apt checks every package against Debian's signing keys; the lists go in the same layer.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/b3-requirements.txt
# The installer leaves with the install, in the same layer: B3 never runs pip, setuptools or wheel
# (its pkg_handler takes pkg_resources only when present, and the slim base has none), and pip
# carries its own older copies of urllib3, msgpack and setuptools. ensurepip's bundled pip wheel
# goes too, so `python -m ensurepip` cannot put them back.
RUN python -m pip install --no-cache-dir --root-user-action=ignore --disable-pip-version-check \
        --require-hashes --only-binary :all: --no-deps -r /opt/b3-requirements.txt \
    && python -m pip uninstall --yes --root-user-action=ignore --disable-pip-version-check pip setuptools wheel \
    && python -c "import ensurepip, glob, os; [os.remove(w) for w in glob.glob(os.path.join(os.path.dirname(ensurepip.__file__), '_bundled', '*.whl'))]" \
    && ! python -c "import pip" 2>/dev/null
COPY --from=source /src/b3 /opt/b3/b3
COPY --from=source /src/b3_run.py /opt/b3/b3_run.py
COPY entrypoint.sh /opt/b3/entrypoint.sh
# The panel writes this folder 0600 and COPY keeps a file's mode: the start script must be readable
# by the account the add-on runs as.
RUN chmod 0755 /opt/b3/entrypoint.sh && chmod 0644 /opt/b3-requirements.txt
WORKDIR /opt/b3
# Not root inside: the panel runs it with UserNS=keep-id and User=/Group= set to the game
# account's ids; this is the fallback for any other runtime.
USER 65534:65534
ENTRYPOINT ["/bin/sh", "/opt/b3/entrypoint.sh"]
