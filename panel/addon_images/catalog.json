        "sha256": "2cd724ca1e93acf05993398533ecd274f0b6b167824638874f3dc1c12732c773",
        "steps": [
          {
            "type": "create-database"
          },
          {
            "strip": "drupal-11.4.14",
            "type": "download-verify-unpack"
          },
          {
            "argv": [
              "php",
              "-r",
              "$l = require 'autoload.php'; require_once 'core/includes/install.core.inc'; $d = 'Drupal\\\\mysql\\\\Driver\\\\Database\\\\mysql'; $e = function ($n) { return file_get_contents('/run/panel-values/' . $n); }; install_drupal($l, ['interactive' => FALSE, 'parameters' => ['profile' => 'standard', 'langcode' => 'en'], 'forms' => ['install_settings_form' => ['driver' => $d, $d => ['database' => $e('DB_NAME'), 'username' => $e('DB_USER'), 'password' => $e('DB_PASSWORD'), 'host' => $e('DB_HOST_NAME'), 'port' => $e('DB_PORT'), 'prefix' => '']], 'install_configure_form' => ['site_name' => $e('SITE_NAME'), 'site_mail' => $e('ADMIN_EMAIL'), 'account' => ['name' => $e('ADMIN_USER'), 'mail' => $e('ADMIN_EMAIL'), 'pass' => ['pass1' => $e('ADMIN_PASSWORD'), 'pass2' => $e('ADMIN_PASSWORD')]], 'enable_update_status_module' => FALSE, 'enable_update_status_emails' => FALSE]]]);"
            ],
            "image": "site",
            "type": "run-in-container",
            "values": {
              "ADMIN_EMAIL": "admin_email",
              "ADMIN_PASSWORD": "admin_password",
              "ADMIN_USER": "admin_user",
              "DB_HOST_NAME": "db_host_name",
              "DB_NAME": "db_name",
              "DB_PASSWORD": "db_password",
              "DB_PORT": "db_port",
              "DB_USER": "db_user",
              "SITE_NAME": "site_name"
            }
          },
          {
            "append": true,
            "dest": "sites/default/settings.php",
            "escape": "php",
            "template": "\n$settings['trusted_host_patterns'] = [{trusted_hosts}];\n",
            "type": "render-config"
          },
          {
            "readonly": [
              "sites/default/settings.php",
              "sites/default"
            ],
            "type": "set-permissions"
          }
        ],
        "url": "https://ftp.drupal.org/files/projects/drupal-11.4.14.tar.gz",
        "version": "11.4.14"
      },
